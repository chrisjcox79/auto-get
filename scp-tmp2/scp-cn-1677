/* open-menu */
@media (max-width: 767px) {
    .open-menu a.menu-trigger,
    .open-menu a.menu-trigger span {
        display: inline-block;
        transition: var(--link-transition);
        box-sizing: border-box;
    }
    .open-menu .menu-trigger {
        background-color: transparent!important;
        top: unset;
        bottom: unset;
        top: var(--menu-y);
        left: var(--menu-x);
        margin: 0 auto;
        width: calc(var(--menu-height) * 1.2);
        height: var(--menu-height);
        position: fixed;
        z-index: 999;
    }
    .open-menu .menu-trigger span {
        opacity: 1;
        position: absolute;
        left: 0;
        width: 100%;
        height: var(--menu-span-height);
        background-color: rgba(255,255,255,.7);
        box-shadow: 0 0 5px #888;
    }
    .open-menu a.menu-trigger span:nth-of-type(1) {
        top: 0;
    }
    .open-menu a.menu-trigger span:nth-of-type(2) {
        top: 0;
        bottom: 0;
        margin: auto;
    }
    .open-menu a.menu-trigger span:nth-of-type(3) {
        bottom: 0;
    }
    #side-bar:target ~ * .menu-trigger span {
        opacity: 0;
    }
    #side-bar:target ~ * .menu-trigger span:nth-of-type(1) {
        transform: translateY(var(--menu-trans)) rotate(-45deg);
    }
    #side-bar:target ~ * .menu-trigger span:nth-of-type(2) {
        left: 60%;
        opacity: 0;
        animation: active-menu-bar02 .8s forwards;
    }
    @keyframes active-menu-bar02 {
        100% {
            height: 0;
        }
    }
    #side-bar:target ~ * .menu-trigger span:nth-of-type(3) {
        transform: translateY(calc(var(--menu-trans) * (-1))) rotate(45deg);
    }
    #side-bar:target ~ * .menu-trigger {
        pointer-events: none;
    }
    #side-bar:target .close-menu {
        background: none;
    }
}


