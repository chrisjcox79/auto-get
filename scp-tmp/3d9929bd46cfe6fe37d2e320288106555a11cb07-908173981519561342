<script type="text/javascript">
var sentenceList = new Array();
var sentenceViewerDiv;
var Ready = false;
document.addEventListener("DOMContentLoaded",function(){
sentenceViewerDiv = document.getElementById("sentenceViewer");
var divList = document.getElementsByTagName("div");
for(var i = 0;i < divList.length;i++){
if(divList[i].getAttribute("class") == "randomSentence"){
sentenceList.push(divList[i]);
}
}
Ready = true;
showRandomSentence();
});

function showRandomSentence(){
if(!Ready)return;
var selectNumber = Math.floor(Math.random() * sentenceList.length);
sentenceViewerDiv.innerHTML = sentenceList[selectNumber].innerHTML;

}
</script>
<div style="text-align: center;">
<button onclick="showRandomSentence()">请求发送图像</button>

