&lt;p&gt;&lt;strong&gt;标题：&lt;/strong&gt;SCP-696-JP - 沉睡的公主与未醒的梦&lt;br /&gt;
&lt;strong&gt;作者：&lt;/strong&gt;©︎&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/amamiel&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2125181&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608471516&quot; alt=&quot;amamiel&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2125181)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/amamiel&quot;  &gt;amamiel&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;
&lt;strong&gt;译者：&lt;/strong&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/backlight-sh&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5374263&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608471516&quot; alt=&quot;Backlight SH&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5374263)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/backlight-sh&quot;  &gt;Backlight SH&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;
&lt;strong&gt;校对：&lt;/strong&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mint-chocolate&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4106733&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608471516&quot; alt=&quot;Mint chocolate&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4106733)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mint-chocolate&quot;  &gt;Mint chocolate&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;
