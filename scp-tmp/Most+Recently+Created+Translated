&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/jeffreycc&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5913267&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606483039&quot; alt=&quot;JeffreyCC&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5913267)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/jeffreycc&quot;  &gt;JeffreyCC&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
