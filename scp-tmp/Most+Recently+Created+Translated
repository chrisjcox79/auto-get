&lt;p&gt;&amp;#171; &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-5088&quot;&gt;SCP-5088&lt;/a&gt; | SCP-5089 | &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-5090&quot;&gt;SCP-5090&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/konjacq&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7040048&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608343370&quot; alt=&quot;konjacq&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7040048)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/konjacq&quot;  &gt;konjacq&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
