&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/backlight-sh&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5374263&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608471516&quot; alt=&quot;Backlight SH&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5374263)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/backlight-sh&quot;  &gt;Backlight SH&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
