&lt;td style=&quot;border-bottom: 1px solid #AAA; border-right: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:90%;&quot;&gt;&lt;strong&gt;站点主管&lt;/strong&gt;&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;border-bottom: 1px solid #AAA; border-right: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:90%;&quot;&gt;&lt;strong&gt;研究领导人&lt;/strong&gt;&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;border-bottom: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:90%;&quot;&gt;&lt;strong&gt;指派MTF&lt;/strong&gt;&lt;/span&gt;&lt;/td&gt;
