&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/timeelapsed&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3662783&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609314932&quot; alt=&quot;TimeElapsed&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3662783)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/timeelapsed&quot;  &gt;TimeElapsed&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
