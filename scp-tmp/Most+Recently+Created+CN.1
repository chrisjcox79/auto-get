&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/flying-jellyfish&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1925789&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610007883&quot; alt=&quot;Flying Jellyfish&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1925789)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/flying-jellyfish&quot;  &gt;Flying Jellyfish&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
