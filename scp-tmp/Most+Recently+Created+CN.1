					<item>
				<guid>http://scp-wiki-cn.wikidot.com/goldenrod</guid>
				<title>秋麒麟草</title>
				<link>http://scp-wiki-cn.wikidot.com/goldenrod</link>
				<description>

&lt;div style=&quot;text-align: right;&quot;&gt;&lt;/div&gt;
&lt;table style=&quot;margin:0; padding:0&quot;&gt;
&lt;tr&gt;
&lt;td style=&quot;margin:0; padding:0&quot;&gt;
&lt;div id=&quot;toc&quot;&gt;
&lt;div id=&quot;toc-action-bar&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;折叠&lt;/a&gt;&lt;a style=&quot;display: none&quot; href=&quot;javascript:;&quot;  &gt;展开&lt;/a&gt;&lt;/div&gt;
&lt;div class=&quot;title&quot;&gt;目录&lt;/div&gt;
&lt;div id=&quot;toc-list&quot;&gt;
&lt;div style=&quot;margin-left: 1em;&quot;&gt;&lt;a href=&quot;#toc0&quot;&gt;1&lt;/a&gt;&lt;/div&gt;
&lt;div style=&quot;margin-left: 1em;&quot;&gt;&lt;a href=&quot;#toc1&quot;&gt;2&lt;/a&gt;&lt;/div&gt;
&lt;div style=&quot;margin-left: 1em;&quot;&gt;&lt;a href=&quot;#toc2&quot;&gt;3&lt;/a&gt;&lt;/div&gt;
&lt;div style=&quot;margin-left: 1em;&quot;&gt;&lt;a href=&quot;#toc3&quot;&gt;4&lt;/a&gt;&lt;/div&gt;
&lt;div style=&quot;margin-left: 1em;&quot;&gt;&lt;a href=&quot;#toc4&quot;&gt;5&lt;/a&gt;&lt;/div&gt;
&lt;div style=&quot;margin-left: 1em;&quot;&gt;&lt;a href=&quot;#toc5&quot;&gt;6&lt;/a&gt;&lt;/div&gt;
&lt;/div&gt;
