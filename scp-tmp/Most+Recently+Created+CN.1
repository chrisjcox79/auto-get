&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/furry-lover&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5714158&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607395548&quot; alt=&quot;furry lover&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5714158)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/furry-lover&quot;  &gt;furry lover&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
