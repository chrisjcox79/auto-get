<div class="collapsible-block-content"></div>
</div>
</div>
<div style="text-align: right;">
<p><span id="u-credit-00069" class="option-button fa fa-info-circle">信息</span><a class="option-button fa fa-edit" href="/short-stories:00069" target="_blank">编辑 &amp; 评论</a></p>
</div>
