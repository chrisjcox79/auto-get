<style type="text/css">
@import url(http://scp-jp.wdfiles.com/local--files/japanese-syntax/scp-WikidotCss.css);

*{
font-size: 11.5px;
}

.blackout{
animation: daychange 5s linear both;
}

@keyframes daychange{
0%{opacity: 1;}
40%{opacity: 0;}
60%{opacity: 0;}
100%{opacity: 1;}
}

:root{
--mecolor: #6DF560;
--youcolor: #ffffff;
}

#all .me{
position: relative;
float: right;
width: 75%;
max-width: 450px;
margin-bottom: 8px;
padding-right: 12px;
text-align: right;
white-space: nowrap;
}

#all .you{
display: inline-block;
position: relative;
width: 75%;
max-width: 450px;
margin-bottom: 8px;
padding-left: 12px;
text-align: left;
white-space: nowrap;
vertical-align: top;
}

#all .talk,
#change .talk{
display: inline-block;
max-width: 75%;
white-space: normal;
color: #000000; 
border-radius: 16px; 
text-align: left;
font-size: 120%;
padding: 6px 11px;
vertical-align: bottom;
}

.talk p{
margin: 0;
}

.info{
text-align: center;
padding: 0px 15px;
margin-bottom: 8px;
vertical-align: bottom;
}

#all .metalk{
background-color: var(--mecolor);
}

#all .youtalk{
background-color: var(--youcolor);
}

#all .infotalk{
color: white;
background-color: #777777;
font-size: 85%;
opacity: 0.7;
}

.me::before{
display: inline-block;
content: attr(data-kidoku)"\A" attr(data-time);
white-space: pre;
text-align: right; 
font-size: 70%;
color: #ffffff; 
}

.me::after{
content: "";
right: -18px;
position: absolute;
transform: rotate(-30deg);
height: 0;
width: 0;
border-top: 5px solid transparent;
border-bottom: 5px solid transparent;
border-right: 20px solid transparent;
border-left: 20px solid var(--mecolor);
}

.you::before{
content: "";
left: -18px;
position: absolute;
transform: rotate(30deg);
height: 0;
width: 0;
border-top: 5px solid transparent;
border-bottom: 5px solid transparent;
border-right: 20px solid var(--youcolor);
border-left: 20px solid transparent;
}

.you::after{
display: inline-block;
content: attr(data-kidoku)"\A" attr(data-time);
white-space: pre;
text-align: right; 
font-size: 70%;
color: #ffffff; 
}

.pict .me::after,
.stamp .me::after{
display: none;
}

.pict .you::before,
.stamp .you::before{
display: none;
}

#all .pict .pictin{
display: inline-block;
width: 85%;
max-width: 250px;
max-height: 250px;
}

.pict .pictin img{
border-radius: 7px; 
width: 100%;
height: 100%;
}

.stamp .stampin{
display:inline-block;
width: 150px;
height: 150px; 
}

.stamp .stampin img{
width: 100%;
height: 100%;
object-fit: cover; 
}

.icon{
display: inline-block; 
float: left; 
margin-left: 5px;
}

.icon img{
all: initial;
border-radius: 50%;
width: 32px;
height: 32px;
object-fit: cover;
}

.hide{
display: none;
}

#banner p{
line-height: 3em;
margin: auto;
padding: 0 10px;
}
</style>
