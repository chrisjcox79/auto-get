<script type="text/javascript">
let ary = document.getElementsByClassName("flow");
let banner = document.getElementById("banner");
let obj = document.getElementById("all");
setTimeout(function(){show(ary, 0);}, ary[0].dataset.delay);

obj.onscroll = function(){
  if(obj.scrollTop + obj.offsetHeight >= obj.scrollHeight){
    banner.classList.add("hide");
  }
}

function scroll(){
  obj.scrollTop = obj.scrollHeight;
}

function show(ary, i){
  if(obj.scrollTop + obj.offsetHeight >= obj.scrollHeight){
    setTimeout(function(){obj.scrollTop = obj.scrollHeight;}, 1);
  }
 else{
    setTimeout(function(){banner.classList.remove("hide");}, 1);
  }
  ary[i].classList.remove("hide");
  if(ary[i].querySelector(".me") != null){
    if(ary[i].querySelector(".stamp") != null){
      banner.innerHTML = "<p>你：表情</p>";
    }
    else if(ary[i].querySelector(".pict") != null){
      banner.innerHTML = "<p>你：图片</p>";
    }
    else{
      banner.innerHTML = "<p>你：" + ary[i].querySelector(".me").textContent + "</p>";
    }
    if(!(ary[i].classList.contains("nokidoku") || ary[i].classList.contains("nokidoku2"))){
      setTimeout(function(){ary[i].querySelector(".me").dataset.kidoku = "已读";}, ary[i].querySelector(".me").dataset.kidokudelay);
    }
  }
  else{
    banner.innerHTML = "<p>穂村：" + ary[i].querySelector(".you").textContent + "</p>";
  }
  if(ary[i].classList.contains("dayend")){
    setTimeout(function(){
      let change = document.getElementById("change");
      change.classList.remove("blackout");
      change.offsetWidth = change.offsetWidth;
      change.classList.add("blackout");
    }, 2500);
  }
  if(i+1 != ary.length){
    if(ary[i+1].classList.contains("dokidoku")){
      setTimeout(function(){
        let j;
        let nokidokuary = document.getElementsByClassName("nokidoku");
        for(j = 0; j < nokidokuary.length; j++){
          nokidokuary[j].querySelector(".me").dataset.kidoku = "已读";
        }
      }, ary[i+1].dataset.delay - 2000);
    }
    setTimeout(function(){show(ary, i+1);}, ary[i+1].dataset.delay);
  }
}
</script>
