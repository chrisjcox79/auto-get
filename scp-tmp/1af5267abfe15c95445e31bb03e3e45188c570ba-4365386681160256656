<script>
var content=new Array("欢迎致电Tale·Fairy的客服热线！请问有什么需要帮助的？","你好，我想咨询一下贵公司的水彩笔，嗯……24色那种。","哦，先生，请问我们的水彩笔有什么问题吗？","没有，它们真的很酷。你们还有这种水彩笔吗？","这种水彩笔早就停产了先生，当然，我们依旧提供完美的售后服务！","真是可惜，我丢了很多水彩笔，本来想再买上一盒的。","我们只生产一盒24色产品，这个世界只能有一盒，它是独一无二的，哦，它那么美……","喂？喂先生？我有点好奇，可以参观一下工厂吗？虽然这种要求有点无理。","抱歉先生，工厂不对外开放。感谢你使用本公司产品，请为本次服务评分。","啊…该死，我头好痛，我不想画画，不！")
var speakers=new Array("客服：","Yichen_Song研究员：","客服：","Yichen_Song研究员：","客服：","Yichen_Song研究员：","客服：","Yichen_Song研究员：","客服：","Yichen_Song研究员：","","")
var content1=new Array("我要画一幅画","画上一整个世界","用红色画一个太阳","用黄色画成海洋","黑色汇成人流","大家吃着绿色的汉堡，洋溢着橙色的微笑","再用蓝色的火焰点燃白色的画布","看紫色的无知者在祈祷","哦，一个世界的最后的美好。","是灰烬在风中舞蹈")

var n=0

var ltime=0

var ch="<p>"

var time=0

var displayer=0

var completed=0

function closec(){
document.getElementById("listening").innerHTML="[认知危害已屏蔽]"
}

function closed(){
document.getElementById("listening").innerHTML="　"
displayer=0
completed=1
}

function cleaning(){
document.getElementById("showbox1").innerHTML="　"
document.getElementById("showbox2").innerHTML="　"
document.getElementById("showbox3").innerHTML="　"
}
function listening(){
if(n<content.length){
var listcon=content[n].substring(0,ltime)
if(ltime>content[n].length){
document.getElementById("listening").innerHTML=" "
document.getElementById("showbox1").innerHTML="<b>"+speakers[n]+"</b>"+content1[n]
if(n>=1){document.getElementById("showbox2").innerHTML="<b>"+speakers[n-1]+"</b>"+content1[n-1]}
if(n>=2){document.getElementById("showbox3").innerHTML="<b>"+speakers[n-2]+"</b>"+content1[n-2]}
ltime=0
n=n+1
}
ltime=ltime+1
document.getElementById("listening").innerHTML=listcon
document.getElementById("speaker").innerHTML="<b>"+speakers[n]+"</b>"
if(displayer == 1){
setTimeout("listening()",80)
}
}
if(n == content.length){
document.getElementById("listening").innerHTML="[检测到认知危害]</b>"

setTimeout("cleaning()",3000)
setTimeout("closec()",5000)
setTimeout("closed()",7000)

}
}

function pause0(){if(displayer==1){
displayer=0
}
}

function display0(){if(displayer==0){
displayer=1
if(completed==1){
completed=0
document.getElementById("showbox1").innerHTML="　"
document.getElementById("showbox2").innerHTML="　"
document.getElementById("showbox3").innerHTML="　"
n=0
ltime=0
}
listening()

}
}

</script>
