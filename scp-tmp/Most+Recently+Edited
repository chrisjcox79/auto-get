&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki-cn.wikidot.com/credit:backmodule/code/4&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;&quot; width=&quot;&quot; class=&quot;close-credits&quot; style=&quot;height:2em;margin: 0;padding: 0;border: 0;background: transparent;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:x-large;&quot;&gt;&lt;tt&gt;囚室#261&lt;/tt&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:large;&quot;&gt;&lt;tt&gt;无声记忆&lt;/tt&gt;&lt;/span&gt;&lt;/p&gt;
&lt;hr /&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;blockquote&gt;
&lt;p&gt;&lt;strong&gt;作者：&lt;/strong&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-fishbone&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6127045&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608038149&quot; alt=&quot;Dr Fishbone&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6127045)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-fishbone&quot;  &gt;Dr Fishbone&lt;/a&gt;&lt;/span&gt; | &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/fishbonefishbone&quot; target=&quot;_blank&quot;&gt;作者页在此&lt;/a&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;/div&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;本篇板式修改自&lt;tt&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/theme:black-rain&quot; target=&quot;_blank&quot;&gt;黑色之雨-主题板式&lt;/a&gt;&lt;/tt&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;以后这个系列的故事将会沿用&lt;a href=&quot;http://scp-sandbox-3.wikidot.com/261qiushi&quot; target=&quot;_blank&quot;&gt;当前板式&lt;/a&gt;以及排版形式&lt;/p&gt;
