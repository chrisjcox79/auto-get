&lt;/div&gt;
&lt;div class=&quot;wiki-note&quot;&gt;&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-cubear&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3198768&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608556248&quot; alt=&quot;Dr cubear&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3198768)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-cubear&quot;  &gt;Dr cubear&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
