				<guid>http://scp-wiki-cn.wikidot.com/death-of-candy</guid>
				<title>糖纸在Site-CN-90内飘落</title>
				<link>http://scp-wiki-cn.wikidot.com/death-of-candy</link>
				<description>


&lt;div style=&quot;text-align: right;&quot;&gt;
&lt;table class=&quot;rate_t2 bhl-{$bhl}&quot;&gt;
&lt;tr&gt;
