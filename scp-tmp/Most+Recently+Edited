&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-naxurt&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4423816&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607109060&quot; alt=&quot;Dr_Naxurt&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4423816)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-naxurt&quot;  &gt;Dr_Naxurt&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
