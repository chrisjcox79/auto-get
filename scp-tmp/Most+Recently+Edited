&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;
&lt;div class=&quot;footer-wikiwalk-nav&quot;&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&amp;#171; &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-cn-1192&quot;&gt;SCP-CN-1192&lt;/a&gt; | SCP-CN-1193 | &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-cn-1194&quot;&gt;SCP-CN-1194&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/xanarchy-militia&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6910500&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608949182&quot; alt=&quot;XANARCHY MILITIA&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6910500)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/xanarchy-militia&quot;  &gt;XANARCHY MILITIA&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
