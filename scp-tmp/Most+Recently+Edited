&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mentalimagerymirage&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6527580&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606830174&quot; alt=&quot;MentalImageryMirage&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6527580)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mentalimagerymirage&quot;  &gt;MentalImageryMirage&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
