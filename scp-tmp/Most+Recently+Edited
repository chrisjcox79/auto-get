&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/diorite&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4107059&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609529935&quot; alt=&quot;Diorite&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4107059)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/diorite&quot;  &gt;Diorite&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
