&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/peiweiartz&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4474355&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605942934&quot; alt=&quot;PeiWeiArtz&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4474355)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/peiweiartz&quot;  &gt;PeiWeiArtz&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
