&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lpcaco3&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5166393&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607412799&quot; alt=&quot;LPCaCO3&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5166393)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lpcaco3&quot;  &gt;LPCaCO3&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
