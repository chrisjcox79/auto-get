&lt;div class=&quot;image-container aligncenter&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/goc-hub-page/GOC-Logo-v4.png&quot; alt=&quot;GOC-Logo-v4.png&quot; class=&quot;image&quot; /&gt;&lt;/div&gt;
