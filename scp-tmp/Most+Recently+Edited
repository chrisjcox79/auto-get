&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/agent-phage&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2950095&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609529933&quot; alt=&quot;Agent Phage&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2950095)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/agent-phage&quot;  &gt;Agent Phage&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
