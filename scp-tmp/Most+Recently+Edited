&lt;h4&gt;&lt;span&gt;最热主题&lt;/span&gt;&lt;/h4&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;right_float&quot;&gt;
&lt;div style=&quot;padding:2px;&quot;&gt;
&lt;h4&gt;&lt;span&gt;最新主题&lt;/span&gt;&lt;/h4&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;div style=&quot;clear:both; height: 0px; font-size: 1px&quot;&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;collapsible-block&quot;&gt;
&lt;div class=&quot;collapsible-block-folded&quot;&gt;&lt;a class=&quot;collapsible-block-link&quot; href=&quot;javascript:;&quot;&gt;--&amp;gt;当月计分板&lt;/a&gt;&lt;/div&gt;
&lt;div class=&quot;collapsible-block-unfolded&quot; style=&quot;display:none&quot;&gt;
&lt;div class=&quot;collapsible-block-unfolded-link&quot;&gt;&lt;a class=&quot;collapsible-block-link&quot; href=&quot;javascript:;&quot;&gt;&amp;lt;--收起&lt;/a&gt;&lt;/div&gt;
&lt;div class=&quot;collapsible-block-content&quot;&gt;
&lt;div class=&quot;left_float&quot;&gt;
&lt;div style=&quot;background-color:#f0f0f0;padding:4%;margin: 5%;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:微软细黑&quot;&gt;本月最高评分SCP&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div style=&quot;background-color:#f0f0f0;padding:4%;margin: 5%;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:微软细黑&quot;&gt;原创GoI格式或其他页面&lt;/span&gt;&lt;/p&gt;
