&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:300px;&quot;&gt;&lt;img src=&quot;http://scp-wiki-cn.wikidot.com/local--files/scotoma/%E5%88%AB%E7%9C%8B%E5%A4%B4&quot; style=&quot;width:300px;&quot; alt=&quot;%E5%88%AB%E7%9C%8B%E5%A4%B4&quot; class=&quot;image&quot; /&gt;
