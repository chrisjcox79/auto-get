&lt;td style=&quot;text-align: right;&quot;&gt;&lt;span style=&quot;font-size:125%;&quot;&gt;&lt;strong&gt;项目等级：&lt;/strong&gt;等待分级&lt;/span&gt;&lt;/td&gt;
