f-994033-12" href="javascript:;" class="footnoteref" >12</a></sup></div> <div class="icon_link"><a href="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/ROLL.svg">链接</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/Yesod.svg" alt="Yesod.svg" class="image" /></div> <div class="icon_name">Yesod（基础）<sup class="footnoteref"><a id="footnoteref-994033-13" href="javascript:;" class="footnoteref" >13</a></sup></div> <div class="icon_link"><a href="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/Yesod.svg">链接</a></div> </div> </div> <hr /> <h1><span>ACS基础图标</span></h1> <div class="icons"> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/apollyon-icon.svg" alt="apollyon-icon.svg" class="image" /></div> <div class="icon_name">apollyon（亚坡伦）<sup class="footnoteref"><a id="footnoteref-994033-14" href="javascript:;" class="footnoteref" >14</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/apollyon-icon.svg">链接</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/archon-icon.svg" alt="archon-icon.svg" class="image" /></div> <div class="icon_name">archon（执政官）<sup class="footnoteref"><a id="footnoteref-994033-15" href="javascript:;" class="footnoteref" >15</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/archon-icon.svg">链接</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/cernunnos-icon.svg" alt="cernunnos-icon.svg" class="image" /></div> <div class="icon_name">cernunnos（塞努诺斯）<sup class="footnoteref"><a id="footnoteref-994033-16" href="javascript:;" class="footnoteref" >16</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/cernunnos-icon.svg">链接</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/hiemal-icon.svg" alt="hiemal-icon.svg" class="image" /></div> <div class="icon_name">hiemal（亚纳尔）<sup class="footnoteref"><a id="footnoteref-994033-17" href="javascript:;" class="footnoteref" >17</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/hiemal-icon.svg">链接</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/tiamat-icon.svg" alt="tiamat-icon.svg" class="image" /></div> <div class="icon_name">tiamat（提亚马特）<sup class="footnoteref"><a id="footnoteref-994033-18" href="javascript:;" class="footnoteref" >18</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/tiamat-icon.svg">链接</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/ticonderoga-icon.svg" alt="ticonderoga-icon.svg" class="image" /></div> <div class="icon_name">ticonderoga（提康德罗加）<sup class="footnoteref"><a id="footnoteref-994033-19" href="javascript:;" class="footnoteref" >19</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/ticonderoga-icon.svg">链接</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/thaumiel-icon.svg" alt="thaumiel-icon.svg" class="image" /></div> <div class="icon_name">thaumiel（双子神）<sup class="footnoteref"><a id="footnoteref-994033-20" href="javascript:;" class="footnoteref" >20</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/thaumiel-icon.svg">链接</a></div> </div> </div> </div> <p>by <span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/shineshadowd" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=3967806&amp;amp;size=small&amp;amp;timestamp=1605879426" alt="ShineShadowD" style="background-image:url(http://www.wikidot.com/userkarma.php?u=3967806)" /></a><a href="http://www.wikidot.com/user:info/shineshadowd" >ShineShadowD</a></span></p> <div class="footnotes-footer"> <div class="title">脚注</div> <div class="footnote-footer" id="footnote-994033-1"><a href="javascript:;" >1</a>. 此处修改自<a href="http://scp-wiki-cn.wikidot.com/component:anomaly-class-bar">ACS指南。</a></div> <div class="footnote-footer" id="footnote-994033-2"><a href="javascript:;" >2</a>. 项目于技术上可被收容，但由于所需程序的性质，基金会拒绝这么做。（重绘，<span style="text-decoration: line-through;">原因是因为在画的时候顺手画了没注意到原版就有×</span>）</div> <div class="footnote-footer" id="footnote-994033-3"><a href="javascript:;" >3</a>. 项目与常态纠缠，收容异常势必会影响到常态智能实体。</div> <div class="footnote-footer" id="footnote-994033-4"><a href="javascript:;" >4</a>. 项目已因异常的一个特殊部分的消失而被彻底影响。</div> <div class="footnote-footer" id="footnote-994033-5"><a href="javascript:;" >5</a>. 项目目前正在接受监督者议会的正式调查，以确定其真伪。</div> <div class="footnote-footer" id="footnote-994033-6"><a href="javascript:;" >6</a>. 项目被基金会用来创造异常。</div> <div class="footnote-footer" id="footnote-994033-7"><a href="javascript:;" >7</a>. 项目非异常，但与异常有关。</div> <div class="footnote-footer" id="footnote-994033-8"><a href="javascript:;" >8</a>. 项目危及基金会的内部结构，并限制了基金会履行其次级目标的能力。</div> <div class="footnote-footer" id="footnote-994033-9"><a href="javascript:;" >9</a>. 项目已向公众披露。</div> <div class="footnote-footer" id="footnote-994033-10"><a href="javascript:;" >10</a>. 项目已被分为数个不同的异常部分，且必须被分开收容。</div> <div class="footnote-footer" id="footnote-994033-11"><a href="javascript:;" >11</a>. 在一种社会史（一般是标准智人社会史）中无任何可信证据支持项目存在。但通过史观观察及规划部的观察可从其他历史进程中证实项目存在的有效性，同时发现其可能/将存在于中的一系列潜在迹象/征兆。</div> <div class="footnote-footer" id="footnote-994033-12"><a href="javascript:;" >12</a>. 项目分级由于项目异常导致乱码等错误。参考自<a href="http://scp-wiki-cn.wikidot.com/scp-5856">SCP-5856</a>。</div> <div class="footnote-footer" id="footnote-994033-13"><a href="javascript:;" >13</a>. 项目已整合于基金会的指挥机构。</div> <div class="footnote-footer" id="footnote-994033-14"><a href="javascript:;" >14</a>. 项目无法被收容，且会“积极”地去引发世界末日。</div> <div class="footnote-footer" id="footnote-994033-15"><a href="javascript:;" >15</a>. 项目可以被收容，但不应被收容。</div> <div class="footnote-footer" id="footnote-994033-16"><a href="javascript:;" >16</a>. 项目于技术上可被收容，但由于所需程序的性质，基金会拒绝这么做。</div> <div class="footnote-footer" id="footnote-994033-17"><a href="javascript:;" >17</a>. 项目是由两个或多个相关但不同的异常组成的相互控制的系统。</div> <div class="footnote-footer" id="footnote-994033-18"><a href="javascript:;" >18</a>. 项目对人类构成直接威胁，但可通过公开战争或其他面纱破碎式行动加以“收容”</div> <div class="footnote-footer" id="footnote-994033-19"><a href="javascript:;" >19</a>. 项目无法被收容，也无必要如此。</div> <div class="footnote-footer" id="footnote-994033-20"><a href="javascript:;" >20</a>. 项目可用于收容其他异常。</div> </div> 
				 	]]>
