&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/edwardc&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2017299&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607412798&quot; alt=&quot;EdwardC&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2017299)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/edwardc&quot;  &gt;EdwardC&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
