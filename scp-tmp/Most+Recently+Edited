&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/eatherac&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4008015&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607219352&quot; alt=&quot;EatherAC&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4008015)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/eatherac&quot;  &gt;EatherAC&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
