&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mint-chocolate&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4106733&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606483003&quot; alt=&quot;Mint chocolate&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4106733)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mint-chocolate&quot;  &gt;Mint chocolate&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
