&lt;div style=&quot;background-color:#f0f0f0;padding:4%;margin: 5%;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-family:微软细黑&quot;&gt;本月最高评分原创图书馆&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
