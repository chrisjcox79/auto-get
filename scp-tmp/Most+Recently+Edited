&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/the-nighter&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6276894&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606980703&quot; alt=&quot;The Nighter &quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6276894)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/the-nighter&quot;  &gt;The Nighter&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
