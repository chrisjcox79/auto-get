r-four"></div> <div class="bar-five"></div> <div class="bar-six"></div> </div> <div class="top-right-box"> <div class="level"><span class="lang-cn">等级</span><span class="lang-tr">等級</span>6</div> <div class="clearance"></div> </div> </div> <div class="bottom-box"> <div class="text-part"> <div class="main-class"> <div class="contain-class"> <div class="class-category"><span class="lang-cn">收容等级：</span><span class="lang-tr">收容等級：</span></div> <div class="class-text">机密</div> </div> <div class="second-class"> <div class="class-category"><span class="lang-cn">次要等级：</span><span class="lang-tr">次要等級：</span></div> <div class="class-text">apollyon</div> </div> </div> <div class="disrupt-class"> <div class="class-category"><span class="lang-cn">扰动等级：</span><span class="lang-tr">擾動等級：</span></div> <div class="class-text">amida</div> </div> <div class="risk-class"> <div class="class-category"><span class="lang-cn">风险等级：</span><span class="lang-tr">風險等級：</span></div> <div class="class-text">危急</div> </div> </div> <div class="diamond-part"> <div class="danger-diamond"><a href="http://scp-wiki-cn.wikidot.com/classification-committee-memo">备忘录链接</a><br /> <div class="arrows"></div> <div class="octagon"></div> <div class="quadrants"> <div class="top-quad"></div> <div class="right-quad"></div> <div class="left-quad"></div> <div class="bottom-quad"></div> </div> <div class="top-icon"></div> <div class="right-icon"></div> <div class="left-icon"></div> <div class="bottom-icon"></div> </div> </div> </div> </div> </div> <p style="text-align: center;"><span style="font-size:160%;"><strong><a href="http://scp-wiki-cn.wikidot.com/scp-4485">SCP-4485</a> - 黑光</strong></span></p> <hr /> <p>——神没有目的。</p> <p style="text-align: center;">与<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/rachud" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=4516971&amp;amp;size=small&amp;amp;timestamp=1608556259" alt="Rachud" style="background-image:url(http://www.wikidot.com/userkarma.php?u=4516971)" /></a><a href="http://www.wikidot.com/user:info/rachud" >Rachud</a></span>共同翻译</p> <p><span style="white-space: pre-wrap;">&#32;</span></p> </div> </div> </div> <div id="wiki-tab-0-2" style="display:none"> <div class="scp-image-block block-right" style="width:300px;"><img src="http://scpsandboxcn.wikidot.com/local--files/sciencekiller3/mememe.png" style="width:300px;" alt="mememe.png" class="image" /> <div class="scp-image-caption" style="width:300px;"> <p>感谢<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/yuannn" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6062512&amp;amp;size=small&amp;amp;timestamp=1608556259" alt="YUANNN" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6062512)" /></a><a href="http://www.wikidot.com/user:info/yuannn" >YUANNN</a></span>画的我！</p> </div> </div> <p>哦，你好，我想你一定撑过了前面的垃圾板式，尴尬笑话、不明展开和瞎眼代码。现在请坐下休息一会，其他自便。</p> <p>我是<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/sciencekiller" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=5480202&amp;amp;size=small&amp;amp;timestamp=1608556259" alt="sciencekiller" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5480202)" /></a><a href="http://www.wikidot.com/user:info/sciencekiller" >sciencekiller</a></span>，或者九岁<sup class="footnoteref"><a id="footnoteref-826365-3" href="javascript:;" class="footnoteref" >3</a></sup>/科杀，一名kaktus gang，ACS和黑色标记笔的大力推行者，谜团风、meta和抽象风（<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/maliceaforethought" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2902864&amp;amp;size=small&amp;amp;timestamp=1608556259" alt="MaliceAforethought" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2902864)" /></a><a href="http://www.wikidot.com/user:info/maliceaforethought" >MaliceAforethought</a></span>那样的）爱好者，比较喜欢意识流、美式硬派黑色侦探小说和拉美超现实主义小说。</p> <p>有时候会开大，但更多时候可能会像Malice那样有些意识流风和抽象的谜团系小短文（我这垃圾组词），而且估计只写SCP。我不会写奇术，要写也得靠平行宇宙。我主要是像写严肃系带点硬派幽默风格（实际上第二点我不知道怎么写）的作品。</p> <p>18年入坑，19年正式登上wiki。来基金会就是看上了那股神秘系风格和一些带点超现实主义色彩的meta文档（大概？）</p> <p>现实生活中还喜欢电音、马尔克斯、YouTuber解说<sup class="footnoteref"><a id="footnoteref-826365-4" href="javascript:;" class="footnoteref" >4</a></sup>、我的世界等等东西。</p> <p>总之，我是个按兴趣行事的人。</p> <p>要问我喜欢的主站作者？<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/rounderhouse" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=4187885&amp;amp;size=small&amp;amp;timestamp=1608556259" alt="Rounderhouse" style="background-image:url(http://www.wikidot.com/userkarma.php?u=4187885)" /></a><a href="http://www.wikidot.com/user:info/rounderhouse" >Rounderhouse</a></span>，<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/djkaktus" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1888434&amp;amp;size=small&amp;amp;timestamp=1608556259" alt="djkaktus" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1888434)" /></a><a href="http://www.wikidot.com/user:info/djkaktus" >djkaktus</a></span>，<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/maliceaforethought" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2902864&amp;amp;size=small&amp;amp;timestamp=1608556259" alt="MaliceAforethought" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2902864)" /></a><a href="http://www.wikidot.com/user:info/maliceaforethought" >MaliceAforethought</a></span>，<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/the-great-hippo" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=3938622&amp;amp;size=small&amp;amp;timestamp=1608556259" alt="The Great Hippo" style="background-image:url(http://www.wikidot.com/userkarma.php?u=3938622)" /></a><a href="http://www.wikidot.com/user:info/the-great-hippo" >The Great Hippo</a></span>，<span class="printuser avatarhover">