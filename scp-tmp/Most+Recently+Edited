&lt;p&gt;&lt;strong&gt;SCP-4786:&lt;/strong&gt;饥饿之口&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;br /&gt;
&lt;strong&gt;作者：&lt;/strong&gt; &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/malycegraves&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4916887&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607023564&quot; alt=&quot;MalyceGraves&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4916887)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/malycegraves&quot;  &gt;MalyceGraves&lt;/a&gt;&lt;/span&gt;.&lt;br /&gt;
