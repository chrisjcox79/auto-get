&lt;td&gt;Ticonderoga（提康德罗加&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-275733-20&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;20&lt;/a&gt;&lt;/sup&gt;）&lt;/td&gt;
