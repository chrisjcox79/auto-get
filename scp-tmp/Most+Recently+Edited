&lt;/div&gt;
&lt;div class=&quot;colmod-content&quot;&gt;
&lt;div class=&quot;image-container aligncenter&quot;&gt;&lt;img src=&quot;http://scpsandboxcn.wikidot.com/local--files/scotomascotoma/%E6%A8%A1%E5%9B%A0&quot; height=&quot;170px&quot; width=&quot;300px&quot; alt=&quot;%E6%A8%A1%E5%9B%A0&quot; class=&quot;image&quot; /&gt;&lt;/div&gt;
