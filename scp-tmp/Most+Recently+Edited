&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/megabytes&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6742152&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607455621&quot; alt=&quot;Megabytes&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6742152)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/megabytes&quot;  &gt;Megabytes&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
