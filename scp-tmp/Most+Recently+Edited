&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/zcar-s&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3416395&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608062479&quot; alt=&quot;zcar_s&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3416395)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/zcar-s&quot;  &gt;zcar_s&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div class=&quot;footnotes-footer&quot;&gt;
&lt;div class=&quot;title&quot;&gt;脚注&lt;/div&gt;
&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-416999-1&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;1&lt;/a&gt;. &lt;strong&gt;译注：&lt;/strong&gt;控制情绪的激素&lt;/div&gt;
&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-416999-2&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;2&lt;/a&gt;. &lt;strong&gt;译注：&lt;/strong&gt;原文为“doog”。&lt;/div&gt;
&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-416999-3&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;3&lt;/a&gt;. &lt;strong&gt;译注：&lt;/strong&gt;原文为“doge”。&lt;/div&gt;
&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-416999-4&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;4&lt;/a&gt;. &lt;strong&gt;译注：&lt;/strong&gt;美国联邦调查局(Federal Bureau of Investigation)。&lt;/div&gt;
&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-416999-5&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;5&lt;/a&gt;. &lt;strong&gt;译注：&lt;/strong&gt;美国国家安全局(National Security Agency)。&lt;/div&gt;
