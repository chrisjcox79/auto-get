				<title>初级设计师S. Yvonne的办公桌</title>
				<link>http://scp-wiki-cn.wikidot.com/desk-of-junior-designer-s-yvonne</link>
				<description>


&lt;div style=&quot;display:none&quot;&gt;&lt;iframe src=&quot;http://scp-wiki-cn.wdfiles.com/local--files/nav%3Aside/styleFrame.html?bhl&quot; name=&quot;typeFrame&quot;&gt;&lt;/iframe&gt;&lt;/div&gt;

&lt;div style=&quot;text-align: center;&quot;&gt;&lt;img src=&quot;http://scp-wiki-cn.wdfiles.com/local--files/desk-of-junior-designer-s-yvonne/Th3vdm1.png&quot; alt=&quot;Th3vdm1.png&quot; class=&quot;image&quot; /&gt;&lt;br /&gt;
&lt;span style=&quot;font-family:var(--header-font); font-size: calc(var(--base-font-size) * 3.5);&quot;&gt;设计部门&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;font-family:var(--mono-font); font-size: calc(var(--base-font-size) * 1.5);&quot;&gt;图像科&lt;/span&gt;&lt;/div&gt;
