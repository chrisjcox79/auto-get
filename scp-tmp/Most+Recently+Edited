&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-siyu&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6931840&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606807184&quot; alt=&quot;Dr Siyu&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6931840)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-siyu&quot;  &gt;Dr Siyu&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
