&lt;td&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/spikebrennan-s-proposal&quot;&gt;spikebrennan的提案&lt;/a&gt;，&lt;a class=&quot;newpage&quot; href=&quot;http://scp-wiki-cn.wikidot.com/scp-1370-jp&quot;&gt;SCP-1370-JP&lt;/a&gt;，&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-4436&quot;&gt;SCP-4436&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Zeno（芝诺&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-924933-24&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;24&lt;/a&gt;&lt;/sup&gt;）&lt;/td&gt;
