&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-412462-2&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;2&lt;/a&gt;. &lt;span style=&quot;padding: 1px 0px 2px 0px; background-color:#FF00FF&quot;&gt;&lt;tt&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;你不需要知道那到底是什么&lt;/span&gt;&lt;/tt&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-412462-3&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;3&lt;/a&gt;. &lt;span style=&quot;padding: 1px 0px 2px 0px; background-color:#FF00FF&quot;&gt;&lt;tt&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;你在指涉对你危险的信息&amp;#32;&lt;/span&gt;&lt;/tt&gt;&lt;/span&gt;&lt;/div&gt;
