&lt;td&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-4755&quot;&gt;SCP-4755&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Eparch（主教&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-466169-11&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;11&lt;/a&gt;&lt;/sup&gt;）&lt;/td&gt;
