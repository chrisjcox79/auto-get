&lt;p&gt;&amp;#171; &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-4959&quot;&gt;SCP-4959&lt;/a&gt; | SCP-4960 | &lt;a class=&quot;newpage&quot; href=&quot;http://scp-wiki-cn.wikidot.com/scp-4961&quot;&gt;SCP-4961&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/m-element&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2941964&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609918723&quot; alt=&quot;M Element&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2941964)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/m-element&quot;  &gt;M Element&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
