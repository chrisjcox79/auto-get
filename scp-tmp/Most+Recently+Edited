&lt;tr&gt;
&lt;td&gt;&lt;span style=&quot;font-size:125%;&quot;&gt;&lt;strong&gt;特邀嘉宾：&lt;/strong&gt;Dr.James Petahn，Mr.Michael Simmons&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;text-align: right;&quot;&gt;&lt;span style=&quot;font-size:125%;&quot;&gt;&lt;span style=&quot;color: #990000&quot;&gt;&lt;strong&gt;由3N广播网提供&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;
