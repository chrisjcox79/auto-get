&lt;blockquote&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-family:华文楷体;font-size: 100%&quot;&gt;&lt;em&gt;世界仍未开始，此为序章。&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;p&gt;&lt;br /&gt;
&lt;br /&gt;&lt;/p&gt;
&lt;div style=&quot;text-align: right;&quot;&gt;
&lt;p&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/fallen-world&quot;&gt;陨落的世界&lt;/a&gt; By &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/astra-glorice-sws&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3363881&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608342873&quot; alt=&quot;Astra_Glorice_SWS&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3363881)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/astra-glorice-sws&quot;  &gt;Astra_Glorice_SWS&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;blockquote&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-family:华文楷体;font-size: 100%&quot;&gt;&lt;em&gt;陨落的永远是世界，堕落的永远是人心。&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;p&gt;&lt;br /&gt;
&lt;br /&gt;&lt;/p&gt;
&lt;div style=&quot;text-align: right;&quot;&gt;
&lt;p&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/shamodercjl&quot;&gt;沙漠的日常记录&lt;/a&gt; By &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/knight-li-zx&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3267343&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608342873&quot; alt=&quot;Knight Li ZX&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3267343)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/knight-li-zx&quot;  &gt;Knight Li ZX&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;blockquote&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-family:华文楷体;font-size: 100%&quot;&gt;&lt;em&gt;命不久矣。我不想死。&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
