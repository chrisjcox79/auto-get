&lt;div style=&quot;background-color: transparent; padding-left: 7px;border-left: solid 5px #3399ff; border-radius: 0px 10px 10px 0px;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:120%;&quot;&gt;&lt;strong&gt;Site-CN-12&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
