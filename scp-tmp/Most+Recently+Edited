&lt;p&gt;&amp;#171; &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-4660&quot;&gt;SCP-4660&lt;/a&gt; | SCP-4661 | &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-4662&quot;&gt;SCP-4662&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ashausesall&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1546989&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606309850&quot; alt=&quot;ashausesall&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1546989)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ashausesall&quot;  &gt;ashausesall&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
