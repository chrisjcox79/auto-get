&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&amp;#171; &lt;a class=&quot;newpage&quot; href=&quot;http://scp-wiki-cn.wikidot.com/scp-3223&quot;&gt;SCP-3223&lt;/a&gt; | SCP-3224 | &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-3225&quot;&gt;SCP-3225&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/xiao-tian&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4506906&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610004697&quot; alt=&quot;Xiao Tian&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4506906)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/xiao-tian&quot;  &gt;Xiao Tian&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
