&lt;tr&gt;
&lt;td&gt;&lt;strong&gt;姓名：&lt;/strong&gt;Darry[&lt;span style=&quot;color: green&quot;&gt;面包先生&lt;/span&gt;]&lt;/td&gt;
&lt;td style=&quot;text-align: right;&quot;&gt;&lt;strong&gt;安保权限等级：&lt;/strong&gt;&lt;span style=&quot;color: red&quot;&gt;4级&lt;/span&gt;&lt;/td&gt;
