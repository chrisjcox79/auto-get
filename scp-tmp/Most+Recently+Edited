				<description>


&lt;div style=&quot;text-align: right;&quot;&gt;&lt;/div&gt;

&lt;div style=&quot;display:none&quot;&gt;&lt;iframe src=&quot;http://scp-wiki-cn.wdfiles.com/local--files/nav%3Aside/styleFrame.html?bhl&quot; name=&quot;typeFrame&quot;&gt;&lt;/iframe&gt;&lt;/div&gt;

&lt;div class=&quot;warning-box&quot;&gt;
&lt;div class=&quot;warning-box-container&quot;&gt;
&lt;div class=&quot;text-top&quot;&gt;&lt;span&gt;根据监督者议会的命令&lt;/span&gt;&lt;/div&gt;
&lt;div class=&quot;text-bottom&quot;&gt;&lt;span&gt;以下文档记录了一能导致BM级“破碎面纱”情景和SRA级“常态瓦解”情景的异常实体，为4/CN-1790级机密&lt;br /&gt;
&lt;strong&gt;禁止未经授权的访问&lt;/strong&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;text-number&quot;&gt;&lt;span&gt;CN-1790&lt;/span&gt;&lt;/div&gt;
&lt;div class=&quot;image-bg&quot;&gt;&lt;/div&gt;
&lt;/div&gt;

&lt;div class=&quot;anom-bar-container item-CN-1790 clear-4 keter none keneq 危险 {$american} lang-cn&quot;&gt;
&lt;div class=&quot;anom-bar&quot;&gt;
&lt;div class=&quot;top-box&quot;&gt;
&lt;div class=&quot;top-left-box&quot;&gt;&lt;span class=&quot;item&quot;&gt;&lt;span class=&quot;lang-cn&quot;&gt;项目编号：&lt;/span&gt;&lt;span class=&quot;lang-tr&quot;&gt;項目編號：&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;number&quot;&gt;CN-1790&lt;/span&gt;&lt;/div&gt;
&lt;div class=&quot;top-center-box&quot;&gt;
&lt;div class=&quot;bar-one&quot;&gt;&lt;/div&gt;
&lt;div class=&quot;bar-two&quot;&gt;&lt;/div&gt;
&lt;div class=&quot;bar-three&quot;&gt;&lt;/div&gt;
&lt;div class=&quot;bar-four&quot;&gt;&lt;/div&gt;
&lt;div class=&quot;bar-five&quot;&gt;&lt;/div&gt;
&lt;div class=&quot;bar-six&quot;&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;top-right-box&quot;&gt;
&lt;div class=&quot;level&quot;&gt;&lt;span class=&quot;lang-cn&quot;&gt;等级&lt;/span&gt;&lt;span class=&quot;lang-tr&quot;&gt;等級&lt;/span&gt;4&lt;/div&gt;
