&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/franz-ismal&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6351354&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608234538&quot; alt=&quot;Franz Ismal&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6351354)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/franz-ismal&quot;  &gt;Franz Ismal&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
