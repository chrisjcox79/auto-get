&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/xanarchy-militia&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6910500&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606548374&quot; alt=&quot;XANARCHY MILITIA&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6910500)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/xanarchy-militia&quot;  &gt;XANARCHY MILITIA&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
