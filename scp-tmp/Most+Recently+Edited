&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/auroriaaaaa&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5474061&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610072242&quot; alt=&quot;Auroriaaaaa&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5474061)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/auroriaaaaa&quot;  &gt;Auroriaaaaa&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
