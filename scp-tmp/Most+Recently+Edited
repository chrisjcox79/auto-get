&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/agt-leazov&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3006394&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607566268&quot; alt=&quot;Agt_LEAZOV&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3006394)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/agt-leazov&quot;  &gt;Agt_LEAZOV&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
