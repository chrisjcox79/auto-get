					<![CDATA[
						 <div id="u-ch-top"></div> <div id="u-hide-memu"></div> <div id="u-close-memu"></div> <div id="u-float-memu" class="memu-ch memu-pg"> <div class="fm-memu"> <p><span class="hide-memu"><a href="#u-hide-memu">隐藏</a></span> <span class="hide-memu-tip"><a href="javascript:;">移出鼠标</a></span> | <a href="#u-close-memu">关闭</a><span style="white-space: pre-wrap;">&#32;&#32;&#32;&#32;&#32;</span></p> </div> <div id="u-show-bar"></div> <div id="u-nap-bar"></div> <div class="rate-bar"> <div class="collapsible-block"> <div class="collapsible-block-folded"><a class="collapsible-block-link" href="javascript:;">+&nbsp;进行评分</a></div> <div class="collapsible-block-unfolded" style="display:none"> <div class="collapsible-block-unfolded-link"><a class="collapsible-block-link" href="javascript:;">-&nbsp;进行评分</a></div> <div class="collapsible-block-content"> <div class="rate-num"></div> <div class="rate-btn"></div> </div> </div> </div> </div> <hr /> <div class="memu-list"> <p><a href="#u-ch1">主题颜色</a></p> <p><a href="#u-ch2">著作信息块</a></p> <p><a href="#u-ch3">使用方法</a></p> <p><a href="#u-ch4">示例</a></p> <p><a href="#u-ch5">源代码</a></p> </div> <hr /> <div class="fm-goto"> <p><span class="fm-goto-top"><a href="#main-content">回到标题</a></span></p> <p><span class="fm-goto-bottom"><a href="#page-options-bottom">跳至底部</a></span></p> </div> </div> <div id="u-ch1"></div> <div class="tt-ch ch-1"> <div class="tt-line-top tt-{$self-line}"></div> <div class="tt-txt"> <h1><span>主题颜色</span></h1> <p><span class="sub-tt">{$sub-title}</span></p> </div> <div class="tt-line-bottom tt-{$self-line}"></div> </div> <div class="colors-container"> <div class="colors"> <div class="color" style="background-color: rgb(var(--gray-monochrome));" data-variable="--gray-monochrome" data-has-light-text="1">Payne's Grey<span class="css-variable"><span style="white-space: pre-wrap;">--gray-monochrome</span></span><span class="css-variable">(66, 66, 72)</span></div> <div class="color" style="background-color: rgb(var(--bright