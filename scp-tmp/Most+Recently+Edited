&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/varitas096&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3335543&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608362757&quot; alt=&quot;varitas096&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3335543)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/varitas096&quot;  &gt;varitas096&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
