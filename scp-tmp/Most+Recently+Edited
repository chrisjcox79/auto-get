&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/areyoucrazytom&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1476662&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606482990&quot; alt=&quot;Areyoucrazytom&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1476662)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/areyoucrazytom&quot;  &gt;Areyoucrazytom&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
