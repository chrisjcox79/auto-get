&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;/p&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;div class=&quot;unmargined&quot; style=&quot;font-size: 400%; font-weight: bold; margin: 2px 0 5px;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;color:red&quot;&gt;权限不足&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
