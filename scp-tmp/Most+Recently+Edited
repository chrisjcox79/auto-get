&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:300px;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/scp-1000/bigfoot_patterson01-new.png&quot; style=&quot;width:300px;&quot; alt=&quot;bigfoot_patterson01-new.png&quot; class=&quot;image&quot; /&gt;
