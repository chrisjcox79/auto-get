4%A9%E5%A3%8A%E3%81%AE%E3%81%8D%E3%81%A3%E3%81%8B%E3%81%91.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E5%B4%A9%E5%A3%8A%E3%81%AE%E3%81%8D%E3%81%A3%E3%81%8B%E3%81%91.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>崩坏的契机</strong></span></span><br /> <span style="font-size:85%;"><strong>发布一篇评分20以上、包含K级情景标签的SCP文档</strong></span></p> </div> <div class="right-grid"> <div class="image-container floatleft"><img src="http://scp-jp.wdfiles.com/local--files/hal-aki-achievement-badges/%E5%AE%9F%E7%B8%BE_%E7%A7%A9%E5%BA%8F%E3%82%92%E5%AE%88%E3%82%8B%E6%82%AA%E9%AD%94.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E7%A7%A9%E5%BA%8F%E3%82%92%E5%AE%88%E3%82%8B%E6%82%AA%E9%AD%94.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>守护秩序的恶魔</strong></span></span><br /> <span style="font-size:85%;"><strong>发布一篇评分20以上、关于Thaumiel级项目的SCP文档</strong></span></p> </div> <div class="right-grid"> <div class="image-container floatleft"><img src="http://scp-jp.wdfiles.com/local--files/hal-aki-achievement-badges/%E5%AE%9F%E7%B8%BE_%E3%82%B7%E3%83%B3%E3%83%97%E3%83%AB%E3%82%A4%E3%82%BA%E3%83%99%E3%82%B9%E3%83%88.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E3%82%B7%E3%83%B3%E3%83%97%E3%83%AB%E3%82%A4%E3%82%BA%E3%83%99%E3%82%B9%E3%83%88.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>简单的就是最好的</strong></span></span><br /> <span style="font-size:85%;"><strong>发布一篇通常格式的且不包含附录、录音、实验记录、访谈记录、探索记录等的SCP文章，并得到20以上的评分</strong></span></p> </div> <div class="left-grid"> <div class="image-container floatleft"><img src="http://scp-jp.wdfiles.com/local--files/hal-aki-achievement-badges/%E5%AE%9F%E7%B8%BE_%E3%81%BF%E3%82%93%E3%81%AA%E3%81%A7%E3%81%A4%E3%81%8F%E3%82%8D%E3%81%86.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E3%81%BF%E3%82%93%E3%81%AA%E3%81%A7%E3%81%A4%E3%81%8F%E3%82%8D%E3%81%86.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>大家一起