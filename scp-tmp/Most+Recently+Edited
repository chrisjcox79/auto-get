&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/doctor-jackal&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6627245&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608062474&quot; alt=&quot;Doctor Jackal&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6627245)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/doctor-jackal&quot;  &gt;Doctor Jackal&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
