&lt;td colspan=&quot;2&quot;&gt;&lt;a href=&quot;http://scp-wiki-cn.wdfiles.com/local--files/scp-cn-1506/%E4%B8%89%E7%AE%AD%E9%9D%B6&quot;&gt;&lt;img src=&quot;http://scp-wiki-cn.wdfiles.com/local--resized-images/scp-cn-1506/%E4%B8%89%E7%AE%AD%E9%9D%B6/medium.jpg&quot; width=&quot;300px&quot; alt=&quot;三箭靶&quot; class=&quot;image&quot; /&gt;&lt;/a&gt;&lt;/td&gt;
