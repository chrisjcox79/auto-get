&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/olivafute&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3354275&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608342873&quot; alt=&quot;OlivaFute&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3354275)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/olivafute&quot;  &gt;OlivaFute&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
