&lt;div class=&quot;level-text&quot;&gt;&lt;span class=&quot;base false CN&quot;&gt;5/4786&lt;/span&gt; LEVEL &lt;span class=&quot;base false CN&quot;&gt;5/4786&lt;/span&gt;&lt;/div&gt;
