- &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/placeholder-mcd&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6536693&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608297639&quot; alt=&quot;Placeholder McD&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6536693)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/placeholder-mcd&quot;  &gt;Placeholder McD&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div class=&quot;blockquote&quot;&gt;
&lt;p&gt;你真的有写过什么吗，Estrella？&lt;br /&gt;
- &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ralliston&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5986843&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608297639&quot; alt=&quot;Ralliston&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5986843)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ralliston&quot;  &gt;Ralliston&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
