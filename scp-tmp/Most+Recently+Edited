&lt;p&gt;原作者：&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/rounderhouse&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4187885&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606527822&quot; alt=&quot;Rounderhouse&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4187885)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/rounderhouse&quot;  &gt;Rounderhouse&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;
&lt;a href=&quot;http://www.scp-wiki.net/maybe-i-m-a-king&quot;&gt;原文&lt;/a&gt;&lt;/p&gt;
&lt;hr /&gt;
&lt;p&gt;译者：&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/basil42636&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5854176&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606527822&quot; alt=&quot;basil42636&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5854176)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/basil42636&quot;  &gt;basil42636&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;hr /&gt;
&lt;div class=&quot;credit-back&quot; style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki-cn.wikidot.com/credit:backmodule/code/2&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;no&quot; width=&quot;&quot; class=&quot;&quot; style=&quot;height:2em;width: 100%;margin: 0;padding: 0;border: 0;background: transparent;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
&lt;/div&gt;
