&lt;p&gt;&lt;strong&gt;SCP-CN-1323 粉红佳人&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;作者：&lt;/strong&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/h-storm-z&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4761754&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607238861&quot; alt=&quot;H-Storm Z&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4761754)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/h-storm-z&quot;  &gt;H-Storm Z&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;人事页：&lt;/strong&gt; &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/hsz-file&quot;&gt;http://scp-wiki-cn.wikidot.com/hsz-file&lt;/a&gt;&lt;/p&gt;
&lt;div class=&quot;credit-back&quot; style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki.wdfiles.com/local--code/info%3Astyle/2&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;no&quot; width=&quot;&quot; class=&quot;&quot; style=&quot;height:2em;width: 100%;margin: 0;padding: 0;border: 0;background: transparent;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
