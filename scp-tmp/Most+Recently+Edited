&lt;div style=&quot;text-align: right;&quot;&gt;
&lt;p&gt;&lt;span class=&quot;ruby&quot;&gt;&lt;em&gt;套路拥有局限性&lt;/em&gt;&lt;span class=&quot;rt&quot;&gt;“Tricks have Limitations”&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;div id=&quot;wiki-tab-0-3&quot; style=&quot;display:none&quot;&gt;
