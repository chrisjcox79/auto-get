&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/greenson&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2765162&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607542487&quot; alt=&quot;Greenson&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2765162)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/greenson&quot;  &gt;Greenson&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
