&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/breaddddd&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3471238&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607671290&quot; alt=&quot;breaddddd&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3471238)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/breaddddd&quot;  &gt;breaddddd&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
