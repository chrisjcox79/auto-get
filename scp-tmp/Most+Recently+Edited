&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/little-black&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4693901&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607671286&quot; alt=&quot;Little_Black&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4693901)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/little-black&quot;  &gt;Little_Black&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
