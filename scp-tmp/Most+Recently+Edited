&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:30%;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/adult:scp-5169/scp-5169-instance.jpg&quot; style=&quot;width:30%;&quot; alt=&quot;scp-5169-instance.jpg&quot; class=&quot;image&quot; /&gt;
&lt;div class=&quot;scp-image-caption&quot; style=&quot;width:30%;&quot;&gt;
&lt;p&gt;一个SCP-5169个体&lt;/p&gt;
&lt;/div&gt;
