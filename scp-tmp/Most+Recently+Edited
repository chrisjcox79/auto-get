&lt;div style=&quot;clear:both; height: 0px; font-size: 1px&quot;&gt;&lt;/div&gt;
&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;/p&gt;
&lt;blockquote&gt;
&lt;p&gt;更多相关情报等待基金会总部发布。&lt;/p&gt;
&lt;/blockquote&gt;
&lt;/div&gt;
&lt;div id=&quot;wiki-tab-0-3&quot; style=&quot;display:none&quot;&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:120%;&quot;&gt;&lt;strong&gt;感谢所有为我提供帮助的朋友，你们是我心中的基金会之光。&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;hr /&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:120%;&quot;&gt;&lt;strong&gt;SCP文档&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;hr /&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:130%;&quot;&gt;&lt;strong&gt;&lt;a target=&quot;_blank&quot; href=&quot;http://scp-wiki-cn.wikidot.com/scp-cn-1229&quot;&gt;SCP-CN-1229&lt;/a&gt;&lt;/strong&gt;&lt;/span&gt;&lt;br /&gt;
