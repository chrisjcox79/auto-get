&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wuhu-horse&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4092253&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607542477&quot; alt=&quot;WuHu Horse&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4092253)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wuhu-horse&quot;  &gt;WuHu Horse&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;
SCP-CN-1708“你的第一位入门级朋友”&lt;/p&gt;
&lt;/div&gt;
&lt;hr /&gt;
&lt;div class=&quot;credit-back&quot; style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki-cn.wikidot.com/credit:backmodule/code/2&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;no&quot; width=&quot;&quot; class=&quot;&quot; style=&quot;height:2em;width: 100%;margin: 0;padding: 0;border: 0;background: transparent;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
