&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: #102141&quot;&gt;&lt;span style=&quot;font-size:180%;&quot;&gt;&lt;strong&gt;主战区重要事件时间线（GMT +0）：&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
