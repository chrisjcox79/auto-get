&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&amp;#171; &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-cn-1110&quot;&gt;SCP-CN-1110&lt;/a&gt; | SCP-CN-1111 | &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-cn-1112&quot;&gt;SCP-CN-1112&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/enflowerz&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4457426&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607023564&quot; alt=&quot;Enflowerz&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4457426)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/enflowerz&quot;  &gt;Enflowerz&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
