&lt;div class=&quot;scp-image-caption&quot; style=&quot;width:100%;&quot;&gt;
&lt;p&gt;SCP-CN-023收容间外部隔间通道，应注意此处绿色发光体为Observer-Ñ探测装置&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-58448-1&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;1&lt;/a&gt;&lt;/sup&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;hr /&gt;
&lt;table style=&quot;width: 100%;&quot;&gt;
&lt;tr&gt;
&lt;td style=&quot;border-bottom: 1px solid #AAA; border-right: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:90%;&quot;&gt;&lt;strong&gt;指派站点&lt;/strong&gt;&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;border-bottom: 1px solid #AAA; border-right: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:90%;&quot;&gt;&lt;strong&gt;站点主管&lt;/strong&gt;&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;border-bottom: 1px solid #AAA; border-right: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:90%;&quot;&gt;&lt;strong&gt;首席研究员&lt;/strong&gt;&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;border-bottom: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:90%;&quot;&gt;&lt;strong&gt;指派特遣队&lt;/strong&gt;&lt;/span&gt;&lt;/td&gt;
