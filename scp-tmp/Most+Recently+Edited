&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/grass-block&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6984424&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606960338&quot; alt=&quot;grass_block&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6984424)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/grass-block&quot;  &gt;grass_block&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
