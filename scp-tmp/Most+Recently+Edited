&lt;div class=&quot;collapsible-block-content&quot;&gt;
&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;/p&gt;
&lt;div style=&quot;border:solid 1px #999999; background:#f2f2f2; padding:5px; margin-bottom: 10px;&quot;&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;h3&gt;&lt;span&gt;&lt;tt&gt;事件5195/1&lt;/tt&gt;&lt;/span&gt;&lt;/h3&gt;
&lt;/div&gt;
&lt;hr /&gt;
&lt;p&gt;&lt;strong&gt;地点：&lt;/strong&gt;美国，威斯康星州，麦迪逊市&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;状态：&lt;/strong&gt;已结束&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;时间：&lt;/strong&gt;2015年10月4日上午5:55（当地时间）&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;扰动等级：&lt;/strong&gt; Vlam&lt;/p&gt;
&lt;hr /&gt;

&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:260px;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/scp-5195/smokey&quot; style=&quot;width:260px;&quot; class=&quot;enlarge&quot; alt=&quot;smokey&quot; /&gt;
