&lt;div class=&quot;image-container aligncenter&quot;&gt;&lt;a href=&quot;http://scp-wiki-cn.wdfiles.com/local--files/scp-cn-1563/EBL.jpg&quot;&gt;&lt;img src=&quot;http://scp-wiki-cn.wdfiles.com/local--resized-images/scp-cn-1563/EBL.jpg/thumbnail.jpg&quot; alt=&quot;EBL.jpg&quot; class=&quot;image&quot; /&gt;&lt;/a&gt;&lt;/div&gt;
