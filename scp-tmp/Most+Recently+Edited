&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-846609-5&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;5&lt;/a&gt;. &lt;span style=&quot;filter: blur(3px)&quot;&gt;[dhka]&lt;/span&gt;&lt;/div&gt;
