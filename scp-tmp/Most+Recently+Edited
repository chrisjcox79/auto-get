&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&amp;#171; &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-230&quot;&gt;SCP-230&lt;/a&gt; | SCP-231 | &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-232&quot;&gt;SCP-232&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mscarlet&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1745583&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609766812&quot; alt=&quot;MScarlet&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1745583)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mscarlet&quot;  &gt;MScarlet&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
