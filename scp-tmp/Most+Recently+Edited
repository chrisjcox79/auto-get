&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/vxeov&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5216981&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609035452&quot; alt=&quot;vxeov&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5216981)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/vxeov&quot;  &gt;vxeov&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
