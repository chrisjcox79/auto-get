&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sciencekiller&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5480202&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610026646&quot; alt=&quot;sciencekiller&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5480202)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sciencekiller&quot;  &gt;sciencekiller&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
