&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sistertan-greasy&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3978938&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606527821&quot; alt=&quot;SisterTan_Greasy&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3978938)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sistertan-greasy&quot;  &gt;SisterTan_Greasy&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
