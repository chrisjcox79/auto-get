&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/nirvana073&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6031220&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607369567&quot; alt=&quot;nirvana073&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6031220)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/nirvana073&quot;  &gt;nirvana073&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
