&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/rorrerd&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3453246&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607606879&quot; alt=&quot;rorrErD&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3453246)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/rorrerd&quot;  &gt;rorrErD&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
