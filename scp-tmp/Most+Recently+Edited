&lt;td style=&quot;border-right: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:80%;&quot;&gt;Samira Golzar博士&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:80%;&quot;&gt;Gamma-44 (“锁肉者”)&lt;/span&gt;&lt;/td&gt;
