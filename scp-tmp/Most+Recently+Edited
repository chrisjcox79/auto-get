&lt;div class=&quot;collapsible-block-unfolded&quot; style=&quot;display:none&quot;&gt;
&lt;div class=&quot;collapsible-block-unfolded-link&quot;&gt;&lt;a class=&quot;collapsible-block-link&quot; href=&quot;javascript:;&quot;&gt;以河城满雪为主题的古诗&lt;/a&gt;&lt;/div&gt;
&lt;div class=&quot;collapsible-block-content&quot;&gt;
