&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/universe647&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4376536&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607348714&quot; alt=&quot; Universe647&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4376536)&quot; /&gt;&lt;/a&gt; &lt;a href=&quot;http://www.wikidot.com/user:info/universe647&quot;  &gt;Universe647&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
