&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:200px;&quot;&gt;&lt;img src=&quot;http://scp-wiki-cn.wdfiles.com/local--files/scp-cn-1426/%E6%89%8B%E5%8D%B0.jpg&quot; style=&quot;width:200px;&quot; alt=&quot;手印.jpg&quot; class=&quot;image&quot; /&gt;
