&lt;tr&gt;
&lt;td colspan=&quot;2&quot;&gt;&lt;img src=&quot;http://scp-wiki-cn.wikidot.com/local--files/wgdhqzxy/xiamen-3515964_960_720.jpg&quot; width=&quot;900px&quot; alt=&quot;xiamen-3515964_960_720.jpg&quot; class=&quot;image&quot; /&gt;&lt;/td&gt;
