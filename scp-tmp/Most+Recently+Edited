&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ljsikyuaglnt&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6013718&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608297632&quot; alt=&quot;LjsikYuaglnT&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6013718)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ljsikyuaglnt&quot;  &gt;LjsikYuaglnT&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
