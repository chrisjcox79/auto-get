&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/word422&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6201446&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606482993&quot; alt=&quot;word422&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6201446)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/word422&quot;  &gt;word422&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
