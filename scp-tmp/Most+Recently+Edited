&lt;td&gt;Threatening（威胁性&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-924933-20&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;20&lt;/a&gt;&lt;/sup&gt;）&lt;/td&gt;
