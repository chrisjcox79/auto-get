&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/m-element&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2941964&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607174731&quot; alt=&quot;M Element&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2941964)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/m-element&quot;  &gt;M Element&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
