&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-5152&quot;&gt;SCP-5152&lt;/a&gt;&lt;br /&gt;
&lt;span style=&quot;font-size:60%;&quot;&gt;&lt;em&gt;标题：身虽死，痛仍存&lt;/em&gt;&lt;/span&gt;&lt;br /&gt;
&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-4210&quot;&gt;SCP-4210&lt;/a&gt;&lt;br /&gt;
&lt;span style=&quot;font-size:60%;&quot;&gt;&lt;em&gt;标题：美国之梦&lt;/em&gt;&lt;/span&gt;&lt;br /&gt;
&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-4984&quot;&gt;SCP-4984&lt;/a&gt;&lt;br /&gt;
&lt;span style=&quot;font-size:60%;&quot;&gt;&lt;em&gt;标题：记忆菌丝体&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div id=&quot;wiki-tab-0-2&quot; style=&quot;display:none&quot;&gt;
&lt;p&gt;暂无，也许以后会有吧&lt;br /&gt;
当然&amp;#8230;&amp;#8230;&lt;br /&gt;
人的本质是&amp;#8230;&amp;#8230;&lt;br /&gt;
&lt;span style=&quot;font-size:1000%;&quot;&gt;&lt;br /&gt;
&lt;span style=&quot;color: red&quot;&gt;咕&lt;/span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:1000%;&quot;&gt;&lt;br /&gt;
&lt;span style=&quot;color: red&quot;&gt;咕&lt;/span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/p&gt;
