&lt;td style=&quot;border: 0px&quot;&gt;&lt;img src=&quot;http://scpsandboxcn.wdfiles.com/local--files/gec-hub-page/how-gec-work.jpg&quot; width=&quot;100px&quot; alt=&quot;how-gec-work.jpg&quot; class=&quot;image&quot; /&gt;&lt;/td&gt;
