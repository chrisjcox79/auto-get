&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/simon-arran&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4354147&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608038150&quot; alt=&quot;Simon Arran&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4354147)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/simon-arran&quot;  &gt;Simon Arran&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
