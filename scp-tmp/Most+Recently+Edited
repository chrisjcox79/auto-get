&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lyrics-linn&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3935168&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609813924&quot; alt=&quot;Lyrics Linn&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3935168)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lyrics-linn&quot;  &gt;Lyrics Linn&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
