round-image:url(http://www.wikidot.com/userkarma.php?u=3975741)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wlft&quot;  &gt;wlft&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
