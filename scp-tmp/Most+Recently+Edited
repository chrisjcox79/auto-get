&lt;p&gt;&lt;span style=&quot;color: pink&quot;&gt;&lt;strong&gt;SCP少女秘密甜心茶话会！&lt;/strong&gt;&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;color: pink&quot;&gt;&lt;strong&gt;作者：&lt;/strong&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/scotoma&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3929032&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609813925&quot; alt=&quot;Scotoma&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3929032)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/scotoma&quot;  &gt;Scotoma&lt;/a&gt;&lt;/span&gt;，作者页在&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scotoma&quot;&gt;此&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;color: pink&quot;&gt;&lt;strong&gt;图片来源：&lt;/strong&gt;&lt;/span&gt;&lt;br /&gt;
&lt;a href=&quot;https://pixabay.com/images/id-3151843/&quot; target=&quot;_blank&quot;&gt;https://pixabay.com/images/id-3151843/&lt;/a&gt;&lt;br /&gt;
&lt;a href=&quot;https://pixabay.com/images/id-1260975/&quot; target=&quot;_blank&quot;&gt;https://pixabay.com/images/id-1260975/&lt;/a&gt;&lt;br /&gt;
&lt;a href=&quot;https://commons.m.wikimedia.org/wiki/File:Mostafa_Chamran%27s))_dead_body.jpg&quot; target=&quot;_blank&quot;&gt;https://commons.m.wikimedia.org/wiki/File:Mostafa_Chamran%27s))_dead_body.jpg&lt;/a&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;color: pink&quot;&gt;&lt;strong&gt;特别鸣谢：&lt;/strong&gt;&lt;em&gt;中分写手妇女之友goc帮忙找图片！&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div class=&quot;credit-back&quot; style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;iframe src=&quot;https://scp-wiki.wdfiles.com/local--code/info%3Astyle/2&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;no&quot; width=&quot;&quot; class=&quot;&quot; style=&quot;height:2em;width: 100%;margin: 0;padding: 0;border: 0;background: transparent;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
