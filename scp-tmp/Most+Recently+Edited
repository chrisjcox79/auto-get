&lt;strong&gt;授权信息&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/etinjat&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4055881&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606331632&quot; alt=&quot;Etinjat&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4055881)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/etinjat&quot;  &gt;Etinjat&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div class=&quot;footnotes-footer&quot;&gt;
&lt;div class=&quot;title&quot;&gt;脚注&lt;/div&gt;
