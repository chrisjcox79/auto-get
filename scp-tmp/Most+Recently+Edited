&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/samuel-zhang&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3322357&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605922389&quot; alt=&quot;Samuel Zhang&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3322357)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/samuel-zhang&quot;  &gt;Samuel Zhang&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
