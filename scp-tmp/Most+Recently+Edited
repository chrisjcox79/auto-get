&lt;div class=&quot;collapsible-block-unfolded-link&quot;&gt;&lt;a class=&quot;collapsible-block-link&quot; href=&quot;javascript:;&quot;&gt;-&amp;nbsp;SCP-INT-003&amp;nbsp;三箭靶&lt;/a&gt;&lt;/div&gt;
&lt;div class=&quot;collapsible-block-content&quot;&gt;
&lt;div style=&quot;float:right; margin:0 2em 1em 2em; width:300px; border:0;&quot;&gt;
