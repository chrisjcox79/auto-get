&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/swred&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5992128&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606916406&quot; alt=&quot;Swred&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5992128)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/swred&quot;  &gt;Swred&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
