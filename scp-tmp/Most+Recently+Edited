&lt;/blockquote&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sraosha&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4587360&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606980703&quot; alt=&quot;Sraosha&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4587360)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sraosha&quot;  &gt;Sraosha&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
