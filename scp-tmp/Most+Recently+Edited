&lt;td&gt;Principalis&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-466169-19&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;19&lt;/a&gt;&lt;/sup&gt;&lt;/td&gt;
