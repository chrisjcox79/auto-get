&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&amp;#171; &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-2753&quot;&gt;SCP-2753&lt;/a&gt; | SCP-2754 | &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-2755&quot;&gt;SCP-2755&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/just-f&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5712643&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605922395&quot; alt=&quot;Just F&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5712643)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/just-f&quot;  &gt;Just F&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
