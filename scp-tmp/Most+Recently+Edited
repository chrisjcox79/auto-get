&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki-cn.wdfiles.com/local--files/nav%3Aside/styleFrame.html?bhl&quot; style=&quot;display: none;&quot; name=&quot;typeFrame&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/last-mothflame&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3709564&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606138011&quot; alt=&quot;Last Mothflame&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3709564)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/last-mothflame&quot;  &gt;Last Mothflame&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
