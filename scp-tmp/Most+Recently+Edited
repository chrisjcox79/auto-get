无声记忆 | &lt;a href=&quot;javascript:;&quot;&gt;敬请期待&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-fishbone&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6127045&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608038149&quot; alt=&quot;Dr Fishbone&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6127045)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-fishbone&quot;  &gt;Dr Fishbone&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
