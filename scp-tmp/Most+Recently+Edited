&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mass-meme&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4588322&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607931040&quot; alt=&quot;Mass-MEME&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4588322)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mass-meme&quot;  &gt;Mass-MEME&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
