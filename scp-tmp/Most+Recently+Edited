&lt;p&gt;&lt;span style=&quot;color: #256091&quot;&gt;&lt;span style=&quot;font-size:150%;&quot;&gt;&lt;strong&gt;访问需获得Dr.Fishbone书面许可&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;hr /&gt;
&lt;p&gt;&lt;span style=&quot;font-size:larger;&quot;&gt;&lt;strong&gt;SCP-CN-665&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;br /&gt;
&lt;span style=&quot;font-size:x-large;&quot;&gt;&lt;br /&gt;
&lt;br /&gt;&lt;/span&gt;
