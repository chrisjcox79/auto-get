&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-475551-3&quot;&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;3&lt;/a&gt;.&lt;/span&gt;&lt;/div&gt;
