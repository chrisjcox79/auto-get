&lt;div class=&quot;foldable-list-container&quot;&gt;&lt;a href=&quot;javascript:;&quot;&gt;+ 需4级权限查看&lt;/a&gt;&lt;a href=&quot;javascript:;&quot;&gt;- 需4级权限查看&lt;/a&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;colmod-content&quot;&gt;
&lt;div class=&quot;colmod-block&quot;&gt;
&lt;ul&gt;
&lt;li class=&quot;folded&quot;&gt;
&lt;ul&gt;
