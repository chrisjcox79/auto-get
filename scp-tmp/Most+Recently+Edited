&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/daniel-researcher&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6980732&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607261883&quot; alt=&quot;Daniel Researcher&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6980732)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/daniel-researcher&quot;  &gt;Daniel Researcher&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
