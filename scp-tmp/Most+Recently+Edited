&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ranpox&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3408614&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606397367&quot; alt=&quot;RanpoX&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3408614)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ranpox&quot;  &gt;RanpoX&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
