&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/aplous&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6236003&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609099639&quot; alt=&quot;aplous&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6236003)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/aplous&quot;  &gt;aplous&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
