&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dawntang&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5137332&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609533601&quot; alt=&quot;DawnTang&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5137332)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dawntang&quot;  &gt;DawnTang&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
