&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/halwsb&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7085925&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608040341&quot; alt=&quot;halwsb&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7085925)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/halwsb&quot;  &gt;halwsb&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
