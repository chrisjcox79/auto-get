&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/limbo-eishundo&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6133858&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608040344&quot; alt=&quot;Limbo Eishundo&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6133858)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/limbo-eishundo&quot;  &gt;Limbo Eishundo&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
