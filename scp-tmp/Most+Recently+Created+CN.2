&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/desert-walker&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3802982&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609533603&quot; alt=&quot;Desert_Walker&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3802982)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/desert-walker&quot;  &gt;Desert_Walker&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
