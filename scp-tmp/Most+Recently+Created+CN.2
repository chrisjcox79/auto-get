&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/bokapama&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3382392&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608001931&quot; alt=&quot;bokapama&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3382392)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/bokapama&quot;  &gt;bokapama&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
