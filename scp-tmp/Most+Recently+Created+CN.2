&lt;h2&gt;&lt;span&gt;著作信息&lt;/span&gt;&lt;/h2&gt;
&lt;/div&gt;
&lt;hr /&gt;
&lt;div class=&quot;credit first&quot;&gt;
&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki-cn.wikidot.com/credit:backmodule/code/4&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;&quot; width=&quot;&quot; class=&quot;close-credits&quot; style=&quot;height:2em;margin: 0;padding: 0;border: 0;background: transparent;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
&lt;p&gt;本文作者为：&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ctorjschen&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4530800&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607285562&quot; alt=&quot;CTorJSChen&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4530800)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ctorjschen&quot;  &gt;CTorJSChen&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;
