&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/komeijicat&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5834551&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607285564&quot; alt=&quot;KomeijiCat&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5834551)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/komeijicat&quot;  &gt;KomeijiCat&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
