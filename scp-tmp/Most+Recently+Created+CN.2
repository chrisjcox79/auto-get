				<title>命途川流不息</title>
				<link>http://scp-wiki-cn.wikidot.com/oceanus-the-timeless</link>
				<description>


&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ruinenstadt&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4358590&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609791173&quot; alt=&quot;Ruinenstadt&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4358590)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ruinenstadt&quot;  &gt;Ruinenstadt&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
