&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/esperanza-cai&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4113182&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609384431&quot; alt=&quot;Esperanza_Cai&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4113182)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/esperanza-cai&quot;  &gt;Esperanza_Cai&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
