&lt;td style=&quot;padding: 0 2px;border: 1px solid #888;&quot;&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tenth-lee&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5226483&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608323372&quot; alt=&quot;Tenth Lee&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5226483)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tenth-lee&quot;  &gt;Tenth Lee&lt;/a&gt;&lt;/span&gt;&lt;/td&gt;
