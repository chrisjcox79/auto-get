&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sekai-s&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4476849&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609856036&quot; alt=&quot;Sekai_s&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4476849)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sekai-s&quot;  &gt;Sekai_s&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
