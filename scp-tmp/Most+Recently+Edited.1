&lt;/tr&gt;
&lt;tr&gt;
&lt;th style=&quot;text-align:left; vertical-align:top; padding-right: 1em&quot;&gt;
&lt;p&gt;&lt;br /&gt;&lt;/p&gt;
&lt;/th&gt;
