&lt;td&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-cn-1900&quot;&gt;SCP-CN-1900&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Compromised&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
&lt;td&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-cn-1025&quot;&gt;SCP-CN-1025&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Daath&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
&lt;td&gt;&lt;a class=&quot;newpage&quot; href=&quot;http://scp-wiki-cn.wikidot.com/scp-411-jp&quot;&gt;SCP-411-JP&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Ether&lt;/td&gt;
