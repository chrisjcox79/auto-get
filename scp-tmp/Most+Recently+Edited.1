&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ziper&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3612285&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608906543&quot; alt=&quot;ziper&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3612285)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ziper&quot;  &gt;ziper&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
