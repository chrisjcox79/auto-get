&lt;td&gt;J. Micheals&lt;/td&gt;
&lt;td&gt;&lt;span style=&quot;color: green&quot;&gt;&lt;strong&gt;已接受&lt;/strong&gt;&lt;/span&gt;&lt;/td&gt;
