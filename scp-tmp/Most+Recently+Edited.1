&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/kcorena&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3396110&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608323378&quot; alt=&quot;Kcorena&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3396110)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/kcorena&quot;  &gt;Kcorena&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
