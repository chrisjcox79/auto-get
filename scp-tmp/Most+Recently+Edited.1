&lt;li&gt;&lt;span style=&quot;font-family:华文楷体;font-size: 120%&quot;&gt;执行基金会编制外处决任务&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-family:华文楷体;font-size: 120%&quot;&gt;&lt;span style=&quot;text-decoration: line-through;&quot;&gt;每周为死者献上祝福&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;审讯&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;text-decoration: line-through;&quot;&gt;晚上出来吓人&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
