&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/r418&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4990357&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609145896&quot; alt=&quot;R418&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4990357)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/r418&quot;  &gt;R418&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
