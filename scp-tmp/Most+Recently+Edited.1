&lt;td&gt;&lt;a class=&quot;newpage&quot; href=&quot;http://scp-wiki-cn.wikidot.com/scp-5338&quot;&gt;SCP-5338&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Damballah&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-140250-8&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;8&lt;/a&gt;&lt;/sup&gt;&lt;/td&gt;
&lt;td&gt;项目已被收容，但收容方法与目的仍未知。&lt;/td&gt;
&lt;td&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-5466&quot;&gt;SCP-5466&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;解除分级&lt;/td&gt;
&lt;td&gt;项目已向公众披露。&lt;/td&gt;
&lt;td&gt;&lt;a class=&quot;newpage&quot; href=&quot;http://scp-wiki-cn.wikidot.com/scp-3368&quot;&gt;SCP-3368&lt;/a&gt;，&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-3882&quot;&gt;SCP-3882&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
