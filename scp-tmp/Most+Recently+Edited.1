src="http://scp-jp.wdfiles.com/local--files/hal-aki-achievement-badges/%E5%AE%9F%E7%B8%BE_%E4%B8%89%E4%BA%BA%E5%AF%84%E3%82%8C%E3%81%B0.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E4%B8%89%E4%BA%BA%E5%AF%84%E3%82%8C%E3%81%B0.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>三人行</strong></span></span><br /> <span style="font-size:85%;"><strong>在讨论区发布草稿</strong></span><br /> <span style="font-size:85%;"><strong><em><a href="http://scp-wiki-cn.wikidot.com/forum/t-4273014/#post-3631645">2017/11/14</a><sup class="footnoteref"><a id="footnoteref-991133-1" href="javascript:;" class="footnoteref" >1</a></sup></em></strong></span></p> </div> <div class="left-grid"> <div class="image-container floatleft"><img src="http://scp-jp.wdfiles.com/local--files/hal-aki-achievement-badges/%E5%AE%9F%E7%B8%BE_%E5%B0%8F%E3%81%95%E3%81%AA%E4%B8%80%E6%AD%A9.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E5%B0%8F%E3%81%95%E3%81%AA%E4%B8%80%E6%AD%A9.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>一小步</strong></span></span><br /> <span style="font-size:85%;"><strong>发布一篇文档</strong></span><br /> <span style="font-size:85%;"><strong><em>首篇文档：<a href="http://scp-wiki-cn.wikidot.com/scp-cn-254">SCP-CN-254</a>，2018/01/12</em></strong></span></p> </div> <div class="right-grid"> <div class="image-container floatleft"><img src="http://scp-jp.wdfiles.com/local--files/hal-aki-achievement-badges/%E5%AE%9F%E7%B8%BE_%E6%8E%A1%E7%94%A8%E9%80%9A%E7%9F%A5.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E6%8E%A1%E7%94%A8%E9%80%9A%E7%9F%A5.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>录取通知</strong></span></span><br /> <span style="font-size:85%;"><strong>创建人事档案</strong></span><br /> <span style="font-size:85%;"><strong><em><a href="http://scp-wiki-cn.wikidot.com/kcorena-s-personnel-file">2020/02/20</a></em></strong></span></p> </div> <div class="left-grid"> <div class="image-contain