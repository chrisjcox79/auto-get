&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;|max=10&amp;#32;（表目數值在圖表上的最大值）&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;|data1=10&amp;#32;（此處開始為表目數值）&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;|data2=1&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;|data3=10&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;|data4=1&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;|data5=10&lt;/span&gt;&lt;br /&gt;
