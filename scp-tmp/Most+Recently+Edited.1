&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/eurya&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4369343&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609945050&quot; alt=&quot;Eurya&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4369343)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/eurya&quot;  &gt;Eurya&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
