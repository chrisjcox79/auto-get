&lt;div class=&quot;collab-header&quot; style=&quot;text-align: center;&quot;&gt;
&lt;hr /&gt;
&lt;h2&gt;&lt;span&gt;更多页面&lt;/span&gt;&lt;/h2&gt;
&lt;hr /&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;div id=&quot;wiki-tab-0-2&quot; style=&quot;display:none&quot;&gt;
&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:300px;&quot;&gt;&lt;img src=&quot;http://scp-wiki-cn.wikidot.com/local--files/scotoma/%E5%88%AB%E7%9C%8B%E5%A4%B4&quot; style=&quot;width:300px;&quot; alt=&quot;%E5%88%AB%E7%9C%8B%E5%A4%B4&quot; class=&quot;image&quot; /&gt;
&lt;div class=&quot;scp-image-caption&quot; style=&quot;width:300px;&quot;&gt;
&lt;p&gt;由&lt;span class=&quot;printuser&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/fishsimple&quot;  &gt;FishSimple&lt;/a&gt;&lt;/span&gt;绘制的Scotoma（不要管头）&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:300px;&quot;&gt;&lt;img src=&quot;http://scp-wiki-cn.wikidot.com/local--files/scotoma/%E7%BA%BF%E7%A8%BF&quot; style=&quot;width:300px;&quot; alt=&quot;%E7%BA%BF%E7%A8%BF&quot; class=&quot;image&quot; /&gt;
&lt;div class=&quot;scp-image-caption&quot; style=&quot;width:300px;&quot;&gt;
