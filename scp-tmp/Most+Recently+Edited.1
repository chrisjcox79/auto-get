&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;|label1=H&amp;#32;（此處開始為表目名稱）&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;|label2=A&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;|label3=B&lt;/span&gt;&lt;br /&gt;
