le-block-link" href="javascript:;">+&nbsp;X</a></div> <div class="collapsible-block-unfolded" style="display:none"> <div class="collapsible-block-unfolded-link"><a class="collapsible-block-link" href="javascript:;">-&nbsp;隐藏里面的东西</a></div> <div class="collapsible-block-content"><a href="http://scp-wiki-cn.wdfiles.com/local--files/ryoma/3.jpg"><img src="http://scp-wiki-cn.wdfiles.com/local--resized-images/ryoma/3.jpg/medium.jpg" alt="3.jpg" class="image" /></a></div> </div> </div> <br /> <div class="collapsible-block"> <div class="collapsible-block-folded"><a class="collapsible-block-link" href="javascript:;">+&nbsp;X</a></div> <div class="collapsible-block-unfolded" style="display:none"> <div class="collapsible-block-unfolded-link"><a class="collapsible-block-link" href="javascript:;">-&nbsp;隐藏里面的东西</a></div> <div class="collapsible-block-content"><a href="http://scp-wiki-cn.wdfiles.com/local--files/ryoma/2.jpg"><img src="http://scp-wiki-cn.wdfiles.com/local--resized-images/ryoma/2.jpg/medium.jpg" alt="2.jpg" class="image" /></a></div> </div> </div> <br /> <div class="collapsible-block"> <div class="collapsible-block-folded"><a class="collapsible-block-link" href="javascript:;">+&nbsp;049</a></div> <div class="collapsible-block-unfolded" style="display:none"> <div class="collapsible-block-unfolded-link"><a class="collapsible-block-link" href="javascript:;">-&nbsp;隐藏里面的东西</a></div> <div class="collapsible-block-content"><a href="http://scp-wiki-cn.wdfiles.com/local--files/ryoma/1.jpg"><img src="http://scp-wiki-cn.wdfiles.com/local--resized-images/ryoma/1.jpg/medium.jpg" alt="1.jpg" class="image" /></a></div> </div> </div> <p>by <span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/ryomae" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=5239199&amp;amp;size=small&amp;amp;timestamp=1608753664" alt="RyomaE" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5239199)" /></a><a href="http://www.wikidot.com/user:info/ryomae" >RyomaE</a></span></p> 
