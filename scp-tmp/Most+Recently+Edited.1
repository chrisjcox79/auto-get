&lt;td&gt;E. MacCarthy&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-621803-3&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;3&lt;/a&gt;&lt;/sup&gt;&lt;/td&gt;
&lt;td&gt;&lt;span style=&quot;color: red&quot;&gt;&lt;strong&gt;拒绝&lt;/strong&gt;&lt;/span&gt;&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-621803-4&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;4&lt;/a&gt;&lt;/sup&gt;&lt;/td&gt;
