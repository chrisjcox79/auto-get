&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/shuuuu&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4490242&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609945049&quot; alt=&quot;SHUUUU&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4490242)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/shuuuu&quot;  &gt;SHUUUU&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
