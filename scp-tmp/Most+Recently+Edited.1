&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/eulenlau&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3948368&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609360892&quot; alt=&quot;EuleNLau&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3948368)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/eulenlau&quot;  &gt;EuleNLau&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
