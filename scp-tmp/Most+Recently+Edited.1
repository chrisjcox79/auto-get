&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/brucewu0463&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5526785&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609228934&quot; alt=&quot;BruceWu0463&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5526785)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/brucewu0463&quot;  &gt;BruceWu0463&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
