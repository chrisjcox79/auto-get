&lt;div style=&quot;text-align: center;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/amnesticization/hub_image.png&quot; alt=&quot;hub_image.png&quot; class=&quot;image&quot; /&gt;
&lt;hr /&gt;
&lt;p&gt;&lt;sub&gt;&lt;em&gt;现在，来吧，穿过这五条河，把你自己忘却吧。&lt;/em&gt;&lt;/sub&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;p&gt;&lt;strong&gt;可利用信息：&lt;/strong&gt;&lt;/p&gt;
&lt;ol&gt;
&lt;li&gt;&lt;strong&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-3484&quot;&gt;SCP-3484&lt;/a&gt;&lt;/strong&gt; (&amp;quot;失落的一块&amp;quot;) by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wrongjohnsilver&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2000367&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610092697&quot; alt=&quot;WrongJohnSilver&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2000367)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wrongjohnsilver&quot;  &gt;WrongJohnSilver&lt;/a&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-3848&quot;&gt;SCP-3848&lt;/a&gt;&lt;/strong&gt; (&amp;quot;不忘记才有历史&amp;quot;) by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cyantreuse&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5888483&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610092697&quot; alt=&quot;Cyantreuse&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5888483)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cyantreuse&quot;  &gt;Cyantreuse&lt;/a&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/excerpt-from-the-astrolabe-institute-journal&quot;&gt;星盘研究所期刊摘录&lt;/a&gt;&lt;/strong&gt; by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lordstonefish&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2527320&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610092697&quot; alt=&quot;LordStonefish&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2527320)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lordstonefish&quot;  &gt;LordStonefish&lt;/a&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;&lt;a href=&quot;http://scp-wiki-cn.wikidot.com/schulman-ny-programmable-mnestic-device-ac34d-nc77q-95dcs&quot;&gt;‘Schulman-NY的可编程记忆设备’(AC34D/NC77Q/95DCS)&lt;/a&gt;&lt;/strong&gt; by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wrongjohnsilver&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2000367&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610092697&quot; alt=&quot;WrongJohnSilver&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2000367)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wrongjohnsilver&quot;  &gt;WrongJohnSilver&lt;/a&gt;&lt;/span&gt; 和 &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cyantreuse&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5888483&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610092697&quot; alt=&quot;Cyantreuse&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5888483)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cyantreuse&quot;  &gt;Cyantreuse&lt;/a&gt;&lt;/span&gt;&lt;/li&gt;
