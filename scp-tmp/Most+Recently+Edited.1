&lt;p&gt;&lt;span style=&quot;font-family:华文楷体;font-size: 120%&quot;&gt;&lt;strong&gt;Borg/博格博士&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-family:华文楷体;font-size: 120%&quot;&gt;&lt;strong&gt;职务：&lt;/strong&gt;化学类异常收容专家，&lt;span style=&quot;text-decoration: line-through;&quot;&gt;决斗者&lt;/span&gt;，&lt;span style=&quot;text-decoration: line-through;&quot;&gt;被研究对象&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
