%9D%E3%81%86%E3%81%95%E3%81%8F.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E3%81%BF%E3%81%AA%E3%82%89%E3%81%84%E3%83%BB%E3%81%9D%E3%81%86%E3%81%95%E3%81%8F.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>创作学徒</strong></span></span><br /> <span style="font-size:85%;"><strong>发布5篇以上的SCP文档</strong></span></p> </div> <div class="left-grid"> <div class="image-container floatleft"><img src="http://scp-jp.wdfiles.com/local--files/hal-aki-achievement-badges/%E5%AE%9F%E7%B8%BE_%E7%89%A9%E7%90%86%E5%AD%A6%E8%80%85.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E7%89%A9%E7%90%86%E5%AD%A6%E8%80%85.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>物理学家</strong></span></span><br /> <span style="font-size:85%;"><strong>发布一篇评分20以上的、包含下列任一标签的SCP文档：反物理定律、反熵、电力、磁性、重力影响</strong></span></p> </div> <div class="right-grid"> <div class="image-container floatleft"><img src="http://scp-jp.wdfiles.com/local--files/hal-aki-achievement-badges/%E5%AE%9F%E7%B8%BE_%E6%97%85%E4%BA%BA.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E6%97%85%E4%BA%BA.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>旅行家</strong></span></span><br /> <span style="font-size:85%;"><strong>发布一篇评分20以上的、包含下列任一标签的SCP文档：时空、未来、超维度、地图、门径</strong></span></p> </div> <div class="left-grid"> <div class="image-container floatleft"><img src="http://scp-jp.wdfiles.com/local--files/hal-aki-achievement-badges/%E5%AE%9F%E7%B8%BE_%E3%83%8B%E3%83%A5%E3%83%BC%E3%83%88%E3%83%A9%E3%83%A9%E3%83%A9%E3%82%A4%E3%82%B9%E3%83%89.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E3%83%8B%E3%83%A5%E3%83%BC%E3%83%88%E3%83%A9%E3%83%A9%E3%83%A9%E3%82%A4%E3%82%B9%E3%83%89.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>无效攵攵攵化</strong></span></span><br /> <span style="font-size:85%;"><strong>发布一篇评分20以上、关于Neutralized级项目的SCP文档</strong></span></p> </div> <div class="right-grid"> <div class="image-container floatleft"><img src="http://scp-jp.wdfiles.com/local--files/hal-aki-achievement-badges/%E5%AE%9F%E7%B8%BE_%E5%A4%A9%E6%96%87%E5%AD%A6%E8%80%85.png" width="50" alt="%E5%AE%9F%E7%B8%BE_%E5%A4%A9%E6%96%87%E5%AD%A6%E8%80%85.png" class="image" /></div> <p><span style="font-size:120%;"><span style="color:#970118"><strong>天文学家</strong></span></span><br /> <span style="font-size:85%;"><strong>发布一篇评分20以上的、包含下列任一标签的SCP文档：星际、行星、卫星、恒星、月球</strong></span></p> </div> </div> <div id="wiki-tab-0-7" style="display:none"> <div style="text-align: center;"><img src="http://scp-wiki-cn.wikidot.com/local--files/never-try-to-eat-diamond-apple/%E8%A1%A8%E6%83%85%E5%8C%851" width="300px" alt="%E8%A1%A8%E6%83%85%E5%8C%851" class="image" /><br /> <br /> <img src="http://scp-wiki-cn.wikidot.com/local--files/never-try-to-eat-diamond-apple/%E8%A1%A8%E6%83%85%E5%8C%853" width="300px" alt="%E8%A1%A8%E6%83%85%E5%8C%853" class="image" /><br /> <br /> <img src="http://scp-wiki-cn.wikidot.com/local--files/never-try-to-eat-diamond-apple/%E8%A1%A8%E6%83%85%E5%8C%852" width="300px" alt="%E8%A1%A8%E6%83%85%E5%8C%852" class="image" /></div> </div> <div id="wiki-tab-0-8" style="display:none"> <div style="font-family:微软细黑 !important;"> <div class="collapsible-block"> <div class="collapsible-block-folded"><a class="collapsible-block-link" href="javascript:;">--&gt;讨论区动态</a></div> <div class="collapsible-block-unfolded" style="display:none"> <div class="collapsible-block-unfolded-link"><a class="collapsible-block-link" href="javascript:;">&lt;--收起</a></div> <div class="collapsible-block-content"> <div class="left_float"> <div style="padding:2px"> <h4><span>最热主题</span></h4> </div> </div> <div class="right_float"> <div style="padding:2px;"> <h4><span>最新主题</span></h4> </div> </div> <div style="clear:both; height: 0px; font-size: 1px"></div> </div> </div> </div> <div class="collapsible-block"> <div class="collapsible-block-folded"><a class="collapsible-block-link" href="javascript:;">--&gt;当月计分板</a></d