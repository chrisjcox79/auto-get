&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/keyest&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7027379&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609556214&quot; alt=&quot;Keyest&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7027379)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/keyest&quot;  &gt;Keyest&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
