&lt;div style=&quot;text-align: center;&quot;&gt;&lt;/div&gt;
&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;br /&gt;&lt;/p&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;div style=&quot;background: url(http://scp-wiki.wdfiles.com/local--files/the-great-hippo/scp_trans.png) center no-repeat; float: center; border: solid 2px #000; padding: 1px 15px; box-shadow: 0 1px 3px rgba(0,0,0,.2);&quot;&gt;
&lt;p&gt;&lt;span style=&quot;color: #000000&quot;&gt;&lt;span style=&quot;font-size:150%;&quot;&gt;AtKinの作者頁&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;color: #ff5c48&quot;&gt;&lt;span style=&quot;font-size:100%;&quot;&gt;歡迎你，訪問者&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;h3&gt;&lt;span&gt;&lt;span style=&quot;text-decoration: underline;&quot;&gt;页面总览&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;

&lt;div id=&quot;wiki-tabview-47f1a7306ac1c811830008d8e2ca2bf9&quot; class=&quot;yui-navset&quot;&gt;
