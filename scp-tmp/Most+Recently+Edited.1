&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/etinjat&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4055881&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608753659&quot; alt=&quot;Etinjat&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4055881)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/etinjat&quot;  &gt;Etinjat&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
