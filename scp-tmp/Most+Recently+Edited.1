&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ssssssz&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4608911&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609769619&quot; alt=&quot;ssssssz&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4608911)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ssssssz&quot;  &gt;ssssssz&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
