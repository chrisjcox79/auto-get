&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/gazerpara&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2776812&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609511983&quot; alt=&quot;GazerPara&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2776812)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/gazerpara&quot;  &gt;GazerPara&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
