					<item>
				<guid>http://scp-wiki-cn.wikidot.com/log-of-anomalous-items-cn:00500</guid>
				<title>00500</title>
				<link>http://scp-wiki-cn.wikidot.com/log-of-anomalous-items-cn:00500</link>
