&lt;td&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ak1-yorunaga&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1745066&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609188753&quot; alt=&quot;ak1-yorunaga&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1745066)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ak1-yorunaga&quot;  &gt;ak1-yorunaga&lt;/a&gt;&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
