&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ora-spring&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4400843&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609511972&quot; alt=&quot;Ora_Spring&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4400843)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ora-spring&quot;  &gt;Ora_Spring&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
