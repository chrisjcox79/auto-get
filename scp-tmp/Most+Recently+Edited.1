				<title>SCP-CN-995</title>
				<link>http://scp-wiki-cn.wikidot.com/scp-cn-995</link>
				<description>


&lt;div class=&quot;creditRate&quot;&gt;
&lt;div class=&quot;rateBox&quot;&gt;
&lt;div class=&quot;rate-box-with-credit-button&quot;&gt;
&lt;div class=&quot;creditButton&quot;&gt;
&lt;p&gt;&lt;a class=&quot;fa fa-info&quot; href=&quot;#u-credit-view&quot;&gt;&lt;/a&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;div style=&quot;clear:both;&quot;&gt;&lt;/div&gt;
&lt;div id=&quot;u-credit-view&quot;&gt;
&lt;p&gt;[[div class=&amp;quot;fader&amp;quot;]]&lt;br /&gt;
&lt;iframe src=&quot;http://scp-wiki-cn.wikidot.com/credit:backmodule/code/1&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;&quot; width=&quot;&quot; class=&quot;&quot; style=&quot;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
&lt;/div&gt;
[[div class=&amp;quot;modalcontainer&amp;quot;]]&lt;br /&gt;
[[div class=&amp;quot;modalbox&amp;quot;]]&lt;br /&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;h2&gt;&lt;span&gt;著作信息&lt;/span&gt;&lt;/h2&gt;
&lt;/div&gt;
&lt;hr /&gt;
&lt;p&gt;[[div class=&amp;quot;credit first&amp;quot;]]&lt;br /&gt;
&lt;iframe src=&quot;http://scp-wiki-cn.wikidot.com/credit:backmodule/code/4&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;&quot; width=&quot;&quot; class=&quot;close-credits&quot; style=&quot;height:2em;margin: 0;padding: 0;border: 0;background: transparent;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/kcorena&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3396110&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609511979&quot; alt=&quot;Kcorena&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3396110)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/kcorena&quot;  &gt;Kcorena&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
