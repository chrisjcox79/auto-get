&lt;p&gt;&lt;span style=&quot;font-size:120%;&quot;&gt;&lt;span style=&quot;color:#970118&quot;&gt;&lt;strong&gt;大家一起来&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;br /&gt;
