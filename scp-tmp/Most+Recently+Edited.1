&lt;div class=&quot;collapsible-block-unfolded&quot; style=&quot;display:none&quot;&gt;
&lt;div class=&quot;collapsible-block-unfolded-link&quot;&gt;&lt;a class=&quot;collapsible-block-link&quot; href=&quot;javascript:;&quot;&gt;异常已清晰可见。&lt;/a&gt;&lt;/div&gt;
&lt;div class=&quot;collapsible-block-content&quot;&gt;
&lt;table class=&quot;wiki-content-table&quot;&gt;
&lt;tr&gt;
&lt;td&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/adult:scp-2182/xyMhZDC.png&quot; alt=&quot;xyMhZDC.png&quot; class=&quot;image&quot; /&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;
