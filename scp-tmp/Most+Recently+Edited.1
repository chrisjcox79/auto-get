&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div style=&quot;float:left; width: 45%; padding: 0 2%&quot;&gt;
&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;font-size:130%;&quot;&gt;&lt;strong&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://music.163.com/#/song?id=426291303&quot;&gt;Beyond&lt;/a&gt;&lt;/strong&gt;&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;color:red&quot;&gt;Triodust / Nicholas&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;font-size:130%;&quot;&gt;&lt;strong&gt;&lt;a target=&quot;_blank&quot; href=&quot;https://music.163.com/#/song?id=1403087372&quot;&gt;Gentle Madman&lt;/a&gt;&lt;/strong&gt;&lt;/span&gt;&lt;br /&gt;
