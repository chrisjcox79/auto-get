&lt;div style=&quot;float:right; margin:0 2em 1em 2em; width:300px; border:0;&quot;&gt;
&lt;table class=&quot;wiki-content-table&quot;&gt;
&lt;tr&gt;
&lt;td colspan=&quot;2&quot;&gt;&lt;img src=&quot;http://scpsandboxcn.wikidot.com/local--files/collab:invisible-clothes/IMG_PITU_20200213_172420.jpg&quot; width=&quot;300px&quot; alt=&quot;IMG_PITU_20200213_172420.jpg&quot; class=&quot;image&quot; /&gt;&lt;/td&gt;
