<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html id="html-block-html" xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"><head><meta http-equiv="Content-type" content="text/html; charset=utf-8"/><link rel="stylesheet" href="/common--theme/base/css/html-block.css"/></head><body>
<script type="text/javascript">
var request = false;
var target;
document.addEventListener("DOMContentLoaded",function(){
target = document.getElementById("target");

try{
var check = window.parent.window.userName;
request = true;
window.parent.window.userName.window.postMessage("request,1","*");
window.addEventListener("message",function(event){
window.parent.window.userName.window.postMessage("success,1","*");
if(!request)return;
target.style.display = "block";
target.getElementsByTagName("button")[0].setAttribute("onclick",'alert("已登录用户：' + event.data +'");');
request = false;

});
requestingUserName();
}catch(e){
target.style.display = "block";
target.getElementsByTagName("button")[0].setAttribute("onclick",'alert("未登录用户：访客");');

}

});

function requestingUserName(){
window.parent.window.userName.window.postMessage("request,1","*");
if(request)setTimeout(requestingUserName,50);
}

</script>
<div id="target" style="display:none;text-align:center;">
<button>点我一下，你就知道</button>
</div>
<script type="text/javascript" src="/common--javascript/html-block-iframe.js"></script></body></html>