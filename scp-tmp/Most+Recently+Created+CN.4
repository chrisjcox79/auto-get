&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wang-yiqing&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7183985&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610030107&quot; alt=&quot;Wang Yiqing&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7183985)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wang-yiqing&quot;  &gt;Wang Yiqing&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
