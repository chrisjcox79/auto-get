<div class="scp-image-block block-center" style="width:100%;"><img src="http://scpsandboxcn.wdfiles.com/local--files/sciencekiller3/cal-whut.png" style="width:100%;" alt="cal-whut.png" class="image" />
<div class="scp-image-caption" style="width:100%;">
