					由 <span class="printuser"><a href="http://www.wikidot.com/user:info/feitag" onclick="WIKIDOT.page.listeners.userInfo(4357011); return false;" >feitag</a></span>
					<a href="javascript:;" onclick="WIKIDOT.modules.ForumViewThreadModule.listeners.showHistory(event,4342689)"><i class="icon-plus"></i> 显示更多</a>
				</div>
				<div class="revisions" style="display: none"></div>
					
