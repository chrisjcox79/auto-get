&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/eximulator&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6675019&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608923884&quot; alt=&quot;Eximulator&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6675019)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/eximulator&quot;  &gt;Eximulator&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
