&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/bigpengpeng&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4859899&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606548354&quot; alt=&quot;bigpengpeng&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4859899)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/bigpengpeng&quot;  &gt;bigpengpeng&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
