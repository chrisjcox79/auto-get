&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-919157-2&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;2&lt;/a&gt;. [&lt;em&gt;优胜劣汰&lt;/em&gt;]&lt;/div&gt;
&lt;/div&gt;
