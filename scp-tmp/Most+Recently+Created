&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/vodka-wells&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5721026&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607133334&quot; alt=&quot;Vodka Wells&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5721026)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/vodka-wells&quot;  &gt;Vodka Wells&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
