&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/bitchangelover&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2995593&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609249318&quot; alt=&quot;bitchangelover&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2995593)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/bitchangelover&quot;  &gt;bitchangelover&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
