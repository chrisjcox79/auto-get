&lt;div class=&quot;credit first&quot;&gt;
&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki-cn.wikidot.com/credit:backmodule/code/4&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;&quot; width=&quot;&quot; class=&quot;close-credits&quot; style=&quot;height:2em;margin: 0;padding: 0;border: 0;background: transparent;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;标题：&lt;/strong&gt;SCP-2080-JP - 旧时的种子&lt;br /&gt;
&lt;strong&gt;作者：&lt;/strong&gt;©︎&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/nonsapereaude&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6762143&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608102651&quot; alt=&quot;NonSapereAude&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6762143)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/nonsapereaude&quot;  &gt;NonSapereAude&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;
