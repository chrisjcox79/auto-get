&lt;div class=&quot;colmod-link-top&quot;&gt;
&lt;div class=&quot;foldable-list-container&quot;&gt;&lt;span class=&quot;new-txt&quot;&gt;&lt;a href=&quot;javascript:;&quot;&gt;+ 需5级权限查看&lt;/a&gt;&lt;a href=&quot;javascript:;&quot;&gt;- 需5级权限查看&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;div class=&quot;colmod-content&quot;&gt;
&lt;div class=&quot;colmod-block&quot;&gt;
