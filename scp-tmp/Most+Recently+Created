&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/parabola-x&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6217553&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607651176&quot; alt=&quot;Parabola_X&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6217553)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/parabola-x&quot;  &gt;Parabola_X&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
