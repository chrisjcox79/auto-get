&lt;p&gt;&lt;span style=&quot;text-decoration: underline;&quot;&gt;&lt;strong&gt;实验 CN-1767-4&amp;#160;2020/██/██&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div class=&quot;blockquote&quot;&gt;
&lt;p&gt;&lt;strong&gt;代码：&lt;/strong&gt;&lt;/p&gt;
&lt;div class=&quot;code&quot;&gt;
&lt;pre&gt;
&lt;code&gt;#include &amp;quot;visualise.h&amp;quot;
#include &amp;lt;cstdio&amp;gt;
using namespace visualise;
typedef Graph&amp;lt;bool, int&amp;gt; G;
typedef G::Edge E;
