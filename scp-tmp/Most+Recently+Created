&lt;div style=&quot;margin-left: 1em;&quot;&gt;&lt;a href=&quot;#toc4&quot;&gt;4&lt;/a&gt;&lt;/div&gt;
&lt;div style=&quot;margin-left: 1em;&quot;&gt;&lt;a href=&quot;#toc5&quot;&gt;5&lt;/a&gt;&lt;/div&gt;
&lt;div style=&quot;margin-left: 1em;&quot;&gt;&lt;a href=&quot;#toc6&quot;&gt;6&lt;/a&gt;&lt;/div&gt;
