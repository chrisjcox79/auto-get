&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/gelsemiumelegans&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4314081&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605963692&quot; alt=&quot;gelsemiumelegans&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4314081)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/gelsemiumelegans&quot;  &gt;gelsemiumelegans&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
