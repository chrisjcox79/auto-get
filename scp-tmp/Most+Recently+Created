&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mendel-dreemurr&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6764430&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607326395&quot; alt=&quot;Mendel Dreemurr&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6764430)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mendel-dreemurr&quot;  &gt;Mendel Dreemurr&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
