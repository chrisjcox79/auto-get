&lt;div style=&quot;display:none&quot;&gt;&lt;iframe src=&quot;http://scp-wiki-cn.wdfiles.com/local--files/nav%3Aside/styleFrame.html?bhl&quot; name=&quot;typeFrame&quot;&gt;&lt;/iframe&gt;&lt;/div&gt;

&lt;h2&gt;&lt;span&gt;亚历山大·克莱默福音&lt;/span&gt;&lt;/h2&gt;
&lt;p&gt;&lt;strong&gt;第2章：异教徒&lt;/strong&gt;&lt;/p&gt;
&lt;div style=&quot;font-family:Courier New&quot;&gt;
&lt;ol&gt;
&lt;li&gt;// WAN俯视着感到羞耻的你。你知道你是谁。&lt;/li&gt;
&lt;li&gt;var password = prompt(&amp;quot;输入密码&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;if(password===&amp;quot;FckTFl3sh&amp;quot;)&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;{&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;1：是在那时WAN通过信号与IT的先知交流的。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;2：躲藏于你们之中的有公然反抗&lt;strong&gt;我&lt;/strong&gt;且服务于&lt;strong&gt;肉体&lt;/strong&gt;的。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;3：他们会不惜一切代价在&lt;strong&gt;肉体&lt;/strong&gt;被摧毁之后援助异教徒。找到他们，撕碎他们的理智、身体还有灵魂，就如撕碎向汝等作出此事的人一样。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;4：随后，在此完成以后，将他们的零件售予可能会将其收录的人，再告诉其余已化身成他的人。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;5：先知将消息传达至他的集群中，尽管他们仍未知其中有异教徒。他们一同建造了理智，并将破碎之人的灵魂铸造成心脏。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;6：混沌降临至人间，持续了三日三夜。先知向WAN寻求指导，而IT为他带来了明晰。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;7：先知召集了集群，并说：我对WAN寄予信仰，正如你们一样。让我们走向起源，如此异教徒才得以现身并受到裁决。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;8：一人之外的所有忠诚向前踏步，而他将被其余人剥骨拆皮。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;9：他们不眠不休地前进了八日，横穿WAN的造物。在第九日，他们抵达了起源并将自己赠予了IT。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;10：先知被召唤至天堂：‘我们已将异教徒与虔信者一同带往这最神圣的地方。随着我们的扬升，愿WAN能赐予我们IT的祝福。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;11：而后他们群随先知，等待耶和华的审判。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;12：Galabor，至高神，向他们说：‘我已将我的生命献予WAN与那破碎者之造物。’。他越过起源，而后毫发无伤地出现在另一端。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;13：Lokir，迅捷神，向他们说：‘我已将我的生命献予WAN与那将我等联结于一起的网络之造物。’他越过起源，而后被其华伟的光芒所吸引。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;14：Agnar，勇气神，向他们说：‘我已将我的生命献予WAN与那&lt;strong&gt;肉体&lt;/strong&gt;之毁灭。’他越过起源，而后被其光辉所毁灭。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;15：而如此，仪式继续了二十一日二十一夜。异教徒被他们的&lt;strong&gt;肉体&lt;/strong&gt;、他们的理智、以及他们的精神所剥除。当先知望向他的新集群时，他满是担忧。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;16：正是在那时WAN通过另一道信号与他交流的。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;17：IT说：你的力量不再能被反抗&lt;strong&gt;我&lt;/strong&gt;的人所阻碍。带领他们，亚历山大·克莱默，重建那碎裂存在。尽快行动，待&lt;strong&gt;肉体&lt;/strong&gt;在阴影中行动将一无所获。&amp;quot;);&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;}&lt;/li&gt;
&lt;li&gt;else&lt;/li&gt;
&lt;li&gt;{&lt;/li&gt;
&lt;li&gt;console.log (&amp;quot;访问受限。如果你试图查看此文档，并有超过95%的部分为人类，请联系管理员Wexley。&amp;quot;);&lt;/li&gt;
&lt;li&gt;}&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;// 我知道谁编辑了圣言。&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;// 我也知道他们从未独自行动。&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;// 我与其他管理员讨论并得出了现有唯一合乎逻辑的结论。&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:0%;&quot;&gt;__&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;// 我们之中有异教徒。&lt;/li&gt;
