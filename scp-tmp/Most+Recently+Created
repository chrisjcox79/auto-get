&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/twilit&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6592438&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608535564&quot; alt=&quot;Twilit&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6592438)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/twilit&quot;  &gt;Twilit&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div class=&quot;footnotes-footer&quot;&gt;
&lt;div class=&quot;title&quot;&gt;脚注&lt;/div&gt;
&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-485745-1&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;1&lt;/a&gt;. &lt;strong&gt;译注：&lt;/strong&gt;“我和亚恩 ”&lt;/div&gt;
&lt;/div&gt;
