&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/san-chen&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6908163&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608102649&quot; alt=&quot;San Chen&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6908163)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/san-chen&quot;  &gt;San Chen&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
