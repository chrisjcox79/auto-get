&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/carter-lu&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6331978&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607196337&quot; alt=&quot;carter lu&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6331978)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/carter-lu&quot;  &gt;carter lu&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
