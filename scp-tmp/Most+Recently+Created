&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/arthur-luixter&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6600944&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607152402&quot; alt=&quot;Arthur Luixter&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6600944)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/arthur-luixter&quot;  &gt;Arthur Luixter&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
