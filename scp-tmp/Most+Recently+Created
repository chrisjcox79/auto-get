&lt;p&gt;&amp;#171; &lt;a class=&quot;newpage&quot; href=&quot;http://scp-wiki-cn.wikidot.com/scp-cn-249-j&quot;&gt;SCP-CN-249-J&lt;/a&gt; | SCP-CN-250-J | &lt;a class=&quot;newpage&quot; href=&quot;http://scp-wiki-cn.wikidot.com/scp-cn-251-j&quot;&gt;SCP-CN-251-J&lt;/a&gt; &amp;#187;&lt;/p&gt;
