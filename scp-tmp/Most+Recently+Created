&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/zcar-s&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3416395&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608038131&quot; alt=&quot;zcar_s&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3416395)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/zcar-s&quot;  &gt;zcar_s&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
