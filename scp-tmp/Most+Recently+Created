&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lan-muda&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6898801&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606442247&quot; alt=&quot;lan_muda&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6898801)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lan-muda&quot;  &gt;lan_muda&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
