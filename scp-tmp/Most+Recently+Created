&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/feitag&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4357011&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607238467&quot; alt=&quot;feitag&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4357011)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/feitag&quot;  &gt;feitag&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
