&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/modern-hunter&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3994327&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609467174&quot; alt=&quot;Modern Hunter&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3994327)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/modern-hunter&quot;  &gt;Modern Hunter&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
