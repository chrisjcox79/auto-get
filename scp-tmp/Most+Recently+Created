&lt;div class=&quot;class1&quot;&gt;
&lt;div class=&quot;level-text&quot;&gt;&lt;span class=&quot;base 级 CN&quot;&gt;3/5607&lt;/span&gt; 级 &lt;span class=&quot;base 级 CN&quot;&gt;3/5607&lt;/span&gt;&lt;/div&gt;
