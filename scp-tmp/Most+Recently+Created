&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tunardine777&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2290522&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609940618&quot; alt=&quot;Tunardine777&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2290522)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tunardine777&quot;  &gt;Tunardine777&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
