&lt;strong&gt;绘制：&lt;/strong&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/soya-001&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2577572&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609356847&quot; alt=&quot;SOYA-001&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2577572)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/soya-001&quot;  &gt;SOYA-001&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;
&lt;strong&gt;译者：&lt;/strong&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/backlight-sh&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5374263&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609356847&quot; alt=&quot;Backlight SH&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5374263)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/backlight-sh&quot;  &gt;Backlight SH&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;
