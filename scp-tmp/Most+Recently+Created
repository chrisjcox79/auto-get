&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&amp;#171; &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-cn-1775&quot;&gt;SCP-CN-1775&lt;/a&gt; | SCP-CN-1776 | &lt;a href=&quot;http://scp-wiki-cn.wikidot.com/scp-cn-1777&quot;&gt;SCP-CN-1777&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mendel-dreemurr&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6764430&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607413168&quot; alt=&quot;Mendel Dreemurr&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6764430)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mendel-dreemurr&quot;  &gt;Mendel Dreemurr&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
