&lt;blockquote&gt;
&lt;p&gt;&lt;span style=&quot;font-size:20px;&quot;&gt;Я пробуждаюсь&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;font-size:12px;&quot;&gt;我 已 醒 来&lt;/span&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;blockquote&gt;
&lt;p&gt;&lt;span style=&quot;font-size:20px;&quot;&gt;Не спрятаться&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;font-size:12px;&quot;&gt;无 人 可 逃&lt;/span&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;blockquote&gt;
&lt;p&gt;&lt;span style=&quot;font-size:20px;&quot;&gt;Только смерть&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;font-size:12px;&quot;&gt;惟 有 死 亡&lt;/span&gt;&lt;/p&gt;
&lt;/blockquote&gt;
&lt;/div&gt;
