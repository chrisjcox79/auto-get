&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ahshow&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1418801&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609226295&quot; alt=&quot;ahshow&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1418801)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ahshow&quot;  &gt;ahshow&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
