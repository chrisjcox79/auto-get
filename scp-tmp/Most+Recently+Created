&lt;div class=&quot;collapsible-block-content&quot;&gt;
&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:315px;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/welcome-to-delta-t/attie-dossier.jpg&quot; style=&quot;width:315px;&quot; alt=&quot;attie-dossier.jpg&quot; class=&quot;image&quot; /&gt;
&lt;div class=&quot;scp-image-caption&quot; style=&quot;width:315px;&quot;&gt;
