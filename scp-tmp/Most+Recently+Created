&lt;td&gt;&lt;span style=&quot;color: red&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;全体员工,&amp;#32;overwatch.command@scp.int&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;th style=&quot;text-align:right&quot;&gt;&lt;strong&gt;主题:&lt;/strong&gt;&lt;/th&gt;
&lt;td&gt;Re:¡Felices fiestas!&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-510234-1&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;1&lt;/a&gt;&lt;/sup&gt;&lt;/td&gt;
&lt;/tr&gt;
