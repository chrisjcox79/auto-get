/* ---- ANIMATION ---- */
 @keyframes clock-spin{
     0%, 15%{
         transform: rotate(0deg);
    }
     25%, 40%{
         transform: rotate(90deg);
    }
     50%, 65%{
         transform: rotate(180deg);
    }
     75%, 90%{
         transform: rotate(270deg);
    }
     100%{
         transform: rotate(360deg);
    }
}
 @keyframes cont-spin{
     from{
         transform: rotate(0deg);
    }
     to{
         transform: rotate(360deg);
    }
}

/* ---- MOBILE ANIMATION ---- */
 @media (max-width: 767px){
     #header{
         background: none !important;
    }
     #header #header-extra-div-1,
     #header #header-extra-div-2, 
     #header #header-extra-div-3{
         width: 5rem !important;
         height: 5rem !important;
         left: 0.7rem !important;
         top: 0.5rem !important;
    }
     #header #header-extra-div-1::before,
     #header #header-extra-div-2::before,
     #header #header-extra-div-3::before{
         width: 6.5rem !important;
         height: 6.5rem !important;
    }
}
</style>
<style>
@import url('https://fonts.googleapis.com/css?family=Noto+Sans+SC|Noto+Serif+SC|Noto+Sans+TC|Noto+Serif+TC&amp;display=swap');

body {
    font-family: 'Noto Serif SC', 'Noto Serif TC';
}
#page-content tt {
font-family: 'Noto Serif SC',verdana,arial,helvetica,sans-serif;
}

#page-title {
display: none;
}

.box-one {
    border: none;
    padding: 5px 10px 5px 10px;
}

.box-one:hover{
 box-shadow: 0px 4px 10px 0 rgba(0, 0, 0, 0.19);
 transition: box-shadow 0.5s ease-out;
}

/* Grid layout */

.left-grid {
    float: left;
    width: 49%;
    height: 110px;
}
.right-grid {
    float: right;
    width: 49%;
    height: 110px;
}

/* Mobile Media Query */
@media (max-width: 479px) { 
.left-grid,
.right-grid {
    width: 100%;
    float: left;
}
}

/* Note Media Query */
@media (min-width: 480px) and (max-width: 580px) { 
.left-grid,
.right-grid {
    width: 100%;
    float: left;
}
}

/* Tablet Media Query */
@media (min-width: 768px) and (max-width: 979px) {
.left-grid,
.right-grid {
    width: 100%;
    float: left;
}
}

/*ADD BY TWILIT*/

#who-rated-page-area::before {
content: " ↓ 和善的朋友们 ↓ ";
color: #000000;
}

#who-rated-page-area::after {
content: " ↑ 和善的朋友们 ↑ ";
color: #000000;
}
