</div>
<p style="text-align: center;"><strong><span style="color: black">CN-1392</span></strong></p>
<p><span style="white-space: pre-wrap;">&#32;</span><br />
<span style="white-space: pre-wrap;">&#32;</span></p>
</div>
<hr />



<div class="anom-bar-container item-CN-1392 clear-2 --safe-- neutralized {$secondary-class} {$disruption-class} {$risk-class} {$american} lang-cn">
<div class="anom-bar">
<div class="top-box">
<div class="top-left-box"><span class="item"><span class="lang-cn">项目编号：</span><span class="lang-tr">項目編號：</span></span><span class="number">CN-1392</span></div>
<div class="top-center-box">
<div class="bar-one"></div>
<div class="bar-two"></div>
<div class="bar-three"></div>
<div class="bar-four"></div>
<div class="bar-five"></div>
<div class="bar-six"></div>
</div>
<div class="top-right-box">
<div class="level"><span class="lang-cn">等级</span><span class="lang-tr">等級</span>2</div>
<div class="clearance"></div>
</div>
</div>
<div class="bottom-box">
<div class="text-part">
<div class="main-class">
<div class="contain-class">
<div class="class-category"><span class="lang-cn">收容等级：</span><span class="lang-tr">收容等級：</span></div>
