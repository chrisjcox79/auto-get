&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/garcia-li123&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3851038&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609487829&quot; alt=&quot;GARCIA_Li123&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3851038)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/garcia-li123&quot;  &gt;GARCIA_Li123&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
