&lt;p&gt;&lt;strong&gt;作者：&lt;/strong&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mendel-dreemurr&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6764430&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608386530&quot; alt=&quot;Mendel Dreemurr&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6764430)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mendel-dreemurr&quot;  &gt;Mendel Dreemurr&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;
&lt;br /&gt;
&lt;strong&gt;发布日期：&lt;/strong&gt;2020年12月15日&lt;/p&gt;
&lt;div class=&quot;credit-back&quot; style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki.wdfiles.com/local--code/info%3Astyle/2&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;no&quot; width=&quot;&quot; class=&quot;&quot; style=&quot;height:2em;width: 100%;margin: 0;padding: 0;border: 0;background: transparent;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
