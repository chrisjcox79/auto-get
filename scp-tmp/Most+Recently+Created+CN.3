				<guid>http://scp-wiki-cn.wikidot.com/scp-cn-1782</guid>
				<title>SCP-CN-1782</title>
				<link>http://scp-wiki-cn.wikidot.com/scp-cn-1782</link>
				<description>


&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lin-da-0616&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7146526&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609077976&quot; alt=&quot;Lin-da-0616&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7146526)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lin-da-0616&quot;  &gt;Lin-da-0616&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
