					<item>
				<guid>http://scp-wiki-cn.wikidot.com/scp-cn-1782</guid>
				<title>SCP-CN-1782</title>
				<link>http://scp-wiki-cn.wikidot.com/scp-cn-1782</link>
				<description>

&lt;div style=&quot;text-align: right;&quot;&gt;&lt;/div&gt;

&lt;div class=&quot;anom-bar-container item-CN-1782 clear-2 keter none keneq 警告 {$american} lang-cn&quot;&gt;
&lt;div class=&quot;anom-bar&quot;&gt;
&lt;div class=&quot;top-box&quot;&gt;
