&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/virgil-n&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5661227&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607674465&quot; alt=&quot;Virgil_N&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5661227)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/virgil-n&quot;  &gt;Virgil_N&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
