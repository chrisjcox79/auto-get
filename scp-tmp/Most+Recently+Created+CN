&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/redstone-dave&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6100463&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606182981&quot; alt=&quot;Redstone Dave&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6100463)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/redstone-dave&quot;  &gt;Redstone Dave&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
