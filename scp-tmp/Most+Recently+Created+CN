&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;blockquote&gt;
&lt;h1&gt;&lt;span&gt;&lt;strong&gt;警告&lt;/strong&gt;&lt;/span&gt;&lt;/h1&gt;
