				<title>Totsuka Saika副部长的独呜：简单易懂的梦神集团</title>
				<link>http://scp-wiki-cn.wikidot.com/goc-oneiroi</link>
				<description>


&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki-cn.wdfiles.com/local--files/nav%3Aside/styleFrame.html?bhl&quot; style=&quot;display: none;&quot; name=&quot;typeFrame&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;

&lt;div style=&quot;text-align: right;&quot;&gt;&lt;/div&gt;
&lt;div style=&quot;background: url(/local--files/experimental-2-no-tocar/archivelogobackground.png) center top no-repeat ; float: center; border: grey 4px; width: 370px; padding: 5px; margin: 10px; background-color: light gray; box-shadow: 2px 2px 2px 2px rgba(0,0,0,.1);&quot;&gt;&lt;span style=&quot;float:left; margin-left:5px; margin-top:0px; background-color: #ffffff; padding: 0px 10px;&quot;&gt;&lt;br /&gt;
&lt;img src=&quot;http://scp-wiki-cn.wikidot.com/local--files/goc-oneiroi/Totsuka%20Saika&quot; width=&quot;50px&quot; alt=&quot;Totsuka%20Saika&quot; class=&quot;image&quot; /&gt;&lt;br /&gt;&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;font-size:1.5em;&quot;&gt;&lt;span style=&quot;color: grey&quot;&gt;全超联的摆设加陷阱 @Totsuka Saika&lt;/span&gt;&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;font-size:2em;&quot;&gt;&lt;span style=&quot;color: black&quot;&gt;欢迎你们，无论你们是谁。&lt;/span&gt;&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;
&lt;ul&gt;
&lt;li&gt;&lt;span style=&quot;font-size:.8em;&quot;&gt;&lt;span style=&quot;color: grey&quot;&gt;转鸣&lt;/span&gt;&lt;/span&gt; &lt;span style=&quot;font-size:1.1em;&quot;&gt;&lt;span style=&quot;color: purple&quot;&gt;？？&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;li&gt;&lt;span style=&quot;font-size:.8em;&quot;&gt;&lt;span style=&quot;color: grey&quot;&gt;点赞&lt;/span&gt;&lt;/span&gt; &lt;span style=&quot;font-size:1.1em;&quot;&gt;&lt;span style=&quot;color: purple&quot;&gt;？？&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
