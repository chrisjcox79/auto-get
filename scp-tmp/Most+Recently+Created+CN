&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/blackinblack&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6344250&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608260258&quot; alt=&quot;blackinblack&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6344250)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/blackinblack&quot;  &gt;blackinblack&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
