&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki-cn.wdfiles.com/local--files/nav%3Aside/styleFrame.html?bhl&quot; style=&quot;display: none;&quot; name=&quot;styleFrame&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wupaispanda&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5223229&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606029225&quot; alt=&quot;Wupaispanda&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5223229)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wupaispanda&quot;  &gt;Wupaispanda&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
