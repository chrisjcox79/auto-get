&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/confucian-lee&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6591621&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606528292&quot; alt=&quot;Confucian Lee&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6591621)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/confucian-lee&quot;  &gt;Confucian Lee&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
