&lt;td style=&quot;text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:80%;&quot;&gt;MTF Observer-05“圣水”&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
