&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki.wdfiles.com/local--code/info%3Astyle/3&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;&quot; width=&quot;&quot; class=&quot;close-credits&quot; style=&quot;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;SCP-CN-1698：金条有腿&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;作者：&lt;/strong&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/kcorena&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3396110&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606850616&quot; alt=&quot;Kcorena&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3396110)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/kcorena&quot;  &gt;Kcorena&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
