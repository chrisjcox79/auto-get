&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/peter-vapour&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6946135&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605943404&quot; alt=&quot;Peter Vapour&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6946135)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/peter-vapour&quot;  &gt;Peter Vapour&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
