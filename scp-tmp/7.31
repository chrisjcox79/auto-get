<style>
.circle-1{
width: 250px;
height: 250px;
background: #CCC;
position: relative;
border-radius: 50%;
text-align: center;
margin-left: auto;
margin-right: auto;
margin-bottom: 1em;
}

.circle-1.circle-left{
display: inline-block;
float: left;
margin: 0 2em 1em 2em;
}

.circle-1.circle-right{
display: inline-block;
float: right;
margin: 0 2em 1em 2em;
}

@media (max-width: 768px) {
.circle-1.circle-clear{
display: block;
float: none;
clear: both;
margin-left: auto;
margin-right: auto;
}
}

.circle-1 .line-box .line,
.circle-1 .graph-box .graph{
position: absolute;
left: 0;
right: 0;
margin: 0 auto;
width: 2px;
height: 50%;
background: #888;
transform-origin: 50% 100%;
}

.circle-1 .scale-box .scale{
position: absolute;
left: 0;
right: 0;
top: 0;
bottom: 0;
margin: auto auto;
border-radius: 50%;
box-sizing: border-box;
border: solid 2px #888;
}

.circle-1 .scale-box div.scale{
display: none;
}
.circle-1 .scale-box div.scale:nth-of-type(-n+5){
display: block;
}

.circle-1 .line-box div.line:nth-of-type(2),
.circle-1 .graph-box div.graph:nth-of-type(2){
transform: rotate(calc(360deg / 6 * 1));
}
.circle-1 .line-box div.line:nth-of-type(3),
.circle-1 .graph-box div.graph:nth-of-type(3){
transform: rotate(calc(360deg / 6 * 2));
}
.circle-1 .line-box div.line:nth-of-type(4),
.circle-1 .graph-box div.graph:nth-of-type(4){
transform: rotate(calc(360deg / 6* 3));
}
.circle-1 .line-box div.line:nth-of-type(5),
.circle-1 .graph-box div.graph:nth-of-type(5){
transform: rotate(calc(360deg / 6 * 4));
}
.circle-1 .line-box div.line:nth-of-type(6),
.circle-1 .graph-box div.graph:nth-of-type(6){
transform: rotate(calc(360deg / 6 * 5));
}

.circle-1 .scale-box div.scale:nth-of-type(1){
width: calc(100% / 5 * 1);
height: calc(100% / 5 * 1);
}
.circle-1 .scale-box div.scale:nth-of-type(2){
width: calc(100% / 5 * 2);
height: calc(100% / 5 * 2);
}
.circle-1 .scale-box div.scale:nth-of-type(3){
width: calc(100% / 5 * 3);
height: calc(100% / 5 * 3);
}
.circle-1 .scale-box div.scale:nth-of-type(4){
width: calc(100% / 5 * 4);
height: calc(100% / 5 * 4);
}

.circle-1 .scale-box div.scale:nth-of-type(5){
width: calc(100% / 5 * 5);
height: calc(100% / 5 * 5);
}
.circle-1 .scale-box div.scale:nth-of-type(6){
width: calc(100% / 5 * 6);
height: calc(100% / 5 * 6);
}
.circle-1 .scale-box div.scale:nth-of-type(7){
width: calc(100% / 5 * 7);
height: calc(100% / 5 * 7);
}
.circle-1 .scale-box div.scale:nth-of-type(8){
width: calc(100% / 5 * 8);
height: calc(100% / 5 * 8);
}
.circle-1 .scale-box div.scale:nth-of-type(9){
width: calc(100% / 5 * 9);
height: calc(100% / 5 * 9);
}
.circle-1 .scale-box div.scale:nth-of-type(10){
width: calc(100% / 5 * 10);
height: calc(100% / 5 * 10);
}

.circle-1 .graph-box div.graph::after{
content: "";
position: absolute;
left: 1px;
bottom: 0;
width: 0;
height: 0;
transform-origin: 0 100%;
transform: skewY(-30deg);
border-style: solid;
border-color: transparent transparent transparent orange;
}

.circle-1 .graph-box div.graph:nth-of-type(1)::after{
border-width: calc(250px / 100 * 70 / 2) 0 0 calc(250px / 100 * 50 / 2 / 2 * 1.7320508);
}
.circle-1 .graph-box div.graph:nth-of-type(2)::after{
border-width: calc(250px / 100 * 50 / 2) 0 0 calc(250px / 100 * 60 / 2 / 2 * 1.7320508);
}
.circle-1 .graph-box div.graph:nth-of-type(3)::after{
border-width: calc(250px / 100 * 60 / 2) 0 0 calc(250px / 100 * 50 / 2 / 2 * 1.7320508);
}
.circle-1 .graph-box div.graph:nth-of-type(4)::after{
border-width: calc(250px / 100 * 50 / 2) 0 0 calc(250px / 100 * 50 / 2 / 2 * 1.7320508);
}
.circle-1 .graph-box div.graph:nth-of-type(5)::after{
border-width: calc(250px / 100 * 50 / 2) 0 0 calc(250px / 100 * 70 / 2 / 2 * 1.7320508);
}
.circle-1 .graph-box div.graph:nth-of-type(6)::after{
border-width: calc(250px / 100 * 70 / 2) 0 0 calc(250px / 100 * 70 / 2 / 2 * 1.7320508);
}

.circle-1 .label-box .label{
display: inline-block;
position: absolute;
left: 0;
right: 0;
font-weight: 900;
transform-origin: 50% calc(250px / 2);
}

.circle-1 .label-box .label:nth-of-type(2){
transform: rotate(60deg);
}
.circle-1 .label-box .label:nth-of-type(3){
transform: rotate(120deg);
}
.circle-1 .label-box .label:nth-of-type(4){
transform: rotate(180deg);
}
.circle-1 .label-box .label:nth-of-type(5){
transform: rotate(240deg);
}
.circle-1 .label-box .label:nth-of-type(6){
transform: rotate(300deg);
}

.circle-1 .label-box .label p{
display: inline-block;
margin:0;
}

.circle-1 .label-box .label:nth-of-type(2) p{
transform: rotate(-60deg);
}
.circle-1 .label-box .label:nth-of-type(3) p{
transform: rotate(-120deg);
}
.circle-1 .label-box .label:nth-of-type(4) p{
transform: rotate(-180deg);
}
.circle-1 .label-box .label:nth-of-type(5) p{
transform: rotate(-240deg);
}
.circle-1 .label-box .label:nth-of-type(6) p{
transform: rotate(-300deg);
}

.circle-1.sushi .label-box .label{
color: black;
text-shadow:1px 1px 1px white,-1px 1px 1px white,1px -1px 1px white,-1px -1px 1px white;
}
</style>
