<div class="cover-info">
<div class="cover-tagline">{$tagline}</div>
<div class="page-info">
<div>+5 · 0 讨论数</div>
<div><span class="odate time_1603596920 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">25 Oct 2020 03:35</span></div>
</div>
</div>
</div>
<div class="table">
<table class="wiki-content-table">
<tr>
<th>页面名称</th>
<td><a href="/component:pages">报纸、书页和便利贴</a></td>
