<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html id="html-block-html" xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"><head><meta http-equiv="Content-type" content="text/html; charset=utf-8"/><link rel="stylesheet" href="/common--theme/base/css/html-block.css"/></head><body>
<script language="javascript">
    window.onload = function () {
        var direction = Math.ceil(Math.random() * 360);
        var h = Math.random() * 10;
        h = h - Math.random()*4;
        h = Math.floor(h * 100) / 100;
        compass.style.transform = 'rotate(' + direction + 'deg)';
        height.innerHTML = h ;
    };

</script>
<body>
    <div style="text-align: center;">
        <img src="http://scp-wiki-cn.wikidot.com/local--files/wanderers:travellers-book-the-tower/compass.png" style="margin: 0 auto;width:200px;" alt="" class="image" id="compass" />
        <p id="height" style="text-align:center; font-family:'Segoe Script', cursive ;color:#584B00;"> </p>
    </div>
<body>
<script type="text/javascript" src="/common--javascript/html-block-iframe.js"></script></body></html>