					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/sebarus" onclick="WIKIDOT.page.listeners.userInfo(2341265); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2341265&amp;amp;size=small&amp;amp;timestamp=1606834437" alt="Sebarus" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2341265)"/></a><a href="http://www.wikidot.com/user:info/sebarus" onclick="WIKIDOT.page.listeners.userInfo(2341265); return false;" >Sebarus</a></span> <span class="odate time_1583887825 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">11 Mar 2020 00:50</span>
														</div>
