				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/yellowislol" onclick="WIKIDOT.page.listeners.userInfo(6284593); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6284593&amp;amp;size=small&amp;amp;timestamp=1607871262" alt="YellowISlol" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6284593)"/></a><a href="http://www.wikidot.com/user:info/yellowislol" onclick="WIKIDOT.page.listeners.userInfo(6284593); return false;" >YellowISlol</a></span> <span class="odate time_1607834748 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">13 Dec 2020 04:45</span>
