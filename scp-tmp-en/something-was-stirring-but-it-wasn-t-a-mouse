					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/ethanhanson" onclick="WIKIDOT.page.listeners.userInfo(4465845); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=4465845&amp;amp;size=small&amp;amp;timestamp=1605856757" alt="EthanHanson" style="background-image:url(http://www.wikidot.com/userkarma.php?u=4465845)"/></a><a href="http://www.wikidot.com/user:info/ethanhanson" onclick="WIKIDOT.page.listeners.userInfo(4465845); return false;" >EthanHanson</a></span> <span class="odate time_1604466981 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">04 Nov 2020 05:16</span>
														</div>
