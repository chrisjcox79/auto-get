				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/dr-blankvoid" onclick="WIKIDOT.page.listeners.userInfo(7031662); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7031662&amp;amp;size=small&amp;amp;timestamp=1606400356" alt="Dr Blankvoid" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7031662)"/></a><a href="http://www.wikidot.com/user:info/dr-blankvoid" onclick="WIKIDOT.page.listeners.userInfo(7031662); return false;" >Dr Blankvoid</a></span> <span class="odate time_1606376474 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">26 Nov 2020 07:41</span>
														</div>
