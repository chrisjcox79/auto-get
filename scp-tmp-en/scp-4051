								<div class="title" id="post-title-4076178">
																		
															</div>
				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/shaggydredlocks" onclick="WIKIDOT.page.listeners.userInfo(1722371); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1722371&amp;amp;size=small&amp;amp;timestamp=1608238180" alt="Shaggydredlocks" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1722371)"/></a><a href="http://www.wikidot.com/user:info/shaggydredlocks" onclick="WIKIDOT.page.listeners.userInfo(1722371); return false;" >Shaggydredlocks</a></span> <span class="odate time_1543960427 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">04 Dec 2018 21:53</span>
