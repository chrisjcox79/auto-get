					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/fredex" onclick="WIKIDOT.page.listeners.userInfo(5544969); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=5544969&amp;amp;size=small&amp;amp;timestamp=1608780593" alt="FredEx" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5544969)"/></a><a href="http://www.wikidot.com/user:info/fredex" onclick="WIKIDOT.page.listeners.userInfo(5544969); return false;" >FredEx</a></span> <span class="odate time_1608695363 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">23 Dec 2020 03:49</span>
