					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/daliesque" onclick="WIKIDOT.page.listeners.userInfo(7043295); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7043295&amp;amp;size=small&amp;amp;timestamp=1606078127" alt="Daliesque" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7043295)"/></a><a href="http://www.wikidot.com/user:info/daliesque" onclick="WIKIDOT.page.listeners.userInfo(7043295); return false;" >Daliesque</a></span> <span class="odate time_1606044817 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">22 Nov 2020 11:33</span>
