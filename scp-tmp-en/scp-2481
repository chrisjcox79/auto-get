					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/sunnyclockwork" onclick="WIKIDOT.page.listeners.userInfo(1621343); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1621343&amp;amp;size=small&amp;amp;timestamp=1607916406" alt="SunnyClockwork" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1621343)"/></a><a href="http://www.wikidot.com/user:info/sunnyclockwork" onclick="WIKIDOT.page.listeners.userInfo(1621343); return false;" >SunnyClockwork</a></span> <span class="odate time_1463165452 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">13 May 2016 18:50</span>
														</div>
