				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/rockteethmotheyes" onclick="WIKIDOT.page.listeners.userInfo(4022320); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=4022320&amp;amp;size=small&amp;amp;timestamp=1606380092" alt="RockTeethMothEyes" style="background-image:url(http://www.wikidot.com/userkarma.php?u=4022320)"/></a><a href="http://www.wikidot.com/user:info/rockteethmotheyes" onclick="WIKIDOT.page.listeners.userInfo(4022320); return false;" >RockTeethMothEyes</a></span> <span class="odate time_1578550490 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">09 Jan 2020 06:14</span>
														</div>
