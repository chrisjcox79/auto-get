					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/henzoid" onclick="WIKIDOT.page.listeners.userInfo(5190300); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=5190300&amp;amp;size=small&amp;amp;timestamp=1607200703" alt="Henzoid" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5190300)"/></a><a href="http://www.wikidot.com/user:info/henzoid" onclick="WIKIDOT.page.listeners.userInfo(5190300); return false;" >Henzoid</a></span> <span class="odate time_1568004953 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">09 Sep 2019 04:55</span>
														</div>
