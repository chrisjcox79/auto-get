				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/inertia-comrade" onclick="WIKIDOT.page.listeners.userInfo(6474512); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6474512&amp;amp;size=small&amp;amp;timestamp=1609209651" alt="Inertia_comrade" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6474512)"/></a><a href="http://www.wikidot.com/user:info/inertia-comrade" onclick="WIKIDOT.page.listeners.userInfo(6474512); return false;" >Inertia_comrade</a></span> <span class="odate time_1609201210 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">29 Dec 2020 00:20</span>
