					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/lw-b9" onclick="WIKIDOT.page.listeners.userInfo(7078010); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7078010&amp;amp;size=small&amp;amp;timestamp=1607566680" alt="LW-B9" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7078010)"/></a><a href="http://www.wikidot.com/user:info/lw-b9" onclick="WIKIDOT.page.listeners.userInfo(7078010); return false;" >LW-B9</a></span> <span class="odate time_1607560189 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">10 Dec 2020 00:29</span>
