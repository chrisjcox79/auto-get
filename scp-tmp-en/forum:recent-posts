					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/b-b-king" onclick="WIKIDOT.page.listeners.userInfo(6711814); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6711814&amp;amp;size=small&amp;amp;timestamp=1606851823" alt="B B King" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6711814)"/></a><a href="http://www.wikidot.com/user:info/b-b-king" onclick="WIKIDOT.page.listeners.userInfo(6711814); return false;" >B B King</a></span> <span class="odate time_1606850351 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">01 Dec 2020 19:19</span>
