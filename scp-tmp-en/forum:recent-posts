									</div>
				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/sputnik-one" onclick="WIKIDOT.page.listeners.userInfo(7005588); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7005588&amp;amp;size=small&amp;amp;timestamp=1607780391" alt="Sputnik One" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7005588)"/></a><a href="http://www.wikidot.com/user:info/sputnik-one" onclick="WIKIDOT.page.listeners.userInfo(7005588); return false;" >Sputnik One</a></span> <span class="odate time_1607768079 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">12 Dec 2020 10:14</span>
