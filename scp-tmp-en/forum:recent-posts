				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/riemann" onclick="WIKIDOT.page.listeners.userInfo(1787775); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1787775&amp;amp;size=small&amp;amp;timestamp=1607110086" alt="Riemann" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1787775)"/></a><a href="http://www.wikidot.com/user:info/riemann" onclick="WIKIDOT.page.listeners.userInfo(1787775); return false;" >Riemann</a></span> <span class="odate time_1607105087 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">04 Dec 2020 18:04</span>
