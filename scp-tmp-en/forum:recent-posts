				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/damass" onclick="WIKIDOT.page.listeners.userInfo(7032143); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7032143&amp;amp;size=small&amp;amp;timestamp=1605880135" alt="damass" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7032143)"/></a><a href="http://www.wikidot.com/user:info/damass" onclick="WIKIDOT.page.listeners.userInfo(7032143); return false;" >damass</a></span> <span class="odate time_1605879318 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">20 Nov 2020 13:35</span>
