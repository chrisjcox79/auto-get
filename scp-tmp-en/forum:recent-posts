					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/doctor-cheese" onclick="WIKIDOT.page.listeners.userInfo(6525339); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6525339&amp;amp;size=small&amp;amp;timestamp=1607456367" alt="Doctor Cheese" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6525339)"/></a><a href="http://www.wikidot.com/user:info/doctor-cheese" onclick="WIKIDOT.page.listeners.userInfo(6525339); return false;" >Doctor Cheese</a></span> <span class="odate time_1607455312 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">08 Dec 2020 19:21</span>
