					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/doctor-mendenhall" onclick="WIKIDOT.page.listeners.userInfo(7092016); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7092016&amp;amp;size=small&amp;amp;timestamp=1608234127" alt="Doctor Mendenhall" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7092016)"/></a><a href="http://www.wikidot.com/user:info/doctor-mendenhall" onclick="WIKIDOT.page.listeners.userInfo(7092016); return false;" >Doctor Mendenhall</a></span> <span class="odate time_1608228746 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">17 Dec 2020 18:12</span>
