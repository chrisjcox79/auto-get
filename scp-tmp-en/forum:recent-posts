				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/dankaar" onclick="WIKIDOT.page.listeners.userInfo(1790336); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1790336&amp;amp;size=small&amp;amp;timestamp=1606010965" alt="dankaar" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1790336)"/></a><a href="http://www.wikidot.com/user:info/dankaar" onclick="WIKIDOT.page.listeners.userInfo(1790336); return false;" >dankaar</a></span> <span class="odate time_1606010365 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">22 Nov 2020 01:59</span>
																	<br/>
