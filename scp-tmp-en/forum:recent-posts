				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/miragecoordinator" onclick="WIKIDOT.page.listeners.userInfo(7157684); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7157684&amp;amp;size=small&amp;amp;timestamp=1608690253" alt="miragecoordinator" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7157684)"/></a><a href="http://www.wikidot.com/user:info/miragecoordinator" onclick="WIKIDOT.page.listeners.userInfo(7157684); return false;" >miragecoordinator</a></span> <span class="odate time_1608690249 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">23 Dec 2020 02:24</span>
																	<br/>
