					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/omomon64" onclick="WIKIDOT.page.listeners.userInfo(7134227); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7134227&amp;amp;size=small&amp;amp;timestamp=1609055496" alt="omomon64" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7134227)"/></a><a href="http://www.wikidot.com/user:info/omomon64" onclick="WIKIDOT.page.listeners.userInfo(7134227); return false;" >omomon64</a></span> <span class="odate time_1609048431 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">27 Dec 2020 05:53</span>
