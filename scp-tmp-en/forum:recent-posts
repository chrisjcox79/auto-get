				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/dr-jacob-adams" onclick="WIKIDOT.page.listeners.userInfo(6085668); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6085668&amp;amp;size=small&amp;amp;timestamp=1609209651" alt="Dr Jacob Adams" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6085668)"/></a><a href="http://www.wikidot.com/user:info/dr-jacob-adams" onclick="WIKIDOT.page.listeners.userInfo(6085668); return false;" >Dr Jacob Adams</a></span> <span class="odate time_1609202297 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">29 Dec 2020 00:38</span>
