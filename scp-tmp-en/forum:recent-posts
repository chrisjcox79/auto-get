				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/sir-piecemaker" onclick="WIKIDOT.page.listeners.userInfo(7100466); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7100466&amp;amp;size=small&amp;amp;timestamp=1608990438" alt="Sir Piecemaker" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7100466)"/></a><a href="http://www.wikidot.com/user:info/sir-piecemaker" onclick="WIKIDOT.page.listeners.userInfo(7100466); return false;" >Sir Piecemaker</a></span> <span class="odate time_1608988602 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">26 Dec 2020 13:16</span>
