					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/zyn" onclick="WIKIDOT.page.listeners.userInfo(1404533); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1404533&amp;amp;size=small&amp;amp;timestamp=1607154255" alt="Zyn" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1404533)"/></a><a href="http://www.wikidot.com/user:info/zyn" onclick="WIKIDOT.page.listeners.userInfo(1404533); return false;" >Zyn</a></span> <span class="odate time_1607149896 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">05 Dec 2020 06:31</span>
																	<br/>
