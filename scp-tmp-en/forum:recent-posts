				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/thealienbaby" onclick="WIKIDOT.page.listeners.userInfo(4874276); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=4874276&amp;amp;size=small&amp;amp;timestamp=1606397539" alt="TheAlienBaby" style="background-image:url(http://www.wikidot.com/userkarma.php?u=4874276)"/></a><a href="http://www.wikidot.com/user:info/thealienbaby" onclick="WIKIDOT.page.listeners.userInfo(4874276); return false;" >TheAlienBaby</a></span> <span class="odate time_1606382823 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">26 Nov 2020 09:27</span>
