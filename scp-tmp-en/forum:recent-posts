				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/breakerbreaker" onclick="WIKIDOT.page.listeners.userInfo(6980097); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6980097&amp;amp;size=small&amp;amp;timestamp=1609098171" alt="BreakerBreaker" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6980097)"/></a><a href="http://www.wikidot.com/user:info/breakerbreaker" onclick="WIKIDOT.page.listeners.userInfo(6980097); return false;" >BreakerBreaker</a></span> <span class="odate time_1609097606 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">27 Dec 2020 19:33</span>
