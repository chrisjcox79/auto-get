					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/jamaisj" onclick="WIKIDOT.page.listeners.userInfo(6846344); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6846344&amp;amp;size=small&amp;amp;timestamp=1607394278" alt="JamaisJ" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6846344)"/></a><a href="http://www.wikidot.com/user:info/jamaisj" onclick="WIKIDOT.page.listeners.userInfo(6846344); return false;" >JamaisJ</a></span> <span class="odate time_1607388640 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">08 Dec 2020 00:50</span>
