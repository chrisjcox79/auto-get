					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/deathbygin" onclick="WIKIDOT.page.listeners.userInfo(5229982); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=5229982&amp;amp;size=small&amp;amp;timestamp=1605900850" alt="deathbygin" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5229982)"/></a><a href="http://www.wikidot.com/user:info/deathbygin" onclick="WIKIDOT.page.listeners.userInfo(5229982); return false;" >deathbygin</a></span> <span class="odate time_1605898383 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">20 Nov 2020 18:53</span>
