				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/veralta" onclick="WIKIDOT.page.listeners.userInfo(6030962); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6030962&amp;amp;size=small&amp;amp;timestamp=1609336971" alt="Veralta" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6030962)"/></a><a href="http://www.wikidot.com/user:info/veralta" onclick="WIKIDOT.page.listeners.userInfo(6030962); return false;" >Veralta</a></span> <span class="odate time_1609327662 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">30 Dec 2020 11:27</span>
