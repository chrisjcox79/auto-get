					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/darkstuff" onclick="WIKIDOT.page.listeners.userInfo(1581620); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1581620&amp;amp;size=small&amp;amp;timestamp=1609359178" alt="DarkStuff" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1581620)"/></a><a href="http://www.wikidot.com/user:info/darkstuff" onclick="WIKIDOT.page.listeners.userInfo(1581620); return false;" >DarkStuff</a></span> <span class="odate time_1609357326 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">30 Dec 2020 19:42</span>
