				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/redesert" onclick="WIKIDOT.page.listeners.userInfo(6380468); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6380468&amp;amp;size=small&amp;amp;timestamp=1609833015" alt="REDESERT" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6380468)"/></a><a href="http://www.wikidot.com/user:info/redesert" onclick="WIKIDOT.page.listeners.userInfo(6380468); return false;" >REDESERT</a></span> <span class="odate time_1609827587 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">05 Jan 2021 06:19</span>
