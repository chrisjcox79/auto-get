					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/lesh" onclick="WIKIDOT.page.listeners.userInfo(1432306); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1432306&amp;amp;size=small&amp;amp;timestamp=1606447554" alt="Lesh" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1432306)"/></a><a href="http://www.wikidot.com/user:info/lesh" onclick="WIKIDOT.page.listeners.userInfo(1432306); return false;" >Lesh</a></span> <span class="odate time_1436603900 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">11 Jul 2015 08:38</span>
