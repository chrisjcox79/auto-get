				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/blackvvater" onclick="WIKIDOT.page.listeners.userInfo(7113942); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7113942&amp;amp;size=small&amp;amp;timestamp=1608972703" alt="Blackvvater" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7113942)"/></a><a href="http://www.wikidot.com/user:info/blackvvater" onclick="WIKIDOT.page.listeners.userInfo(7113942); return false;" >Blackvvater</a></span> <span class="odate time_1608666294 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">22 Dec 2020 19:44</span>
														</div>
