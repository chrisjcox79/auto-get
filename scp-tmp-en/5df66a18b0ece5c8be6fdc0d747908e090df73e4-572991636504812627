<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html id="html-block-html" xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"><head><meta http-equiv="Content-type" content="text/html; charset=utf-8"/><link rel="stylesheet" href="/common--theme/base/css/html-block.css"/></head><body>
<head>
    <style>
        @import url("https://use.typekit.net/rit0pba.css");

        :root {
            --body-font: proxima-nova,sans-serif;
            --base-font-size: 0.9375rem;
            --base-line-height: 1.313rem;
            --pale-gray-monochrome: 244,244,244;
            --light-gray-monochrome: 160,160,160;
            --black-monochrome: 12,12,12;
            --pale-accent: 230,40,60;
            --dark-accent:100,3,15;
            --swatch-primary-darkest:var(--dark-accent);
            --swatch-text-dark: var(--black-monochrome);
            --swatch-menubg-light-color: var(--pale-gray-monochrome);
            --swatch-menubg-black-color: var(--black-monochrome);
            --swatch-menubg-medium-color: var(--light-gray-monochrome);
            --swatch-border-color: var(--black-monochrome);
            --link-color: var(--pale-accent);
        }

        body {
            -moz-font-feature-settings: "lnum","kern","clig","calt";
            -moz-hyphens: manual;
            font-family: Lato,sans-serif;
            font-family: var(--body-font);
            font-feature-settings: "lnum","kern","clig","calt";
            font-kerning: auto;
            font-size: .875rem;
            font-size: var(--base-font-size);
            font-variant-numeric: normal;
            font-weight: 500;
            hyphens: manual;
            word-break: normal;
            color: rgb(var(--swatch-text-dark));
            font-variant-ligatures: none;
            line-height: 1.5;
        }

        embed, iframe, img, object, table, video {
            max-width: 100%;
        }

        a, a.newpage {
            background: rgba(0,0,0,0);
            text-decoration: none;
        }

        a {
            color: #b42323;
            color: rgb(var(--link-color));
        }

        blockquote, div.blockquote {
            --box-shadow: rgba(var(--swatch-menubg-black-color),0.1);
            -webkit-box-shadow: 0 .063em .125em rgba(0,0,0,.1);
            -moz-box-shadow: 0 .063em .125em rgba(0,0,0,.1);
            -webkit-box-shadow: 0 .063em .125em var(--box-shadow);
            -moz-box-shadow: 0 .063em .125em var(--box-shadow);
            display: block;
            margin: .5em 40px;
            box-shadow: 0 .063em .125em rgba(0,0,0,.1);
            box-shadow: 0 .063em .125em var(--box-shadow);
            border: .063em dashed rgba(var(--swatch-border-color),.25);
            background-color: #f4f4f4;
            background-color: rgb(var(--swatch-menubg-light-color));
            padding: 0 1em;
        }

        .scp-image-block.block-right {
            --box-shadow: rgba(var(--swatch-menubg-black-color,12,12,12));
            float: right;
            clear: right;
            margin: 0 0 1em 2em;
            min-width: 30%;
            -webkit-box-shadow: 0 .0625rem .375rem rgba(0,0,0,.25);
            -moz-box-shadow: 0 .0625rem .375rem rgba(0,0,0,.25);
            -moz-box-shadow: 0 .0625rem .375rem var(--box-shadow);
            -webkit-box-shadow: 0 .0625rem .375rem var(--box-shadow);
            -webkit-box-orient: vertical;
            -webkit-box-direction: normal;
            -webkit-flex-flow: column nowrap;
            -moz-box-orient: vertical;
            -moz-box-direction: normal;
            -ms-flex-flow: column nowrap;
            -webkit-box-align: center;
            -webkit-align-items: center;
            -moz-box-align: center;
            -ms-flex-align: center;
            display: -webkit-box;
            display: -webkit-flex;
            display: -moz-box;
            display: -ms-flexbox;
            display: flex;
            flex-flow: column nowrap;
            align-items: center;
            box-shadow: 0 .0625rem .375rem rgba(0,0,0,.25);
            box-shadow: 0 .0625rem .375rem var(--box-shadow);
            border: .0625rem solid rgb(var(--swatch-primary-darkest));
        }

        .scp-image-block img[style*="width:"] {
            width: 100% !important;
        }

        .scp-image-block img {
            border: 0;
            min-width: 100%;
        }

        .scp-image-block .scp-image-caption {
            border-top: .0625rem solid #0c0c0c;
            border-top: .0625rem solid rgb(var(--swatch-menubg-black-color));
            background-color: #f4f4f4;
            background-color: rgb(var(--swatch-menubg-light-color));
            padding: .125rem 0;
            font-size: 80%;
            font-weight: 700;
            letter-spacing: .016em;
            text-align: center;
        }

        .scp-image-caption {
            min-width: 100%;
        }

        .scp-image-block .scp-image-caption > p {
            margin: 0;
            padding: 0 .625rem;
        }

        hr {
            display: block;
            margin: 1em 0;
            border: 0;
                border-top-color: currentcolor;
                border-top-style: none;
                border-top-width: 0px;
            border-top: .063rem solid #424248;
            border-top: .063rem solid rgba(var(--swatch-menubg-medium-color,66,66,72));
            padding: 0;
            height: .063rem;
        }

        @media only screen and (max-width:685px) {
            body > div {
                font-size:.9em
            }

            div {
                clear: both;
            }

            .scp-image-block.block-right {
                max-width: 40vw !important;
            }

            .scp-image-block img[style*="width:"] {
                width: 100% !important;
            }

            .blockquote, .curved, blockquote {
                margin: 0;
            }
        }

    </style>
</head>
