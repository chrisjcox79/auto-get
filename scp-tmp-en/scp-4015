				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/higans" onclick="WIKIDOT.page.listeners.userInfo(1592386); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1592386&amp;amp;size=small&amp;amp;timestamp=1606834484" alt="higans" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1592386)"/></a><a href="http://www.wikidot.com/user:info/higans" onclick="WIKIDOT.page.listeners.userInfo(1592386); return false;" >higans</a></span> <span class="odate time_1531810957 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">17 Jul 2018 07:02</span>
														</div>
