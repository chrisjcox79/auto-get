				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/dolphinslugchugger" onclick="WIKIDOT.page.listeners.userInfo(1969477); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1969477&amp;amp;size=small&amp;amp;timestamp=1606380126" alt="DolphinSlugchugger" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1969477)"/></a><a href="http://www.wikidot.com/user:info/dolphinslugchugger" onclick="WIKIDOT.page.listeners.userInfo(1969477); return false;" >DolphinSlugchugger</a></span> <span class="odate time_1546725266 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">05 Jan 2019 21:54</span>
