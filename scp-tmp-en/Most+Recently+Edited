&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/anactualcrow&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6040770&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608647167&quot; alt=&quot;AnActualCrow&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6040770)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/anactualcrow&quot;  &gt;AnActualCrow&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
