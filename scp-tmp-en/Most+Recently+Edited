&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/a-lad&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3584476&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607395806&quot; alt=&quot;A_Lad&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3584476)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/a-lad&quot;  &gt;A_Lad&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
