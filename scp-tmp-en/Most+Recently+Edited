&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&amp;#171; &lt;a href=&quot;http://www.scpwiki.com/scp-3098&quot;&gt;SCP-3098&lt;/a&gt; | SCP-3099 | &lt;a href=&quot;http://www.scpwiki.com/scp-3100&quot;&gt;SCP-3100&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/minmin&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=560062&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607416347&quot; alt=&quot;minmin&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=560062)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/minmin&quot;  &gt;minmin&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
