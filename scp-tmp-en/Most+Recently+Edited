&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/a-random-day&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1841781&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606963619&quot; alt=&quot;A Random Day&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1841781)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/a-random-day&quot;  &gt;A Random Day&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
