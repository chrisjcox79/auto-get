- &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/stephlynch&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1802367&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608647155&quot; alt=&quot;stephlynch&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1802367)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/stephlynch&quot;  &gt;stephlynch&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
