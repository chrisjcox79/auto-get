&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/proasek&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2048131&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609384704&quot; alt=&quot;Proasek&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2048131)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/proasek&quot;  &gt;Proasek&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
