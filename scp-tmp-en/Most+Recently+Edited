&lt;/div&gt;
&lt;div class=&quot;blockquote&quot; style=&quot;margin-bottom: 2em;&quot;&gt;
&lt;p&gt;&lt;strong&gt;|&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&amp;#32;&amp;#32;&lt;/span&gt;Finding SCiPNET results for &amp;quot;&lt;em&gt;lucian-saxe&lt;/em&gt;&amp;quot;&amp;#8230;&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;|&lt;/strong&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&amp;#32;&amp;#32;&lt;/span&gt;$&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;|&lt;/strong&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&amp;#32;&amp;#32;&lt;/span&gt;&lt;em&gt;0 results.&lt;/em&gt;&lt;/p&gt;
