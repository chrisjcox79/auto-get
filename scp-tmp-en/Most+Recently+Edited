&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/calibri-bold&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5045819&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606810742&quot; alt=&quot;Calibri Bold&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5045819)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/calibri-bold&quot;  &gt;Calibri Bold&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
