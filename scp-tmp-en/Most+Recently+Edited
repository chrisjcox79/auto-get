&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:75%;&quot;&gt;&lt;strong&gt;&lt;em&gt;The ACT&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;a href=&quot;http://www.scpwiki.com/goc-act-hub&quot;&gt;Hub&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;« &lt;a href=&quot;http://www.scpwiki.com/alto-clef-jr-fire-and-flames&quot;&gt;Agent Pocket Ukulele Through the Fire and Flames&lt;/a&gt; | &lt;a href=&quot;https://www.youtube.com/watch?v=aNyK6EcHlzM&quot;&gt;The Hotel California Presents: Ecce Farcio&lt;/a&gt; | &lt;a href=&quot;http://www.scpwiki.com/alto-clef-jr-the-joker&quot;&gt;Some People Call Me the Goose Cowboy&lt;/a&gt; »&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dolphinslugchugger&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1969477&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608755084&quot; alt=&quot;DolphinSlugchugger&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1969477)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dolphinslugchugger&quot;  &gt;DolphinSlugchugger&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
