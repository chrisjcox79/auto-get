				<description>

&lt;div style=&quot;text-align: right;&quot;&gt;&lt;/div&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:xx-large;&quot;&gt;Hello Welcome&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;hr /&gt;
&lt;div class=&quot;image-container aligncenter&quot;&gt;&lt;img src=&quot;http://scp-sandbox-3.wdfiles.com/local--files/ananomalouswriter/welcome.png&quot; width=&quot;200px&quot; alt=&quot;welcome.png&quot; class=&quot;image&quot; /&gt;&lt;/div&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:large;&quot;&gt;All of the work posted here are wallpapers feel free to use them :)&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div class=&quot;collapsible-block&quot;&gt;
&lt;div class=&quot;collapsible-block-folded&quot;&gt;&lt;span style=&quot;font-size:xx-large;&quot;&gt;&lt;a class=&quot;collapsible-block-link&quot; href=&quot;javascript:;&quot;&gt;3D&amp;nbsp;Wallpapers&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div class=&quot;collapsible-block-unfolded&quot; style=&quot;display:none&quot;&gt;
&lt;div class=&quot;collapsible-block-unfolded-link&quot;&gt;&lt;span style=&quot;font-size:xx-large;&quot;&gt;&lt;a class=&quot;collapsible-block-link&quot; href=&quot;javascript:;&quot;&gt;&amp;nbsp;sɹǝdɐdllɐM&amp;nbsp;uoǝN&amp;nbsp;pƐ&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div class=&quot;collapsible-block-content&quot;&gt;
&lt;div class=&quot;scp-image-block block-center&quot; style=&quot;width:550px;&quot;&gt;&lt;img src=&quot;http://scp-sandbox-3.wikidot.com/local--files/ananomalouswriter/neon%20multi%20color%20v3.jpg&quot; style=&quot;width:550px;&quot; alt=&quot;neon%20multi%20color%20v3.jpg&quot; class=&quot;image&quot; /&gt;
&lt;div class=&quot;scp-image-caption&quot; style=&quot;width:550px;&quot;&gt;
&lt;p&gt;Multi Color Variant&lt;/p&gt;
