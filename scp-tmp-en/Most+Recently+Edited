&lt;td&gt;&lt;strong&gt;&lt;span style=&quot;color: green&quot;&gt;ACCEPT&lt;/span&gt;&lt;/strong&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;
