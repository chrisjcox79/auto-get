				<description>


&lt;div style=&quot;text-align: right;&quot;&gt;&lt;/div&gt;
&lt;div class=&quot;danke agent&quot;&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:200%;&quot;&gt;PROPERTY OF &lt;span style=&quot;color: red&quot;&gt;&lt;strong&gt;THE SCP FOUNDATION&lt;/strong&gt;&lt;/span&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;br /&gt;
&lt;br /&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;&lt;img src=&quot;https://upload.wikimedia.org/wikipedia/commons/thumb/e/ec/SCP_Foundation_%28emblem%29.svg/200px-SCP_Foundation_%28emblem%29.svg.png&quot; style=&quot;filter: invert(1)&quot; alt=&quot;200px-SCP_Foundation_%28emblem%29.svg.png&quot; class=&quot;image&quot; /&gt;&lt;/div&gt;
&lt;br /&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:200%;&quot;&gt;&lt;span style=&quot;color: red&quot;&gt;Secure. Contain. Protect.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;br /&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:150%;&quot;&gt;YOU ARE CURRENTLY ACCESSING INFORMATION RELATED TO FOUNDATION AGENT: &lt;span class=&quot;printuser&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/jakdragonx&quot;  &gt;JakdragonX&lt;/a&gt;&lt;/span&gt;. ANY ATTEMPTS TO ACQUIRE THIS INFORMATION WITHOUT THE PROPER CLEARANCE WILL BE LOGGED AND TRACKED. YOU HAVE BEEN WARNED.&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;

&lt;p&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;br /&gt;
&lt;strong&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;gt;&lt;/span&gt; &lt;tt&gt;Retrieving and compiling available data related to the queried user from online Foundation databases&amp;#8230;&lt;/tt&gt;&lt;/strong&gt;&lt;br /&gt;
&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;br /&gt;&lt;/p&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:135%;&quot;&gt;&lt;strong&gt;&lt;tt&gt;SCP ARTICLES:&lt;/tt&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;

