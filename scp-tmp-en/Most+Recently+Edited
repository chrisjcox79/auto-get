&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size:20%;&quot;&gt;Yes this is the official appearance of -4871. Fight me.&lt;/span&gt;&lt;/p&gt;
&lt;div class=&quot;scp-image-block block-center&quot; style=&quot;width:400px;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/krona-midaeus-personnel-file/SkorptArt&quot; style=&quot;width:400px;&quot; alt=&quot;SkorptArt&quot; class=&quot;image&quot; /&gt;
&lt;div class=&quot;scp-image-caption&quot; style=&quot;width:400px;&quot;&gt;
&lt;p&gt;SCP-4871 looking annoyed, by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/skorpt&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6392851&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606508045&quot; alt=&quot;Skorpt&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6392851)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/skorpt&quot;  &gt;Skorpt&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
