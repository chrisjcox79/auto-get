&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/harvoable&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7005588&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606680455&quot; alt=&quot;Harvoable &quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7005588)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/harvoable&quot;  &gt;Harvoable&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
