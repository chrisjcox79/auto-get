&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/gishface&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2314483&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606746174&quot; alt=&quot;gishface&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2314483)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/gishface&quot;  &gt;gishface&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
