&lt;li&gt;&lt;span style=&quot;color: #767676; font-size: 80%;&quot;&gt;HUMS&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;vactivity&quot; style=&quot;font-size: 110%;&quot;&gt;2.1k&lt;/span&gt;&lt;/li&gt;
