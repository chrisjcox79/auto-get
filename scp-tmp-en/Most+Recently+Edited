&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sebarus&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2341265&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607890585&quot; alt=&quot;Sebarus&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2341265)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sebarus&quot;  &gt;Sebarus&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
