&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/natakilar&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3219757&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606810748&quot; alt=&quot;NataKilar&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3219757)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/natakilar&quot;  &gt;NataKilar&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
