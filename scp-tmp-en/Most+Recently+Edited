&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/djkaktus&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1888434&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606810749&quot; alt=&quot;djkaktus&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1888434)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/djkaktus&quot;  &gt;djkaktus&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
