				<title>SCP-5420</title>
				<link>http://www.scpwiki.com/scp-5420</link>
				<description>


&lt;div style=&quot;text-align: right;&quot;&gt;&lt;/div&gt;
&lt;hr /&gt;
&lt;table style=&quot;border: none; width: 100%;&quot;&gt;
&lt;tr&gt;
&lt;td&gt;&lt;span style=&quot;font-size:125%;&quot;&gt;&lt;strong&gt;Item #:&lt;/strong&gt; SCP-5420&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;text-align: right;&quot;&gt;&lt;span style=&quot;font-size:125%;&quot;&gt;&lt;span style=&quot;color: #990000&quot;&gt;&lt;strong&gt;Level 2/5420&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
