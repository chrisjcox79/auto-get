&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;color: red&quot;&gt;&lt;strong&gt;Verifying Access&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
