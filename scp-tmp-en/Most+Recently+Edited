&lt;td style=&quot;border-right: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:80%;&quot;&gt;Dr. Imogene Stewart&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:80%;&quot;&gt;Pi-6 (&amp;quot;Clown Wranglers&amp;quot;)&lt;/span&gt;&lt;/td&gt;
