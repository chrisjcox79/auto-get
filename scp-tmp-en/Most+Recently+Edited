&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/natvoltaic&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2800867&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609556998&quot; alt=&quot;NatVoltaic&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2800867)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/natvoltaic&quot;  &gt;NatVoltaic&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
