&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-solo&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1476008&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606185839&quot; alt=&quot;Dr Solo&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1476008)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-solo&quot;  &gt;Dr Solo&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
