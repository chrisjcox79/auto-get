&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/daviiid&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6403884&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607112304&quot; alt=&quot;daviiid&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6403884)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/daviiid&quot;  &gt;daviiid&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
