&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/rjb-r&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1229263&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607049802&quot; alt=&quot;RJB_R&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1229263)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/rjb-r&quot;  &gt;RJB_R&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
