&lt;div class=&quot;collapsible-block-content&quot;&gt;
&lt;table class=&quot;wiki-content-table&quot;&gt;
&lt;tr&gt;
&lt;td&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/scp-2182/xyMhZDC.png&quot; alt=&quot;xyMhZDC.png&quot; class=&quot;image&quot; /&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
