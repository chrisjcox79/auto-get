&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/daedalus-shank&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1324840&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609511799&quot; alt=&quot;Daedalus Shank&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1324840)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/daedalus-shank&quot;  &gt;Daedalus Shank&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
