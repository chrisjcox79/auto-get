&lt;td style=&quot;border-right: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:80%;&quot;&gt;T. Graham&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;border-right: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:80%;&quot;&gt;M. Lodge&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:80%;&quot;&gt;O-17&lt;/span&gt;&lt;/td&gt;
