&lt;h2&gt;&lt;span&gt;&lt;span style=&quot;color: black&quot;&gt;BY ORDER OF THE OVERSEER COUNCIL&lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;
&lt;p&gt;&lt;span style=&quot;color: black&quot;&gt;The following files are Level 5 classified. Unauthorized access is forbidden.&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;color: black&quot;&gt;4606&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
