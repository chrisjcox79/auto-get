&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/thenicestguy&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7097402&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607351681&quot; alt=&quot;TheNicestGuy&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7097402)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/thenicestguy&quot;  &gt;TheNicestGuy&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
