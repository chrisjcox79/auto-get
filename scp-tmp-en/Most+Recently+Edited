&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/oboebandgeek99&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1782920&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605860219&quot; alt=&quot;Oboebandgeek99&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1782920)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/oboebandgeek99&quot;  &gt;Oboebandgeek99&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
