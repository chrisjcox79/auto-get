&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/erazm&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2819735&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609557003&quot; alt=&quot;Erazm&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2819735)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/erazm&quot;  &gt;Erazm&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
