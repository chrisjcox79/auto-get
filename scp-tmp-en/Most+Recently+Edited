&lt;div class=&quot;image-container aligncenter&quot;&gt;&lt;img src=&quot;http://topia.wdfiles.com/local--files/drdog-test/wwslogo2shadow.png&quot; style=&quot;width:120px;&quot; alt=&quot;wwslogo2shadow.png&quot; class=&quot;image&quot; /&gt;&lt;/div&gt;
