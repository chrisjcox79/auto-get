&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/malycegraves&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4916887&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607222822&quot; alt=&quot;MalyceGraves&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4916887)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/malycegraves&quot;  &gt;MalyceGraves&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
