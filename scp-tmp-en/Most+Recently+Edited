&lt;div class=&quot;image-container floatleft&quot;&gt;&lt;a href=&quot;http://scp-wiki.wdfiles.com/local--files/goc-hub-page/GOC-Logo-v4.png&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--resized-images/goc-hub-page/GOC-Logo-v4.png/thumbnail.jpg&quot; alt=&quot;GOC-Logo-v4.png&quot; class=&quot;image&quot; /&gt;&lt;/a&gt;&lt;/div&gt;
