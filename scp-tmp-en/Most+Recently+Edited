&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/stormbreath&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3075960&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607049796&quot; alt=&quot;stormbreath&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3075960)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/stormbreath&quot;  &gt;stormbreath&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
