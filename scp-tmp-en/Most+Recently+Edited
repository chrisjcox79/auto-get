&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/trombus&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3230616&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610052005&quot; alt=&quot;Trombus&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3230616)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/trombus&quot;  &gt;Trombus&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
