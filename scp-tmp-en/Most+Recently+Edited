&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/duccy-boi&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7059423&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607309826&quot; alt=&quot;Duccy boi&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7059423)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/duccy-boi&quot;  &gt;Duccy boi&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
