&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Atlas&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-43256-5&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;5&lt;/a&gt;&lt;/sup&gt;&lt;/td&gt;
