&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dysadron&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4384469&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609989352&quot; alt=&quot;Dysadron&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4384469)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dysadron&quot;  &gt;Dysadron&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
