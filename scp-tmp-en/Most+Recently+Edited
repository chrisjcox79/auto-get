&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/kalinin&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2203795&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606421157&quot; alt=&quot;Kalinin&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2203795)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/kalinin&quot;  &gt;Kalinin&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
