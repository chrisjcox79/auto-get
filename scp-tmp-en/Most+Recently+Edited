&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cold-nights&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6781818&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608149446&quot; alt=&quot;cold_Nights&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6781818)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cold-nights&quot;  &gt;cold_Nights&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
