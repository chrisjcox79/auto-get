&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/psul&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2156983&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606400320&quot; alt=&quot;psul&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2156983)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/psul&quot;  &gt;psul&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
