&lt;div class=&quot;top-left-box&quot;&gt;&lt;span class=&quot;item&quot;&gt;Item#:&lt;/span&gt; &lt;span class=&quot;number&quot;&gt;3140&lt;/span&gt;&lt;/div&gt;
