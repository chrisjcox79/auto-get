&lt;p&gt;&lt;span style=&quot;text-decoration: underline;&quot;&gt;&lt;em&gt;&lt;span style=&quot;color: green&quot;&gt;K. INADA&lt;/span&gt;&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
