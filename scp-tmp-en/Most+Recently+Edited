&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lasergoose&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=528027&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606108097&quot; alt=&quot;Lasergoose&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=528027)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lasergoose&quot;  &gt;Lasergoose&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
