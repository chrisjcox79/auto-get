&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/kinda-ander&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6887617&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610052002&quot; alt=&quot;Kinda Ander&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6887617)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/kinda-ander&quot;  &gt;Kinda Ander&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
