&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/deathbygin&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5229982&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606531202&quot; alt=&quot;deathbygin&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5229982)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/deathbygin&quot;  &gt;deathbygin&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
