&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:175px;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/this-page-intentionally-left-blank/Skippy.png&quot; title=&quot;Click and hold to enlarge.&quot; style=&quot;width:175px;&quot; class=&quot;fillpg&quot; alt=&quot;Skippy.png&quot; /&gt;
