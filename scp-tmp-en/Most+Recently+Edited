&lt;p&gt;&lt;span style=&quot;font-size:125%;&quot;&gt;&lt;strong&gt;Addendum 03:&lt;/strong&gt; Lancer II Recovery/After-Action&lt;/span&gt;&lt;/p&gt;
&lt;div style=&quot;border:solid 1px #e5ddb7; background:#f9efc2; padding:10px; margin-bottom: 10px; text-align: justify; font-family: &amp;quot;Courier New&amp;quot;, monospace;&quot;&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;div class=&quot;collapsible-block&quot;&gt;
&lt;div class=&quot;collapsible-block-folded&quot;&gt;&lt;span style=&quot;font-size:130%;&quot;&gt;&lt;a class=&quot;collapsible-block-link&quot; href=&quot;javascript:;&quot;&gt;«&amp;nbsp;Recovery&amp;nbsp;Log&amp;nbsp;»&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;
&lt;div class=&quot;collapsible-block-unfolded&quot; style=&quot;display:none&quot;&gt;
&lt;div class=&quot;collapsible-block-unfolded-link&quot;&gt;&lt;span style=&quot;font-size:130%;&quot;&gt;&lt;a class=&quot;collapsible-block-link&quot; href=&quot;javascript:;&quot;&gt;»&amp;nbsp;Recovery&amp;nbsp;Log&amp;nbsp;«&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;
