&lt;a href=&quot;http://www.scpwiki.com/scp-5056&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/this-page-intentionally-left-blank/Euclid.png&quot; alt=&quot;Euclid.png&quot; class=&quot;image&quot; /&gt;&lt;/a&gt; &lt;a href=&quot;http://www.scpwiki.com/scp-5109&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/this-page-intentionally-left-blank/Safe.png&quot; alt=&quot;Safe.png&quot; class=&quot;image&quot; /&gt;&lt;/a&gt; &lt;a href=&quot;http://www.scpwiki.com/scp-5243&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/this-page-intentionally-left-blank/Keter.png&quot; alt=&quot;Keter.png&quot; class=&quot;image&quot; /&gt;&lt;/a&gt; &lt;a href=&quot;http://www.scpwiki.com/scp-5382&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/this-page-intentionally-left-blank/Thaumiel.png&quot; alt=&quot;Thaumiel.png&quot; class=&quot;image&quot; /&gt;&lt;/a&gt; &lt;a href=&quot;http://www.scpwiki.com/scp-5494&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/this-page-intentionally-left-blank/Ticonderoga.png&quot; alt=&quot;Ticonderoga.png&quot; class=&quot;image&quot; /&gt;&lt;/a&gt; &lt;a href=&quot;http://www.scpwiki.com/scp-5520&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/this-page-intentionally-left-blank/Archon.png&quot; alt=&quot;Archon.png&quot; class=&quot;image&quot; /&gt;&lt;/a&gt; &lt;a href=&quot;http://www.scpwiki.com/scp-5618&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/this-page-intentionally-left-blank/Apollyon.png&quot; alt=&quot;Apollyon.png&quot; class=&quot;image&quot; /&gt;&lt;/a&gt; &lt;a href=&quot;http://www.scpwiki.com/scp-5751&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/this-page-intentionally-left-blank/Cernunnos.png&quot; alt=&quot;Cernunnos.png&quot; class=&quot;image&quot; /&gt;&lt;/a&gt; &lt;a href=&quot;http://www.scpwiki.com/scp-5866&quot;&gt;&lt;img src=&quot;http://scp-wiki.wd