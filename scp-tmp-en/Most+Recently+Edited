&lt;div style=&quot;clear:both; height: 0px; font-size: 1px&quot;&gt;&lt;/div&gt;
&lt;p&gt;&lt;span style=&quot;border: solid 2px #003; border-radius: 15px; padding: 4px 8px; display: inline-block; text-align: center; float:left; background-color: #36c; background: linear-gradient(to bottom right, #36c,#003); color: #fff;&quot;&gt;&lt;span style=&quot;text-shadow: #003 1px 1px;&quot;&gt;Yup, we&#039;re in business buddy.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div style=&quot;clear:both; height: 0px; font-size: 1px&quot;&gt;&lt;/div&gt;
&lt;p&gt;&lt;span style=&quot;border: solid 2px #003; border-radius: 15px; padding: 4px 8px; display: inline-block; text-align:left; float:left; background-color: #36c; background: linear-gradient(to bottom right, #36c,#003); color: #fff;&quot;&gt;&lt;span style=&quot;text-shadow: #003 1px 1px;&quot;&gt;You wanna tell Clef that I got Alex bugging alpha niner now?&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div style=&quot;clear:both; height: 0px; font-size: 1px&quot;&gt;&lt;/div&gt;
&lt;p&gt;&lt;span style=&quot;border: solid 2px #003; border-radius: 15px; padding: 4px 8px; display: inline-block; text-align: center; float:right; background-color: #990; background: linear-gradient(to bottom right, #990,#030); color: #fff;&quot;&gt;&lt;span style=&quot;text-shadow: #003 1px 1px;&quot;&gt;Yeah, I&#039;ll mention the implementation in my report.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div style=&quot;clear:both; height: 0px; font-size: 1px&quot;&gt;&lt;/div&gt;
&lt;p&gt;&lt;span style=&quot;border: solid 2px #003; border-radius: 15px; padding: 4px 8px; display: inline-block; text-align: center; float:right; background-color: #990; background: linear-gradient(to bottom right, #990,#030); color: #fff;&quot;&gt;&lt;span style=&quot;text-shadow: #003 1px 1px;&quot;&gt;Good work.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div style=&quot;clear:both; height: 0px; font-size: 1px&quot;&gt;&lt;/div&gt;
&lt;p&gt;&lt;span style=&quot;border: solid 2px #003; border-radius: 15px; padding: 4px 8px; display: inline-block; text-align:left; float:left; background-color: #36c; background: linear-gradient(to bottom right, #36c,#003); color: #fff;&quot;&gt;&lt;span style=&quot;text-shadow: #003 1px 1px;&quot;&gt;BTW, We need to watch Alex&#039;s fascination with this fantasy fiction stuff.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div style=&quot;clear:both; height: 0px; font-size: 1px&quot;&gt;&lt;/div&gt;
&lt;p&gt;&lt;span style=&quot;border: solid 2px #003; border-radius: 15px; padding: 4px 8px; display: inline-block; text-align:left; float:left; background-color: #36c; background: linear-gradient(to bottom right, #36c,#003); color: #fff;&quot;&gt;&lt;span style=&quot;text-shadow: #003 1px 1px;&quot;&gt;It&#039;s getting to be an issue.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div style=&quot;clear:both; height: 0px; font-size: 1px&quot;&gt;&lt;/div&gt;
