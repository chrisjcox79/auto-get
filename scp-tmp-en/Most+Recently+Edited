t;&lt;a id=&quot;footnoteref-167054-3&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;3&lt;/a&gt;&lt;/sup&gt; | &lt;a href=&quot;https://twitter.com/Ralliston1&quot; target=&quot;_blank&quot;&gt;&lt;img src=&quot;https://www.colorbook.io/img/icons/socialmedia/twitter.svg&quot; width=&quot;38&quot; alt=&quot;twitter.svg&quot; class=&quot;image&quot; /&gt;&lt;/a&gt;&lt;/div&gt;
