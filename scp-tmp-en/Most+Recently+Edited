&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/doctor-cheese&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6525339&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607264913&quot; alt=&quot;Doctor Cheese&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6525339)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/doctor-cheese&quot;  &gt;Doctor Cheese&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
