&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/theanimatefry&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5927653&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608087179&quot; alt=&quot;TheAnimateFry&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5927653)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/theanimatefry&quot;  &gt;TheAnimateFry&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
