&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/researcher-omicron&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6850459&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605860223&quot; alt=&quot;Researcher Omicron&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6850459)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/researcher-omicron&quot;  &gt;Researcher Omicron&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
