&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sirslash47&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6438262&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608128226&quot; alt=&quot;Sirslash47&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6438262)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sirslash47&quot;  &gt;Sirslash47&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
