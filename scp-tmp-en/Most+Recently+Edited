&lt;p&gt;&lt;iframe src=&quot;http://scp-wiki.wdfiles.com/local--code/info%3Astyle/3&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;&quot; width=&quot;&quot; class=&quot;close-credits&quot; style=&quot;height:2em;margin: 0;padding: 0;border: 0;background: transparent;&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
&lt;p&gt;SCP-5107 &amp;quot;Jesus Christ Super Star&amp;quot; by: &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/drakimoto&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5255688&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609014702&quot; alt=&quot;DrAkimoto&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5255688)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/drakimoto&quot;  &gt;DrAkimoto&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;
