&lt;th style=&quot;border: 1px solid black; padding-left: 12px; padding-right: 12px; background-color: #FFFDF3&quot; colspan=&quot;1&quot;&gt;&lt;strong&gt;&lt;a href=&quot;http://www.scpwiki.com/the-significant-others-part-b&quot;&gt;Part &amp;quot;B&amp;quot;&lt;/a&gt;&lt;/strong&gt;&lt;/th&gt;
