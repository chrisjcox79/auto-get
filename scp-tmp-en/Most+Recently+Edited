&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Crustacean&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
&lt;td&gt;&lt;a href=&quot;http://www.scpwiki.com/scp-3485&quot;&gt;SCP-3485&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
