&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lt-masipag&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=172570&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606919494&quot; alt=&quot;Lt Masipag&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=172570)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lt-masipag&quot;  &gt;Lt Masipag&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
