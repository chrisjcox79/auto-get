&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mr-matchbook&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5593151&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607329571&quot; alt=&quot;Mr Matchbook&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5593151)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mr-matchbook&quot;  &gt;Mr Matchbook&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
