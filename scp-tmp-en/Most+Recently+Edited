&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/chaucer345&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2002514&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607523812&quot; alt=&quot;chaucer345&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2002514)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/chaucer345&quot;  &gt;chaucer345&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
