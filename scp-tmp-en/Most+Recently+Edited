&lt;p&gt;&lt;iframe src=&quot;http://www.scpwiki.com/inbox/html/b2e5b84994dc0bbe3e659d9f8b63933e29eddd02-4801725551710540051&quot; allowtransparency=&quot;true&quot; frameborder=&quot;0&quot; class=&quot;html-block-iframe&quot;&gt;&lt;/iframe&gt;&lt;/p&gt;
