&lt;td&gt;&lt;span style=&quot;color: red&quot;&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;site55containment@scp.int&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;
