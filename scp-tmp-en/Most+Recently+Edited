&lt;/div&gt;
&lt;div id=&quot;wiki-tab-0-1&quot; style=&quot;display:none&quot;&gt;
&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:300px;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/boogey-man23-author-page/APProfilePic2.jpg&quot; style=&quot;width:300px;&quot; alt=&quot;APProfilePic2.jpg&quot; class=&quot;image&quot; /&gt;
&lt;div class=&quot;scp-image-caption&quot; style=&quot;width:300px;&quot;&gt;
&lt;p&gt;Not Foundation standard-issue equipment.&lt;/p&gt;
