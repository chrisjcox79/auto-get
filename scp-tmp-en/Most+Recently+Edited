&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/krazykommando&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7081197&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610030008&quot; alt=&quot;KrazyKommando&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7081197)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/krazykommando&quot;  &gt;KrazyKommando&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
