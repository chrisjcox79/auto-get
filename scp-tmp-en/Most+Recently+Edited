&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/actually-god&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5849042&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608519657&quot; alt=&quot;actually-god&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5849042)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/actually-god&quot;  &gt;actually-god&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
