&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/theslothsavant&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2192823&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608668948&quot; alt=&quot;TheSlothSavant&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2192823)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/theslothsavant&quot;  &gt;TheSlothSavant&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div class=&quot;footnotes-footer&quot;&gt;
