&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lilac-snow&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5210371&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606746163&quot; alt=&quot;Lilac Snow&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5210371)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lilac-snow&quot;  &gt;Lilac Snow&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
