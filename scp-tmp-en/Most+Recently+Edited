&lt;div class=&quot;collapsible-block-unfolded&quot; style=&quot;display:none&quot;&gt;
&lt;div class=&quot;collapsible-block-unfolded-link&quot;&gt;&lt;a class=&quot;collapsible-block-link&quot; href=&quot;javascript:;&quot;&gt;-&amp;nbsp;Hope&amp;nbsp;you&amp;nbsp;like&amp;nbsp;tables!&lt;/a&gt;&lt;/div&gt;
