&lt;div class=&quot;image-container floatleft&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/secure-facility-dossier-site-43/Logo.png&quot; width=&quot;140px&quot; alt=&quot;Logo.png&quot; class=&quot;image&quot; /&gt;&lt;/div&gt;
