&lt;p style=&quot;text-align: center;&quot;&gt;&lt;em&gt;10/06/1969&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;text-decoration: line-through;&quot;&gt;&lt;em&gt;23/11/1969&lt;/em&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;em&gt;Em um dragão o queriam transformar em vida.&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-412481-6&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;6&lt;/a&gt;&lt;/sup&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;em&gt;Em um poderoso rei eu o farei na morte.&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-412481-7&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;7&lt;/a&gt;&lt;/sup&gt;&lt;/em&gt;&lt;/p&gt;
&lt;p style=&quot;text-align: center;&quot;&gt;&lt;em&gt;Pela graça do Grande Ion.&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-412481-8&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;8&lt;/a&gt;&lt;/sup&gt;&lt;/em&gt;&lt;/p&gt;
