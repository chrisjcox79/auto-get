&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/brodsneav&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7093111&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607372466&quot; alt=&quot;Brodsneav&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7093111)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/brodsneav&quot;  &gt;Brodsneav&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
