&lt;h2&gt;&lt;span&gt;About the Artist&lt;/span&gt;&lt;/h2&gt;
&lt;div class=&quot;scp-image-block block-center&quot; style=&quot;width:600px;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/barredowl-s-kick-ass-art-page/headerNEW.png&quot; style=&quot;width:600px;&quot; alt=&quot;headerNEW.png&quot; class=&quot;image&quot; /&gt;
