&lt;p&gt;&lt;span style=&quot;color:black&quot;&gt;&lt;br /&gt;
&lt;strong&gt;In the Dark&lt;/strong&gt; by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/greyve&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4045981&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608214786&quot; alt=&quot;Greyve&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4045981)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/greyve&quot;  &gt;Greyve&lt;/a&gt;&lt;/span&gt; and &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/jakdragonx&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5588260&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608214786&quot; alt=&quot;JakdragonX&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5588260)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/jakdragonx&quot;  &gt;JakdragonX&lt;/a&gt;&lt;/span&gt;&lt;br /&gt;&lt;/span&gt;&lt;br /&gt;
