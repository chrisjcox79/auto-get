&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/myoldnamewasbad&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6581091&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607545248&quot; alt=&quot;myoldnamewasbad&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6581091)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/myoldnamewasbad&quot;  &gt;myoldnamewasbad&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
