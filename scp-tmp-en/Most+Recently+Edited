&lt;div style=&quot;text-align: center;&quot;&gt;&lt;img src=&quot;https://imgur.com/3KNuBvH.png&quot; style=&quot;width:25%;&quot; alt=&quot;3KNuBvH.png&quot; class=&quot;image&quot; /&gt;&lt;/div&gt;
