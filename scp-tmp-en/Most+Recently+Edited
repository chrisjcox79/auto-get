&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tiamat-elsen&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4142067&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607955387&quot; alt=&quot;Tiamat Elsen&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4142067)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tiamat-elsen&quot;  &gt;Tiamat Elsen&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
