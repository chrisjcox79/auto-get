&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/drclef&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=213153&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609229950&quot; alt=&quot;DrClef&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=213153)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/drclef&quot;  &gt;DrClef&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
