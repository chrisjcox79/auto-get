&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wils&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2096532&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608128229&quot; alt=&quot;Wils&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2096532)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wils&quot;  &gt;Wils&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
