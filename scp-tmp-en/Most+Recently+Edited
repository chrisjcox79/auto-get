&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/pedantique&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3118444&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606963612&quot; alt=&quot;Pedantique&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3118444)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/pedantique&quot;  &gt;Pedantique&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
