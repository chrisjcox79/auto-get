&lt;span style=&quot;font-size:80%;&quot;&gt;&lt;strong&gt;&lt;a href=&quot;http://scp-wiki.wikidot.com/scp-5957&quot;&gt;&amp;lt;&amp;lt; SCP-5957&lt;/a&gt;&lt;/strong&gt; | &lt;strong&gt;Fox Hunt&lt;/strong&gt; | &lt;strong&gt;&lt;em&gt;Coming Soon &amp;#187;&lt;/em&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;br /&gt;
