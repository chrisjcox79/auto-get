&lt;th style=&quot;border: 1px solid black; background-color: #FFEBF3; padding-left: 12px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px&quot;&gt;&amp;quot;Skippy the Unicorn Has Had Enough of Your Shit!&amp;quot; (with &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/nickthebrick1&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5208936&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608992524&quot; alt=&quot;Nickthebrick1&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5208936)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/nickthebrick1&quot;  &gt;Nickthebrick1&lt;/a&gt;&lt;/span&gt;!)&lt;/th&gt;
