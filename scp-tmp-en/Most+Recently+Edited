&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mrwrong&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2039383&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608712013&quot; alt=&quot;MrWrong&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2039383)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mrwrong&quot;  &gt;MrWrong&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
