&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-gears&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=172464&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608214782&quot; alt=&quot;Dr Gears&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=172464)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-gears&quot;  &gt;Dr Gears&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
