&lt;div style=&quot;display: none&quot;&gt;&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/estrellayoshte&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3781861&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608625917&quot; alt=&quot;EstrellaYoshte&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3781861)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/estrellayoshte&quot;  &gt;EstrellaYoshte&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
