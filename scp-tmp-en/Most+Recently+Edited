&lt;div class=&quot;acs-icon&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/component%3Aanomaly-class-bar/euclid-icon.svg&quot; alt=&quot;euclid-icon.svg&quot; class=&quot;image&quot; /&gt;&lt;/div&gt;
