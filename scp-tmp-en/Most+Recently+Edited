&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/clubby789&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3806687&amp;amp;amp;size=small&amp;amp;amp;timestamp=1610117152&quot; alt=&quot;clubby789&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3806687)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/clubby789&quot;  &gt;clubby789&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
