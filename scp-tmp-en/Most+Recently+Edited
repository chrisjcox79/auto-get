&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/nickthebrick1&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5208936&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609316466&quot; alt=&quot;Nickthebrick1&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5208936)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/nickthebrick1&quot;  &gt;Nickthebrick1&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
