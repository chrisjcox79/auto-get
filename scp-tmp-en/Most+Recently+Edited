&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/daveyoufool&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2034230&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609316480&quot; alt=&quot;daveyoufool&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2034230)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/daveyoufool&quot;  &gt;daveyoufool&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
