&lt;p&gt;&amp;#171; &lt;a class=&quot;newpage&quot; href=&quot;http://www.scpwiki.com/scp-5943&quot;&gt;SCP-5943&lt;/a&gt; | SCP-5944 | &lt;a href=&quot;http://www.scpwiki.com/scp-5945&quot;&gt;SCP-5945&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/harvoable&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7005588&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605860226&quot; alt=&quot;Harvoable &quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7005588)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/harvoable&quot;  &gt;Harvoable&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
