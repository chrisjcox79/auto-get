&lt;td&gt;&lt;a href=&quot;http://www.scpwiki.com/scp-1422&quot;&gt;SCP-1422&lt;/a&gt;, &lt;a href=&quot;http://www.scpwiki.com/scp-5107&quot;&gt;SCP-5107&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;
