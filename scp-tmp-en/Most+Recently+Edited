&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/jukse&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1433010&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607395811&quot; alt=&quot;Jukse&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1433010)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/jukse&quot;  &gt;Jukse&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
