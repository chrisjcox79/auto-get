&lt;td&gt;&lt;a href=&quot;http://www.scpwiki.com/scantron-s-proposal&quot;&gt;Scantron&#039;s Proposal&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;▄█▐██&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
&lt;td&gt;&lt;a href=&quot;http://www.scpwiki.com/ura-1902&quot;&gt;URA-1902&lt;/a&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;
