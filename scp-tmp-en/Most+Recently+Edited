&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/agatharights&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=232934&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609384702&quot; alt=&quot;agatharights&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=232934)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/agatharights&quot;  &gt;agatharights&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
