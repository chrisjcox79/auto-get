&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:300px;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/scp-940/940-1-new.jpg&quot; style=&quot;width:300px;&quot; alt=&quot;940-1-new.jpg&quot; class=&quot;image&quot; /&gt;
