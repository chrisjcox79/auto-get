&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/xavethebest&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7078544&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606833419&quot; alt=&quot;XaveTheBest&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7078544)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/xavethebest&quot;  &gt;XaveTheBest&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
