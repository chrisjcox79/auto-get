&lt;/div&gt;
&lt;div class=&quot;footer-wikiwalk-nav&quot;&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&amp;#171; &lt;a href=&quot;http://www.scpwiki.com/scp-5935&quot;&gt;SCP-5935&lt;/a&gt; | SCP-5936 | &lt;a href=&quot;http://www.scpwiki.com/scp-5937&quot;&gt;SCP-5937&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ralliston&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5986843&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606099689&quot; alt=&quot;Ralliston&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5986843)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ralliston&quot;  &gt;Ralliston&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
