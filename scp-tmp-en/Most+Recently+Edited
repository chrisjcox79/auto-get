&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/spikebrennan&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=908688&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609921884&quot; alt=&quot;spikebrennan&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=908688)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/spikebrennan&quot;  &gt;spikebrennan&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
