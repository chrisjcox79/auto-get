&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/hiumentah&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3305050&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607976999&quot; alt=&quot;HiuMentah&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3305050)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/hiumentah&quot;  &gt;HiuMentah&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
