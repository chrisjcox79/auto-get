&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/manymeats&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2104082&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606162312&quot; alt=&quot;ManyMeats&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2104082)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/manymeats&quot;  &gt;ManyMeats&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
