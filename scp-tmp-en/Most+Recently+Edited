&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tygently&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2038009&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606853685&quot; alt=&quot;TyGently&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2038009)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tygently&quot;  &gt;TyGently&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
