&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tufto&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3337265&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609360479&quot; alt=&quot;Tufto&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3337265)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tufto&quot;  &gt;Tufto&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
