&lt;hr /&gt;
&lt;img src=&quot;http://scp-wiki.wikidot.com/local--files/grigori-karpin-s-author-page/vargaA&quot; alt=&quot;vargaA&quot; class=&quot;image&quot; /&gt;&lt;/div&gt;
&lt;br /&gt;
