&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/harryblank&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6479803&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608366273&quot; alt=&quot;HarryBlank&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6479803)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/harryblank&quot;  &gt;HarryBlank&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div class=&quot;footnotes-footer&quot;&gt;
&lt;div class=&quot;title&quot;&gt;Footnotes&lt;/div&gt;
&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-468151-1&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;1&lt;/a&gt;. Yes, actually.&lt;/div&gt;
&lt;/div&gt;
