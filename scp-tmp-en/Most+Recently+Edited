&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/duganist&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7085155&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606939553&quot; alt=&quot;Duganist&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7085155)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/duganist&quot;  &gt;Duganist&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
