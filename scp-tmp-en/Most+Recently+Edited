/local--files/shineshadowd:gyd4/%E8%A7%A3%E9%99%A4%E5%88%86%E7%BA%A7.svg" alt="解除分级.svg" class="image" /></div> <div class="icon_name">Declassified<sup class="footnoteref"><a id="footnoteref-618803-9" href="javascript:;" class="footnoteref" >9</a></sup></div> <div class="icon_link"><a href="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/%E8%A7%A3%E9%99%A4%E5%88%86%E7%BA%A7.svg">Link</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/Maksur.svg" alt="Maksur.svg" class="image" /></div> <div class="icon_name">Maksur<sup class="footnoteref"><a id="footnoteref-618803-10" href="javascript:;" class="footnoteref" >10</a></sup></div> <div class="icon_link"><a href="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/Maksur.svg">Link</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/Necropsar.svg" alt="Necropsar.svg" class="image" /></div> <div class="icon_name">Necropsar<sup class="footnoteref"><a id="footnoteref-618803-11" href="javascript:;" class="footnoteref" >11</a></sup></div> <div class="icon_link"><a href="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/Necropsar.svg">Link</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/NA.svg" alt="NA.svg" class="image" /></div> <div class="icon_name">N/A</div> <div class="icon_link"><a href="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/NA.svg">Link</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/ROLL.svg" alt="ROLL.svg" class="image" /></div> <div class="icon_name">ROLL<sup class="footnoteref"><a id="footnoteref-618803-12" href="javascript:;" class="footnoteref" >12</a></sup></div> <div class="icon_link"><a href="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/ROLL.svg">Link</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/Yesod.svg" alt="Yesod.svg" class="image" /></div> <div class="icon_name">Yesod<sup class="footnoteref"><a id="footnoteref-618803-13" href="javascript:;" class="footnoteref" >13</a></sup></div> <div class="icon_link"><a href="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/Yesod.svg">Link</a></div> </div> </div> <hr /> <h1><span>Basic ACS icon</span></h1> <div class="icons"> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/apollyon-icon.svg" alt="apollyon-icon.svg" class="image" /></div> <div class="icon_name">apollyon<sup class="footnoteref"><a id="footnoteref-618803-14" href="javascript:;" class="footnoteref" >14</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/apollyon-icon.svg">Link</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/archon-icon.svg" alt="archon-icon.svg" class="image" /></div> <div class="icon_name">archon<sup class="footnoteref"><a id="footnoteref-618803-15" href="javascript:;" class="footnoteref" >15</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/archon-icon.svg">Link</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/cernunnos-icon.svg" alt="cernunnos-icon.svg" class="image" /></div> <div class="icon_name">cernunnos<sup class="footnoteref"><a id="footnoteref-618803-16" href="javascript:;" class="footnoteref" >16</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/cernunnos-icon.svg">Link</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/hiemal-icon.svg" alt="hiemal-icon.svg" class="image" /></div> <div class="icon_name">hiemal<sup class="footnoteref"><a id="footnoteref-618803-17" href="javascript:;" class="footnoteref" >17</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/hiemal-icon.svg">Link</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/tiamat-icon.svg" alt="tiamat-icon.svg" class="image" /></div> <div class="icon_name">tiamat<sup class="footnoteref"><a id="footnoteref-618803-18" href="javascript:;" class="footnoteref" >18</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/tiamat-icon.svg">Link</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/ticonderoga-icon.svg" alt="ticonderoga-icon.svg" class="image" /></div> <div class="icon_name">ticonderoga<sup class="footnoteref"><a id="footnoteref-618803-19" href="javascript:;" class="footnoteref" >19</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/ticonderoga-icon.svg">Link</a></div> </div> <div class="icon_container"> <div class="icon_image color-white"><img src="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/thaumiel-icon.svg" alt="thaumiel-icon.svg" class="image" /></div> <div class="icon_name">thaumiel<sup class="footnoteref"><a id="footnoteref-618803-20" href="javascript:;" class="footnoteref" >20</a></sup></div> <div class="icon_link"><a href="http://scp-wiki.wikidot.com/local--files/component:anomaly-class-bar/thaumiel-icon.svg">Link</a></div> </div> </div> </div> <div class="footnotes-footer"> <div class="title">Footnotes</div> <div class="footnote-footer" id="footnote-618803-1"><a href="javascript:;" >1</a>. Modified from <a href="http://scp-wiki.wikidot.com/component:anomaly-class-bar">ACS Guide</a></div> <div class="footnote-footer" id="footnote-618803-2"><a href="javascript:;" >2</a>. Item can be functionally contained, but the Foundation cannot achieve this for logistical and/or ethical reasons. (Redrawing,<span style="text-decoration: line-through;">the reason is that when I was painting, I didn't notice that the original version had ×</span>)</div> <div class="footnote-footer" id="footnote-618803-3"><a href="javascript:;" >3</a>. Item is entangled with baseline and its containment would affect intelligent entities.</div> <div class="footnote-footer" id="footnote-618803-4"><a href="javascript:;" >4</a>. Item has been completely affected by the disappearance of a special part of the anomaly.</div> <div class="footnote-footer" id="footnote-618803-5"><a href="javascript:;" >5</a>. Item is currently under an official investigation for authenticity by the Overseer Council.</div> <div class="footnote-footer" id="footnote-618803-6"><a href="javascript:;" >6</a>. Item is used by the Foundation to create anomalies.</div> <div class="footnote-footer" id="footnote-618803-7"><a href="javascript:;" >7</a>. Item is non-anomalous but related to the anomalous.</div> <div class="footnote-footer" id="footnote-618803-8"><a href="javascript:;" >8</a>. Item endangers the inner structure of the Foundation and limits the ability of the Foundation to carry out its secondary objectives.</div> <div class="footnote-footer" id="footnote-618803-9"><a href="javascript:;" >9</a>. Item has been revealed to the Foundation and/or public at large.</div> <div class="footnote-footer" id="footnote-618803-10"><a href="javascript:;" >10</a>. Item has been separated into several anomalous parts which must be kept separate.</div> <div class="footnote-footer" id="footnote-618803-11"><a href="javascript:;" >11</a>. There is no credible evidence to support the existence of Item in a kind of social history (generally the social history of standard Homo sapiens). However, through the observation of historical view and the observation of planning department, the validity of project existence can be confirmed from other historical processes, and at the same time, a series of potential signs/symptoms that may/will exist in the Item can be found.</div> <div class="footnote-footer" id="footnote-618803-12"><a href="javascript:;" >12</a>. Errors such as garbled code are caused by abnormal items in project classification. The reference is from <a href="http://scp-wiki.wikidot.com/scp-5856">SCP-5856</a>.</div> <div class="footnote-footer" id="footnote-618803-13"><a href="javascript:;" >13</a>. Item has been integrated into the Foundation's command structure.</div> <div class="footnote-footer" id="footnote-618803-14"><a href="javascript:;" >14</a>. Item is uncontainable and actively causing the end of the world.</div> <div class="footnote-footer" id="footnote-618803-15"><a href="javascript:;" >15</a>. Item is able to be contained but ought not to be.</div> <div class="footnote-footer" id="footnote-618803-16"><a href="javascript:;" >16</a>. Item can be functionally contained, but the Foundation cannot achieve this for logistical and/or ethical reasons.</div> <div class="footnote-footer" id="footnote-618803-17"><a href="javascript:;" >17</a>. Item is a system of two or more distinct but related anomalies that keep each other under control.</div> <div class="footnote-footer" id="footnote-618803-18"><a href="javascript:;" >18</a>. Item poses an immediate threat to humanity, but can be &quot;contained&quot; via open warfare or other Veil-breaking operations.</div> <div class="footnote-footer" id="footnote-618803-19"><a href="javascript:;" >19</a>. Item cannot be contained but does not need to be contained.</div> <div class="footnote-footer" id="footnote-618803-20"><a href="javascript:;" >20</a>. Item is used to contain other anomalies.</div> </div> <div class="licensebox22"> <div class="collapsible-block"> <div class="collapsible-block-folded"><a class="collapsible-block-link" href="javascript:;">‡&nbsp;Licensing&nbsp;/&nbsp;Citation</a></div> <div class="collapsible-block-unfolded" style="display:none"> <div class="collapsible-block-unfolded-link"><a class="collapsible-block-link" href="javascript:;">‡&nbsp;Hide&nbsp;Licensing&nbsp;/&nbsp;Citation</a></div> <div class="collapsible-block-content"> <p>Cite this page as:</p> <p>For more information, see <a href="http://www.scp-wiki.net/licensing-guide">Licensing Guide</a>.<br /> <strong>Licensing Disclosures</strong></p> <div class="content-separator" style="display: none:"></div> <blockquote> <p><strong>Filename:</strong> Cernnunos.svg<br /> <strong>Author:</strong><span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/shineshadowd" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=3967806&amp;amp;size=small&amp;amp;timestamp=1605860216" alt="ShineShadowD" style="background-image:url(http://www.wikidot.com/userkarma.php?u=3967806)" /></a><a href="http://www.wikidot.com/user:info/shineshadowd" >ShineShadowD</a></span><br /> <strong>License:</strong>CC_BY_SA<br /> <strong>Source Link:</strong> <a href="http://smlt.wikidot.com/local--files/shineshadowd:gyd4/Cernnunos.svg">http://smlt.wikidot.com/local--files/shineshadowd:gyd4/Cernnunos.svg</a></p> </blockquote> <div class="content-separator" style="display: none:"></div> <blockquote> <p><strong>Filename:</strong> Chhokmah.svg<br /> <strong>Author:</strong><span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/shineshadowd" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=3967806&amp;amp;size=small&amp;amp;timestamp=1605860216" alt="ShineShadow