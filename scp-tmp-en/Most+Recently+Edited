&lt;td style=&quot;padding: 0 2px; text-align: center;border: 1px solid #888;&quot;&gt;&lt;img src=&quot;http://scp-wiki-cn.wikidot.com/local--files/josephartwork/Decommissioned&quot; alt=&quot;Decommissioned&quot; class=&quot;image&quot; /&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-fishbone&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6127045&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609057198&quot; alt=&quot;Dr Fishbone&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6127045)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-fishbone&quot;  &gt;Dr Fishbone&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
