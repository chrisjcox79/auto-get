&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cadavercommander&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3187823&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609511801&quot; alt=&quot;CadaverCommander&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3187823)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cadavercommander&quot;  &gt;CadaverCommander&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
