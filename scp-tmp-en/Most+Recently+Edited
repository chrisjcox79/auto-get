&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:300px;&quot;&gt;&lt;a href=&quot;http://www.scpwiki.com/local--files/scp-2779/piglet-1.jpg&quot; target=&quot;_blank&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/scp-2779/piglet-1.jpg&quot; style=&quot;width:300px;&quot; alt=&quot;piglet-1.jpg&quot; class=&quot;image&quot; /&gt;&lt;/a&gt;
