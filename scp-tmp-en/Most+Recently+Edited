&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/hexick&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5065702&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606185835&quot; alt=&quot;Hexick&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5065702)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/hexick&quot;  &gt;Hexick&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
