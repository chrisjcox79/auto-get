&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/procyonlotor&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=778357&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607005465&quot; alt=&quot;ProcyonLotor&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=778357)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/procyonlotor&quot;  &gt;ProcyonLotor&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
				<pubDate>Sat, 08 Feb 2020 04:03:06 +0000</pubDate>
												<content:encoded>
