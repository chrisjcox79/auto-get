&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/nagiros&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4665703&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607955395&quot; alt=&quot;Nagiros&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4665703)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/nagiros&quot;  &gt;Nagiros&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
&lt;div class=&quot;footnotes-footer&quot;&gt;
