&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/t-rutherford&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4620432&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606983583&quot; alt=&quot;T Rutherford&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4620432)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/t-rutherford&quot;  &gt;T Rutherford&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
