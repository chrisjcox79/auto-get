&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/croquembouche&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2893766&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607026560&quot; alt=&quot;Croquembouche&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2893766)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/croquembouche&quot;  &gt;Croquembouche&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
