&lt;p&gt;&amp;#171; &lt;a href=&quot;http://www.scpwiki.com/scp-4575&quot;&gt;SCP-4575&lt;/a&gt; | SCP-4576 | &lt;a href=&quot;http://www.scpwiki.com/scp-4577&quot;&gt;SCP-4577&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/quadraginta&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6391595&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606680444&quot; alt=&quot;Quadraginta&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6391595)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/quadraginta&quot;  &gt;Quadraginta&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
