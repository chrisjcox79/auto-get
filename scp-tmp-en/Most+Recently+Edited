&lt;th style=&quot;border: 1px solid black; background-color: #E2E9D7; padding-left: 12px; padding-right: 12px; padding-top: 6px; padding-bottom: 6px&quot;&gt;&amp;quot;The People Person&amp;quot;&lt;/th&gt;
&lt;/tr&gt;
