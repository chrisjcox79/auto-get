&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/literallymechanical&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2829014&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606206237&quot; alt=&quot;LiterallyMechanical&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2829014)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/literallymechanical&quot;  &gt;LiterallyMechanical&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
