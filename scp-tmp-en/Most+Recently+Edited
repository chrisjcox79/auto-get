&lt;td&gt;&lt;strong&gt;Celestial Body Displayed:&lt;/strong&gt; UNKNOWN&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-955672-8&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;8&lt;/a&gt;&lt;/sup&gt;&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&amp;#32;&lt;/span&gt;&lt;/td&gt;
