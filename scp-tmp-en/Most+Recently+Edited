&lt;div class=&quot;carousel-container right&quot; style=&quot;width: calc(300px + 34px);&quot;&gt;&lt;iframe src=&quot;https://scp-wiki.wikidot.com/local--code/component%3Acarousel/1#?images=5800-1.png,5800-2.png,5800-3.png,5800-4.png&amp;amp;wiki=scp-wiki&amp;amp;page=scp-5800&amp;amp;interval=4&amp;amp;background=white&amp;amp;options=yes&quot; align=&quot;&quot; frameborder=&quot;&quot; height=&quot;&quot; scrolling=&quot;no&quot; width=&quot;&quot; class=&quot;&quot; style=&quot;width: calc(300px + 34px); height: calc(240px + 6px);&quot;&gt;&lt;/iframe&gt;
