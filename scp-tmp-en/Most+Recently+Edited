&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;div class=&quot;collapsible-block&quot;&gt;
&lt;div class=&quot;collapsible-block-folded&quot;&gt;&lt;span style=&quot;font-size:150%;&quot;&gt;&lt;a class=&quot;collapsible-block-link&quot; href=&quot;javascript:;&quot;&gt;+&amp;nbsp;Show&amp;nbsp;(1)&amp;nbsp;Proposed&amp;nbsp;Additions&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;
