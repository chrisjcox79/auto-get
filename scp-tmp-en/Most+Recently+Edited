- &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wizzblizz&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6760712&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606853688&quot; alt=&quot;WizzBlizz&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6760712)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/wizzblizz&quot;  &gt;WizzBlizz&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
