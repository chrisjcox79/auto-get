&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span class=&quot;tooltip&quot;&gt;&lt;a href=&quot;http://scp-wiki.wikidot.com/dark-achievement-badges&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/component%3Asybadge/scl.png&quot; style=&quot;background-color: var(--bgBadgeColor); padding: .66rem .7rem .4rem .5rem; border-radius: .6rem 2.5rem .6rem .6rem; margin: .3rem; border: solid 4px var(--borderColor);&quot; width=&quot;64px&quot; alt=&quot;scl.png&quot; class=&quot;image&quot; /&gt;&lt;/a&gt;&lt;span class=&quot;tooltiptext&quot;&gt;&lt;span class=&quot;scl&quot;&gt; &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;tooltip&quot;&gt;&lt;a href=&quot;http://scp-wiki.wikidot.com/dark-achievement-badges&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/component%3Asybadge/tsf.png&quot; style=&quot;background-color: var(--bgBadgeColor); padding: .66rem .7rem .4rem .5rem; border-radius: .6rem 2.5rem .6rem .6rem; margin: .3rem; border: solid 4px var(--borderColor);&quot; width=&quot;64px&quot; alt=&quot;tsf.png&quot; class=&quot;image&quot; /&gt;&lt;/a&gt;&lt;span class=&quot;tooltiptext&quot;&gt;&lt;span class=&quot;tsf&quot;&gt; &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;
