&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/promethcookie&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7183245&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609989353&quot; alt=&quot;promethcookie&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7183245)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/promethcookie&quot;  &gt;promethcookie&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
