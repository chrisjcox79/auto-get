&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/absurat5&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7046493&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606185841&quot; alt=&quot;Absurat5&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7046493)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/absurat5&quot;  &gt;Absurat5&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
