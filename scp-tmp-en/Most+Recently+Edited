&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lestabbyhuman&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6994888&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606919486&quot; alt=&quot;LeStabbyHuman&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6994888)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lestabbyhuman&quot;  &gt;LeStabbyHuman&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
