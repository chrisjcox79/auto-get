&lt;td&gt;&lt;span style=&quot;font-size:125%;&quot;&gt;&lt;strong&gt;Item #:&lt;/strong&gt; SCP-5923&lt;/span&gt;&lt;/td&gt;
&lt;td style=&quot;text-align: right;&quot;&gt;&lt;span style=&quot;font-size:125%;&quot;&gt;&lt;span style=&quot;color: #990000&quot;&gt;&lt;strong&gt;Level 3/5923&lt;/strong&gt;&lt;/span&gt;&lt;/span&gt;&lt;/td&gt;
&lt;/tr&gt;
