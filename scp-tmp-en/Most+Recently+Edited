&lt;div style=&quot;text-align: center;&quot;&gt;&lt;a href=&quot;http://scp-wiki.wdfiles.com/local--files/scp-5517/lucialebedev&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--resized-images/scp-5517/lucialebedev/medium.jpg&quot; alt=&quot;lucialebedev&quot; class=&quot;image&quot; /&gt;&lt;/a&gt;&lt;/div&gt;
