&lt;p&gt;&lt;strong&gt;Item #:&lt;/strong&gt; &lt;a href=&quot;http://www.scpwiki.com/scp-5382&quot;&gt;SCP-5382&lt;/a&gt;&lt;/p&gt;
&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:175px;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/this-page-intentionally-left-blank/Wagon.jpg&quot; style=&quot;width:175px;&quot; alt=&quot;Wagon.jpg&quot; class=&quot;image&quot; /&gt;
