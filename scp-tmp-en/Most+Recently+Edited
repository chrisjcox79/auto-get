&lt;td style=&quot;padding: 0 2px; text-align: center;width: 30%;&quot;&gt;Icon&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style=&quot;padding: 0 2px;border: 1px solid #888;&quot;&gt;001&lt;/td&gt;
&lt;td style=&quot;padding: 0 2px;border: 1px solid #888;&quot;&gt;&lt;strong&gt;Chaos Insurgency&lt;/strong&gt;&lt;/td&gt;
&lt;td style=&quot;padding: 0 2px;border: 1px solid #888;&quot;&gt;Destroy Foundation facilities and/or sites 5 times or more.&lt;/td&gt;
&lt;td style=&quot;padding: 0 2px; text-align: center;border: 1px solid #888; width: 30%;&quot;&gt;&lt;img src=&quot;http://scp-wiki-cn.wikidot.com/local--files/achievement-badges/01.png&quot; alt=&quot;01.png&quot; class=&quot;image&quot; /&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style=&quot;padding: 0 2px;border: 1px solid #888;&quot;&gt;002&lt;/td&gt;
&lt;td style=&quot;padding: 0 2px;border: 1px solid #888;&quot;&gt;&lt;strong&gt;Not enough&lt;/strong&gt;&lt;/td&gt;
&lt;td style=&quot;padding: 0 2px;border: 1px solid #888;&quot;&gt;Author of at least 10 SCPs/GOI-format/tales/artworks that are all rated +30 or higher and are downvoted by the same member.&lt;/td&gt;
