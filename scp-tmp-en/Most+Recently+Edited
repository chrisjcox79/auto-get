&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/grigori-karpin&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4558017&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607458740&quot; alt=&quot;Grigori Karpin&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4558017)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/grigori-karpin&quot;  &gt;Grigori Karpin&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
