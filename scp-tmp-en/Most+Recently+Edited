&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:300px;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/scp-4703/4703.jpg&quot; style=&quot;width:300px;&quot; alt=&quot;4703.jpg&quot; class=&quot;image&quot; /&gt;
&lt;div class=&quot;scp-image-caption&quot; style=&quot;width:300px;&quot;&gt;
