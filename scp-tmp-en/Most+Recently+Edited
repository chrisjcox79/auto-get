&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/decibelles&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2005044&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606853685&quot; alt=&quot;Decibelles&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2005044)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/decibelles&quot;  &gt;Decibelles&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
