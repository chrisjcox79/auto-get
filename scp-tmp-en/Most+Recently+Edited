&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/noracodes&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1330723&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606551401&quot; alt=&quot;NoraCodes&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1330723)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/noracodes&quot;  &gt;NoraCodes&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
