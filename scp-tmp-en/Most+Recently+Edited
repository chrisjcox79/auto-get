&lt;li&gt;&lt;a href=&quot;javascript:;&quot;&gt;&lt;em&gt;&quot;M&#039;rj&#039;nz&quot;&lt;/em&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href=&quot;javascript:;&quot;&gt;&lt;em&gt;Maria Dracu&lt;/em&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href=&quot;javascript:;&quot;&gt;&lt;em&gt;Gibson&lt;/em&gt;&lt;/a&gt;&lt;/li&gt;
