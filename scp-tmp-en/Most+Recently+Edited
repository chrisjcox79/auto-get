&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/uraniumempire&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1613974&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606746174&quot; alt=&quot;UraniumEmpire&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1613974)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/uraniumempire&quot;  &gt;UraniumEmpire&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
