&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-114230-2&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;2&lt;/a&gt;. &lt;em&gt;Pan troglodytes.&lt;/em&gt;&lt;/div&gt;
&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-114230-3&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;3&lt;/a&gt;. &lt;em&gt;Mustela erminea.&lt;/em&gt;&lt;/div&gt;
&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-114230-4&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;4&lt;/a&gt;. &lt;em&gt;Margaritifera margaritifera&lt;/em&gt;&lt;/div&gt;
&lt;div class=&quot;footnote-footer&quot; id=&quot;footnote-114230-5&quot;&gt;&lt;a href=&quot;javascript:;&quot;  &gt;5&lt;/a&gt;. &lt;em&gt;Vipera berus.&lt;/em&gt;&lt;/div&gt;
&lt;/div&gt;
