&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/radioactiverads&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5053587&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607112303&quot; alt=&quot;RadioactiveRADS&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5053587)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/radioactiverads&quot;  &gt;RadioactiveRADS&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
