sible-block-content"> <div style="border: 1px solid #000;"> <div style="height: 100%;"> <div class="image-container aligncenter"><img src="http://orig07.deviantart.net/536b/f/2017/045/d/4/08___goat___scp_594_by_sunnyclockwork-daz1g6y.jpg" title="08 - Sheep/Goat - SCP-594 - Electric Sheep" alt="08 - Sheep/Goat - SCP-594 - Electric Sheep" width="400" class="image" /></div> </div> </div> </div> </div> </div> <h3><span>09 - Monkey - SCP-1000 - Bigfoot</span></h3> <div class="collapsible-block"> <div class="collapsible-block-folded"><a class="collapsible-block-link" href="javascript:;">+&nbsp;Show&nbsp;image</a></div> <div class="collapsible-block-unfolded" style="display:none"> <div class="collapsible-block-unfolded-link"><a class="collapsible-block-link" href="javascript:;">-&nbsp;Hide&nbsp;image</a></div> <div class="collapsible-block-content"> <div style="border: 1px solid #000;"> <div style="height: 100%;"> <div class="image-container aligncenter"><img src="http://orig09.deviantart.net/4848/f/2017/047/9/8/09___monkey___scp_1000_by_sunnyclockwork-daz9i90.jpg" title="09 - Monkey - SCP-1000 - Bigfoot" alt="09 - Monkey - SCP-1000 - Bigfoot" width="400" class="image" /></div> </div> </div> </div> </div> </div> <h3><span>10 - Rooster - SCP-1013 - Cockatrice</span></h3> <div class="collapsible-block"> <div class="collapsible-block-folded"><a class="collapsible-block-link" href="javascript:;">+&nbsp;Show&nbsp;image</a></div> <div class="collapsible-block-unfolded" style="display:none"> <div class="collapsible-block-unfolded-link"><a class="collapsible-block-link" href="javascript:;">-&nbsp;Hide&nbsp;image</a></div> <div class="collapsible-block-content"> <div style="border: 1px solid #000;"> <div style="height: 100%;"> <div class="image-container aligncenter"><img src="http://orig10.deviantart.net/6072/f/2017/045/2/a/10___rooster___scp_1013_by_sunnyclockwork-daz4tef.jpg" title="10 - Rooster - SCP-1013 - Cockatrice" alt="10 - Rooster - SCP-1013 - Cockatrice" width="400" class="image" /></div> </div> </div> </div> </div> </div> <h3><span>11 - Dog - SCP-023 - Black Shuck</span></h3> <div class="collapsible-block"> <div class="collapsible-block-folded"><a class="collapsible-block-link" href="javascript:;">+&nbsp;Show&nbsp;image</a></div> <div class="collapsible-block-unfolded" style="display:none"> <div class="collapsible-block-unfolded-link"><a class="collapsible-block-link" href="javascript:;">-&nbsp;Hide&nbsp;image</a></div> <div class="collapsible-block-content"> <div style="border: 1px solid #000;"> <div style="height: 100%;"> <div class="image-container aligncenter"><img src="http://orig13.deviantart.net/1e31/f/2017/039/0/5/11___dog___scp_023_by_sunnyclockwork-daybaoe.jpg" title="11 - Dog - SCP-023 - Black Shuck" alt="11 - Dog - SCP-023 - Black Shuck" width="400" class="image" /></div> </div> </div> </div> </div> </div> <h3><span>12 - Pig - SCP-2779 - Oinkers</span></h3> <div class="collapsible-block"> <div class="collapsible-block-folded"><a class="collapsible-block-link" href="javascript:;">+&nbsp;Show&nbsp;image</a></div> <div class="collapsible-block-unfolded" style="display:none"> <div class="collapsible-block-unfolded-link"><a class="collapsible-block-link" href="javascript:;">-&nbsp;Hide&nbsp;image</a></div> <div class="collapsible-block-content"> <div style="border: 1px solid #000;"> <div style="height: 100%;"> <div class="image-container aligncenter"><img src="http://orig12.deviantart.net/e95f/f/2017/053/6/6/12___pig___scp_2779_by_sunnyclockwork-dazz20h.jpg" title="12 - Pig - SCP-2779 - Oinkers" alt="12 - Pig - SCP-2779 - Oinkers" width="400" class="image" /></div> </div> </div> </div> </div> </div> <p><br /></p> <h3><span>MS Paint Cards (The Way It Ends, 3000, 3001, 3999, 4000)</span></h3> <div class="collapsible-block"> <div class="collapsible-block-folded"><a class="collapsible-block-link" href="javascript:;">+&nbsp;Show&nbsp;image</a></div> <div class="collapsible-block-unfolded" style="display:none"> <div class="collapsible-block-unfolded-link"><a class="collapsible-block-link" href="javascript:;">-&nbsp;Hide&nbsp;image</a></div> <div class="collapsible-block-content"> <div style="border: 1px solid #000;"> <div style="height: 100%;"> <div class="image-container aligncenter"><img src="https://images-wixmp-ed30a86b8c4ca887773594c2.wixmp.com/f/ec13709a-43f2-4b25-9089-5967ff8b5874/dds1hkz-a1435e14-6c53-498b-83c4-aa0e280eb0e7.jpg?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..HYTa-N-1ZPBsh8LHkUAQVGtS5TSA-3Oxslk6K92_75Y" title="MS Paint Cards (The Way It Ends, 3000, 3001, 3999, 4000)" alt="MS Paint Cards (The Way It Ends, 3000, 3001, 3999, 4000)" width="400" class="image" /></div> </div> </div> </div> </div> </div> <p>by <span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/sunnyclockwork" ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1621343&amp;amp;size=small&amp;amp;timestamp=1608173788" alt="SunnyClockwork" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1621343)" /></a><a href="http://www.wikidot.com/user:info/sunnyclockwork" >SunnyClockwork</a></span></p> 
