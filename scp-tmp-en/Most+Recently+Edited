&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lowell&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=197858&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606032184&quot; alt=&quot;Lowell&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=197858)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lowell&quot;  &gt;Lowell&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
