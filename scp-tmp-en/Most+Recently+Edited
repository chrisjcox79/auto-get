&lt;div style=&quot;text-align: right;&quot;&gt;&lt;/div&gt;
&lt;h1&gt;&lt;span&gt;INFORMATION AND BACKGROUND&lt;/span&gt;&lt;/h1&gt;

&lt;div id=&quot;wiki-tabview-25a21c843aeda7ace94d82ac06312d03&quot; class=&quot;yui-navset&quot;&gt;
