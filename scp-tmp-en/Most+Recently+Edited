&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-jacob-anderson&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7108837&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607523811&quot; alt=&quot;Dr Jacob Anderson&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7108837)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/dr-jacob-anderson&quot;  &gt;Dr Jacob Anderson&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
