&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/drecka&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3957744&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609057199&quot; alt=&quot;Drecka&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3957744)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/drecka&quot;  &gt;Drecka&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
