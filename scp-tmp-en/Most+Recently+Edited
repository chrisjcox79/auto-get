&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mistopheles&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5552305&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609057199&quot; alt=&quot;Mistopheles&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5552305)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mistopheles&quot;  &gt;Mistopheles&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
