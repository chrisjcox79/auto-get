&lt;p&gt;&amp;#171; &lt;a href=&quot;http://www.scpwiki.com/scp-2542&quot;&gt;SCP-2542&lt;/a&gt; | SCP-2543 | &lt;a href=&quot;http://www.scpwiki.com/scp-2544&quot;&gt;SCP-2544&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/rejekyll&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1225984&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606939558&quot; alt=&quot;Rejekyll&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1225984)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/rejekyll&quot;  &gt;Rejekyll&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
