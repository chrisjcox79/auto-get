&lt;div class=&quot;collapsible-block-content&quot;&gt;&lt;img src=&quot;https://66.media.tumblr.com/0a2a9b7b8db9264649f955f54be55505/tumblr_pzjxdvlQKi1tjbczoo1_1280.png&quot; alt=&quot;tumblr_pzjxdvlQKi1tjbczoo1_1280.png&quot; class=&quot;image&quot; /&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;/div&gt;
