&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/astronautjoe&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1372964&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609556998&quot; alt=&quot;AstronautJoe&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1372964)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/astronautjoe&quot;  &gt;AstronautJoe&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
