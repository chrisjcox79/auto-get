&lt;li&gt;&lt;a href=&quot;javascript:;&quot;&gt;&lt;em&gt;REVERSE (Wren Masterson)&lt;/em&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href=&quot;javascript:;&quot;&gt;&lt;em&gt;FORWARD (Penelope Gore)&lt;/em&gt;&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href=&quot;javascript:;&quot;&gt;&lt;em&gt;SHUFFLE (???)&lt;/em&gt;&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
