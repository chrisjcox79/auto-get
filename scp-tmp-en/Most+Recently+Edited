&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:100px; margin-top: 1.2em;&quot;&gt;&lt;span style=&quot;color:white&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/scp-5346/forrestgump.jpg&quot; style=&quot;width:100px;&quot; alt=&quot;forrestgump.jpg&quot; class=&quot;image&quot; /&gt;&lt;/span&gt;
