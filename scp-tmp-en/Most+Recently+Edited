&lt;td&gt;&amp;quot;pulp ficktion&amp;quot;&lt;/td&gt;
&lt;td&gt;&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/gabriel-jade&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=414239&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609124839&quot; alt=&quot;Gabriel Jade&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=414239)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/gabriel-jade&quot;  &gt;Gabriel Jade&lt;/a&gt;&lt;/span&gt;&lt;/td&gt;
