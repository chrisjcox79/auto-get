&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/the-great-hippo&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3938622&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606833425&quot; alt=&quot;The Great Hippo&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3938622)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/the-great-hippo&quot;  &gt;The Great Hippo&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
