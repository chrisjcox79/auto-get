&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;span style=&quot;font-size:20px;&quot;&gt;&lt;strong&gt;&lt;span style=&quot;text-decoration: underline;&quot;&gt;SCPs:&lt;/span&gt;&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
