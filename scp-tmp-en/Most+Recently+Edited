&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ihp&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1267048&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606185837&quot; alt=&quot;Ihp&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1267048)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ihp&quot;  &gt;Ihp&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
