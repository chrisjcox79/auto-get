&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/jim-north&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2191727&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609038821&quot; alt=&quot;Jim North&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2191727)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/jim-north&quot;  &gt;Jim North&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
