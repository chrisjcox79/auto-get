&lt;p&gt;Thanks to &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/absentmindednihilist&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2812984&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609014705&quot; alt=&quot;AbsentmindedNihilist&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2812984)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/absentmindednihilist&quot;  &gt;AbsentmindedNihilist&lt;/a&gt;&lt;/span&gt;, anqxr and &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lex1nat0r&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2172650&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609014705&quot; alt=&quot;Lex1nat0r&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2172650)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lex1nat0r&quot;  &gt;Lex1nat0r&lt;/a&gt;&lt;/span&gt;.&lt;/p&gt;
