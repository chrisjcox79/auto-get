&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sinceredoomguy&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5933532&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605902647&quot; alt=&quot;SincereDoomguy&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5933532)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sinceredoomguy&quot;  &gt;SincereDoomguy&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
