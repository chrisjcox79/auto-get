&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lordstonefish&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2527320&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608001032&quot; alt=&quot;LordStonefish&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2527320)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lordstonefish&quot;  &gt;LordStonefish&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
