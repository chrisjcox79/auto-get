&lt;tr&gt;
&lt;td colspan=&quot;2&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--files/dr-light-s-personnel-file/LdTct.jpg&quot; width=&quot;300px&quot; alt=&quot;LdTct.jpg&quot; class=&quot;image&quot; /&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
