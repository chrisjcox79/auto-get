&lt;td&gt;&lt;span style=&quot;color: red&quot;&gt;&lt;strong&gt;Denied&lt;/strong&gt;&lt;/span&gt;&lt;sup class=&quot;footnoteref&quot;&gt;&lt;a id=&quot;footnoteref-595722-4&quot; href=&quot;javascript:;&quot; class=&quot;footnoteref&quot;  &gt;4&lt;/a&gt;&lt;/sup&gt;&lt;/td&gt;
