&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&amp;#171; &lt;a class=&quot;newpage&quot; href=&quot;http://www.scpwiki.com/scp-5761&quot;&gt;SCP-5761&lt;/a&gt; | SCP-5762 | &lt;a class=&quot;newpage&quot; href=&quot;http://www.scpwiki.com/scp-5763&quot;&gt;SCP-5763&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/rounderhouse&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4187885&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606810745&quot; alt=&quot;Rounderhouse&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4187885)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/rounderhouse&quot;  &gt;Rounderhouse&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
