&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cerastes&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3352053&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606359015&quot; alt=&quot;Cerastes&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3352053)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cerastes&quot;  &gt;Cerastes&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
