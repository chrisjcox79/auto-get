&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/eskobar&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=1173523&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608733534&quot; alt=&quot;Eskobar&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=1173523)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/eskobar&quot;  &gt;Eskobar&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
