&lt;div class=&quot;scp-image-block block-right&quot; style=&quot;width:300px;&quot;&gt;&lt;img src=&quot;http://scp-wiki.wikidot.com/local--files/grigori-karpin-s-author-page/marker&quot; style=&quot;width:300px;&quot; alt=&quot;marker&quot; class=&quot;image&quot; /&gt;
