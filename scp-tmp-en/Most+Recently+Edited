&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sophia-light&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=306685&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607049795&quot; alt=&quot;Sophia Light&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=306685)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/sophia-light&quot;  &gt;Sophia Light&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
