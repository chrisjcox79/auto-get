&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/jackalrelated&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3207203&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605860224&quot; alt=&quot;JackalRelated&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3207203)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/jackalrelated&quot;  &gt;JackalRelated&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
