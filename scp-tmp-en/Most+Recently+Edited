&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/supposedly-spooky&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5529621&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608582168&quot; alt=&quot;Supposedly Spooky&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5529621)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/supposedly-spooky&quot;  &gt;Supposedly Spooky&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
