&lt;th style=&quot;border: 1px solid black; padding-left: 12px; padding-right: 12px; background-color: #FFFDF3&quot; colspan=&quot;1&quot;&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;p&gt;&lt;strong&gt;&lt;a href=&quot;http://scp-wiki.wikidot.com/the-significant-others-part-a&quot;&gt;Part &amp;quot;A&amp;quot;&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;
