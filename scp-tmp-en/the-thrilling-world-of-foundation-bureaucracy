				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/limeyy" onclick="WIKIDOT.page.listeners.userInfo(3533748); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=3533748&amp;amp;size=small&amp;amp;timestamp=1606056698" alt="Limeyy" style="background-image:url(http://www.wikidot.com/userkarma.php?u=3533748)"/></a><a href="http://www.wikidot.com/user:info/limeyy" onclick="WIKIDOT.page.listeners.userInfo(3533748); return false;" >Limeyy</a></span> <span class="odate time_1602280458 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">09 Oct 2020 21:54</span>
