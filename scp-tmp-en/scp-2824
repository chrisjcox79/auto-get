				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/soullesssingularity" onclick="WIKIDOT.page.listeners.userInfo(637830); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=637830&amp;amp;size=small&amp;amp;timestamp=1607028336" alt="SoullessSingularity" style="background-image:url(http://www.wikidot.com/userkarma.php?u=637830)"/></a><a href="http://www.wikidot.com/user:info/soullesssingularity" onclick="WIKIDOT.page.listeners.userInfo(637830); return false;" >SoullessSingularity</a></span> <span class="odate time_1458562559 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">21 Mar 2016 12:15</span>
