  for(var i = 0; i </span><span class="hl-brackets">&lt;</span><span class="hl-code"> </span><span class="hl-var">elm</span><span class="hl-code">.</span><span class="hl-var">length</span><span class="hl-code">; </span><span class="hl-var">i</span><span class="hl-code">++) {
