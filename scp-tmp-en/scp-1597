					<span class="printuser deleted" data-id="1313607"><img class="small" src="http://www.wikidot.com/common--images/avatars/default/a16.png" alt=""/>(account deleted)</span> <span class="odate time_1361849018 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">26 Feb 2013 03:23</span>
														</div>
