				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/jakdragonx" onclick="WIKIDOT.page.listeners.userInfo(5588260); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=5588260&amp;amp;size=small&amp;amp;timestamp=1605818723" alt="JakdragonX" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5588260)"/></a><a href="http://www.wikidot.com/user:info/jakdragonx" onclick="WIKIDOT.page.listeners.userInfo(5588260); return false;" >JakdragonX</a></span> <span class="odate time_1580258338 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">29 Jan 2020 00:38</span>
