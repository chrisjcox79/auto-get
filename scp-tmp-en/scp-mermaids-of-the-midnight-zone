				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/nagiros" onclick="WIKIDOT.page.listeners.userInfo(4665703); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=4665703&amp;amp;size=small&amp;amp;timestamp=1608130608" alt="Nagiros" style="background-image:url(http://www.wikidot.com/userkarma.php?u=4665703)"/></a><a href="http://www.wikidot.com/user:info/nagiros" onclick="WIKIDOT.page.listeners.userInfo(4665703); return false;" >Nagiros</a></span> <span class="odate time_1607996042 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">15 Dec 2020 01:34</span>
														</div>
