					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/duganist" onclick="WIKIDOT.page.listeners.userInfo(7085155); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7085155&amp;amp;size=small&amp;amp;timestamp=1607158693" alt="Duganist" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7085155)"/></a><a href="http://www.wikidot.com/user:info/duganist" onclick="WIKIDOT.page.listeners.userInfo(7085155); return false;" >Duganist</a></span> <span class="odate time_1607098868 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">04 Dec 2020 16:21</span>
														</div>
