					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/flopmind" onclick="WIKIDOT.page.listeners.userInfo(6407594); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6407594&amp;amp;size=small&amp;amp;timestamp=1607954917" alt="Flopmind" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6407594)"/></a><a href="http://www.wikidot.com/user:info/flopmind" onclick="WIKIDOT.page.listeners.userInfo(6407594); return false;" >Flopmind</a></span> <span class="odate time_1596666975 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">05 Aug 2020 22:36</span>
														</div>
