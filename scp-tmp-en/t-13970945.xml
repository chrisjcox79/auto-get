				<title>Re: Username Hyperlink</title>
				<link>http://www.scpwiki.com/forum/t-13970945/username-hyperlink#post-4863123</link>
				<description></description>
				<pubDate>Tue, 05 Jan 2021 19:43:19 +0000</pubDate>
				<wikidot:authorName>Nagiros</wikidot:authorName>				<wikidot:authorUserId>4665703</wikidot:authorUserId>				<content:encoded>
					<![CDATA[
						 <p>The syntax is <tt><span style="white-space: pre-wrap;">[[*user&#32;USERNAME]]</span></tt>. If you want it without the icon you can omit the *. <a href="https://www.wikidot.com/doc-wiki-syntax:users">Wikidot documentation is here.</a></p> 
				 	]]>
				</content:encoded>							</item>
