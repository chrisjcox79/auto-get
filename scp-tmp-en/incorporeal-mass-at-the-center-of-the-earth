					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/undercover-fly" onclick="WIKIDOT.page.listeners.userInfo(7107990); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7107990&amp;amp;size=small&amp;amp;timestamp=1609489140" alt="Undercover Fly" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7107990)"/></a><a href="http://www.wikidot.com/user:info/undercover-fly" onclick="WIKIDOT.page.listeners.userInfo(7107990); return false;" >Undercover Fly</a></span> <span class="odate time_1608937780 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">25 Dec 2020 23:09</span>
														</div>
