<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html id="html-block-html" xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"><head><meta http-equiv="Content-type" content="text/html; charset=utf-8"/><link rel="stylesheet" href="/common--theme/base/css/html-block.css"/></head><body>

<style>

.btn:focus {
  outline: 0;
}

.btn {
  background-color: Maroon;
  color: white;
  padding: 5px 10px;
  border: none;
  cursor: pointer;
  width: 70%;
  opacity: 0.9;
  transition: 0.09s;
  border-radius: 3px;
  transition 0.8s;
}

.btn:hover {
  opacity: 1;
  transition: 0.8s;
  box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.7);
}

.btn:active {
  transition: 0.09s;
  transform: translateY(1px);
  box-shadow: 0 0px 0px 0 rgba(0, 0, 0, 0);
}

.btn2 {
    background-color: white;
    border: none;
    cursor: pointer;

}

</style>

<script>
var tnum1 = 0;
var tnum2 = 0;
var tstring = "RADICAL!!!"

function eckhart()
{
   if(tnum2<tstring.length){
      tnum2++;
   }
   window.setTimeout(twait,1);
}

function twait(){
   document.getElementById("fakename").value= tstring.substring(tnum1, tnum2);
}
</script>
<h4>Please describe, in one word, the image above:</h4>
<div><textarea rows="1" style="width:70%;" id="fakename"  onkeyup="if(this.value.length > 7) document.getElementById('start_button').disabled = false; else document.getElementById('start_button').disabled = true;" onkeydown="eckhart()" wrap="hard">

</textarea> </div>
<script type="text/javascript" src="/common--javascript/html-block-iframe.js"></script></body></html>