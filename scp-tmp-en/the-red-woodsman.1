							<a class="options btn btn-default btn-mini btn-xs" href="javascript:;" onclick="togglePostFold(event,1324791)" c>Unfold</a>
						<a class="title" href="javascript:;" onclick="togglePostFold(event,1324791)"></a> by <span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/anaxagoras" onclick="WIKIDOT.page.listeners.userInfo(1019930); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1019930&amp;amp;size=small&amp;amp;timestamp=1608349750" alt="Anaxagoras" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1019930)"/></a><a href="http://www.wikidot.com/user:info/anaxagoras" onclick="WIKIDOT.page.listeners.userInfo(1019930); return false;" >Anaxagoras</a></span>, <span class="odate time_1323416419 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">09 Dec 2011 07:40</span>
