					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/lt-flops" onclick="WIKIDOT.page.listeners.userInfo(1735419); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1735419&amp;amp;size=small&amp;amp;timestamp=1606101156" alt="Lt Flops" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1735419)"/></a><a href="http://www.wikidot.com/user:info/lt-flops" onclick="WIKIDOT.page.listeners.userInfo(1735419); return false;" >Lt Flops</a></span> <span class="odate time_1523646344 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">13 Apr 2018 19:05</span>
														</div>
