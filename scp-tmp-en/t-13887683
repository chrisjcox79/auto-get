				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/ethanhanson" onclick="WIKIDOT.page.listeners.userInfo(4465845); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=4465845&amp;amp;size=small&amp;amp;timestamp=1607136688" alt="EthanHanson" style="background-image:url(http://www.wikidot.com/userkarma.php?u=4465845)"/></a><a href="http://www.wikidot.com/user:info/ethanhanson" onclick="WIKIDOT.page.listeners.userInfo(4465845); return false;" >EthanHanson</a></span> <span class="odate time_1606664610 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">29 Nov 2020 15:43</span>
