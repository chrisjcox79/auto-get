				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/kingyo" onclick="WIKIDOT.page.listeners.userInfo(7065632); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7065632&amp;amp;size=small&amp;amp;timestamp=1608909236" alt="Kingyo" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7065632)"/></a><a href="http://www.wikidot.com/user:info/kingyo" onclick="WIKIDOT.page.listeners.userInfo(7065632); return false;" >Kingyo</a></span> <span class="odate time_1608733983 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">23 Dec 2020 14:33</span>
														</div>
