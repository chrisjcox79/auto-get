				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/dr-balthazaar" onclick="WIKIDOT.page.listeners.userInfo(1468535); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1468535&amp;amp;size=small&amp;amp;timestamp=1607200947" alt="Dr Balthazaar" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1468535)"/></a><a href="http://www.wikidot.com/user:info/dr-balthazaar" onclick="WIKIDOT.page.listeners.userInfo(1468535); return false;" >Dr Balthazaar</a></span> <span class="odate time_1570428608 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">07 Oct 2019 06:10</span>
