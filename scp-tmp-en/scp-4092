					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/lxhauptmann" onclick="WIKIDOT.page.listeners.userInfo(1619532); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1619532&amp;amp;size=small&amp;amp;timestamp=1606834505" alt="LXHauptmann" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1619532)"/></a><a href="http://www.wikidot.com/user:info/lxhauptmann" onclick="WIKIDOT.page.listeners.userInfo(1619532); return false;" >LXHauptmann</a></span> <span class="odate time_1554430843 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">05 Apr 2019 02:20</span>
														</div>
