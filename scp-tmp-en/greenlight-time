					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/big-byrd" onclick="WIKIDOT.page.listeners.userInfo(7100464); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7100464&amp;amp;size=small&amp;amp;timestamp=1607416383" alt="Big Byrd" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7100464)"/></a><a href="http://www.wikidot.com/user:info/big-byrd" onclick="WIKIDOT.page.listeners.userInfo(7100464); return false;" >Big Byrd</a></span> <span class="odate time_1607381781 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">07 Dec 2020 22:56</span>
														</div>
