					<span class="printuser deleted" data-id="3122708"><img class="small" src="http://www.wikidot.com/common--images/avatars/default/a16.png" alt=""/>(account deleted)</span> <span class="odate time_1515642494 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">11 Jan 2018 03:48</span>
														</div>
