				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/manymeats" onclick="WIKIDOT.page.listeners.userInfo(2104082); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2104082&amp;amp;size=small&amp;amp;timestamp=1606162363" alt="ManyMeats" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2104082)"/></a><a href="http://www.wikidot.com/user:info/manymeats" onclick="WIKIDOT.page.listeners.userInfo(2104082); return false;" >ManyMeats</a></span> <span class="odate time_1606154806 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">23 Nov 2020 18:06</span>
														</div>
