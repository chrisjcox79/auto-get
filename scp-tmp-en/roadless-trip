					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/owltamer" onclick="WIKIDOT.page.listeners.userInfo(5409628); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=5409628&amp;amp;size=small&amp;amp;timestamp=1606056696" alt="Owltamer" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5409628)"/></a><a href="http://www.wikidot.com/user:info/owltamer" onclick="WIKIDOT.page.listeners.userInfo(5409628); return false;" >Owltamer</a></span> <span class="odate time_1605441247 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">15 Nov 2020 11:54</span>
