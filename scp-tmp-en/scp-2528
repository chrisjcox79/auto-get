					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/thamuzz" onclick="WIKIDOT.page.listeners.userInfo(830521); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=830521&amp;amp;size=small&amp;amp;timestamp=1607028239" alt="thamuzz" style="background-image:url(http://www.wikidot.com/userkarma.php?u=830521)"/></a><a href="http://www.wikidot.com/user:info/thamuzz" onclick="WIKIDOT.page.listeners.userInfo(830521); return false;" >thamuzz</a></span> <span class="odate time_1444769022 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">13 Oct 2015 20:43</span>
