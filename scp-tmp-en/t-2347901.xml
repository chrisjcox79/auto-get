					<item>
				<guid>http://www.scpwiki.com/forum/t-2347901#post-2885020</guid>
				<title>(no title)</title>
				<link>http://www.scpwiki.com/forum/t-2347901/scp-foundation#post-2885020</link>
				<description></description>
