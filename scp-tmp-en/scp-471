					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/drsevere" onclick="WIKIDOT.page.listeners.userInfo(511038); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=511038&amp;amp;size=small&amp;amp;timestamp=1608844051" alt="DrSevere" style="background-image:url(http://www.wikidot.com/userkarma.php?u=511038)"/></a><a href="http://www.wikidot.com/user:info/drsevere" onclick="WIKIDOT.page.listeners.userInfo(511038); return false;" >DrSevere</a></span> <span class="odate time_1291773259 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">08 Dec 2010 01:54</span>
														</div>
