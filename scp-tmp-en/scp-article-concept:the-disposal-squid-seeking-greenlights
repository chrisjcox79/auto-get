															</div>
				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/dantheuser" onclick="WIKIDOT.page.listeners.userInfo(6984249); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6984249&amp;amp;size=small&amp;amp;timestamp=1605818719" alt="dantheuser" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6984249)"/></a><a href="http://www.wikidot.com/user:info/dantheuser" onclick="WIKIDOT.page.listeners.userInfo(6984249); return false;" >dantheuser</a></span> <span class="odate time_1604515451 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">04 Nov 2020 18:44</span>
														</div>
