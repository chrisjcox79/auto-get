					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/w-asriel" onclick="WIKIDOT.page.listeners.userInfo(3317001); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=3317001&amp;amp;size=small&amp;amp;timestamp=1606834586" alt="W Asriel" style="background-image:url(http://www.wikidot.com/userkarma.php?u=3317001)"/></a><a href="http://www.wikidot.com/user:info/w-asriel" onclick="WIKIDOT.page.listeners.userInfo(3317001); return false;" >W Asriel</a></span> <span class="odate time_1533052877 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">31 Jul 2018 16:01</span>
														</div>
