<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/hueyacuetzpali" onclick="WIKIDOT.page.listeners.userInfo(3309216); return false;"><img class="small" src="http://www.wikidot.com/avatar.php?userid=3309216&amp;amp;size=small&amp;amp;timestamp=1558462914" alt="Hueyacuetzpali" style="background-image:url(http://www.wikidot.com/userkarma.php?u=3309216)" /></a><a href="http://www.wikidot.com/user:info/hueyacuetzpali" onclick="WIKIDOT.page.listeners.userInfo(3309216); return false;">Hueyacuetzpali</a></span><br />
