    <div class="post-container" id="fpc-2169790">
                      
		<div class="post" id="post-2169790">
		<div class="long">
			<div class="head">
									<div class="options">
						<a href="javascript:;" onclick="togglePostFold(event,2169790)" class="btn btn-default btn-small btn-sm">Fold</a>
