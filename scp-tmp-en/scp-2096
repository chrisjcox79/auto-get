					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/dillinger-phd" onclick="WIKIDOT.page.listeners.userInfo(2005876); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2005876&amp;amp;size=small&amp;amp;timestamp=1606142619" alt="Dillinger PhD" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2005876)"/></a><a href="http://www.wikidot.com/user:info/dillinger-phd" onclick="WIKIDOT.page.listeners.userInfo(2005876); return false;" >Dillinger PhD</a></span> <span class="odate time_1421255735 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">14 Jan 2015 17:15</span>
														</div>
