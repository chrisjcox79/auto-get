				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/quadraginta" onclick="WIKIDOT.page.listeners.userInfo(6391595); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6391595&amp;amp;size=small&amp;amp;timestamp=1606247710" alt="Quadraginta" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6391595)"/></a><a href="http://www.wikidot.com/user:info/quadraginta" onclick="WIKIDOT.page.listeners.userInfo(6391595); return false;" >Quadraginta</a></span> <span class="odate time_1606167278 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">23 Nov 2020 21:34</span>
														</div>
