					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/moukerr" onclick="WIKIDOT.page.listeners.userInfo(4093821); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=4093821&amp;amp;size=small&amp;amp;timestamp=1606105603" alt="Moukerr" style="background-image:url(http://www.wikidot.com/userkarma.php?u=4093821)"/></a><a href="http://www.wikidot.com/user:info/moukerr" onclick="WIKIDOT.page.listeners.userInfo(4093821); return false;" >Moukerr</a></span> <span class="odate time_1605552037 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">16 Nov 2020 18:40</span>
														</div>
