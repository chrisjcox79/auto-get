				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/woedenaz" onclick="WIKIDOT.page.listeners.userInfo(1404096); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1404096&amp;amp;size=small&amp;amp;timestamp=1608238105" alt="Woedenaz" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1404096)"/></a><a href="http://www.wikidot.com/user:info/woedenaz" onclick="WIKIDOT.page.listeners.userInfo(1404096); return false;" >Woedenaz</a></span> <span class="odate time_1595527428 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">23 Jul 2020 18:03</span>
