				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/whirlpool-0" onclick="WIKIDOT.page.listeners.userInfo(3434518); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=3434518&amp;amp;size=small&amp;amp;timestamp=1606269050" alt="whirlpool_0" style="background-image:url(http://www.wikidot.com/userkarma.php?u=3434518)"/></a><a href="http://www.wikidot.com/user:info/whirlpool-0" onclick="WIKIDOT.page.listeners.userInfo(3434518); return false;" >whirlpool_0</a></span> <span class="odate time_1605395169 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">14 Nov 2020 23:06</span>
														</div>
