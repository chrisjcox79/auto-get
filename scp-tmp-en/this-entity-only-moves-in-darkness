															</div>
				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/ragewhatle17" onclick="WIKIDOT.page.listeners.userInfo(7008149); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7008149&amp;amp;size=small&amp;amp;timestamp=1606141043" alt="ragewhatle17" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7008149)"/></a><a href="http://www.wikidot.com/user:info/ragewhatle17" onclick="WIKIDOT.page.listeners.userInfo(7008149); return false;" >ragewhatle17</a></span> <span class="odate time_1606134894 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">23 Nov 2020 12:34</span>
														</div>
