					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/adam-smascher" onclick="WIKIDOT.page.listeners.userInfo(587467); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=587467&amp;amp;size=small&amp;amp;timestamp=1605988453" alt="Adam Smascher" style="background-image:url(http://www.wikidot.com/userkarma.php?u=587467)"/></a><a href="http://www.wikidot.com/user:info/adam-smascher" onclick="WIKIDOT.page.listeners.userInfo(587467); return false;" >Adam Smascher</a></span> <span class="odate time_1300583663 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">20 Mar 2011 01:14</span>
														</div>
