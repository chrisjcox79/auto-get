					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/lt-flops" onclick="WIKIDOT.page.listeners.userInfo(1735419); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1735419&amp;amp;size=small&amp;amp;timestamp=1607200970" alt="Lt Flops" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1735419)"/></a><a href="http://www.wikidot.com/user:info/lt-flops" onclick="WIKIDOT.page.listeners.userInfo(1735419); return false;" >Lt Flops</a></span> <span class="odate time_1568516850 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">15 Sep 2019 03:07</span>
