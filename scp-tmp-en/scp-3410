					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/mayoculpa" onclick="WIKIDOT.page.listeners.userInfo(3489662); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=3489662&amp;amp;size=small&amp;amp;timestamp=1605861586" alt="mayoculpa" style="background-image:url(http://www.wikidot.com/userkarma.php?u=3489662)"/></a><a href="http://www.wikidot.com/user:info/mayoculpa" onclick="WIKIDOT.page.listeners.userInfo(3489662); return false;" >mayoculpa</a></span> <span class="odate time_1515459350 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">09 Jan 2018 00:55</span>
