					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/warpzone" onclick="WIKIDOT.page.listeners.userInfo(147364); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=147364&amp;amp;size=small&amp;amp;timestamp=1607546932" alt="WarpZone" style="background-image:url(http://www.wikidot.com/userkarma.php?u=147364)"/></a><a href="http://www.wikidot.com/user:info/warpzone" onclick="WIKIDOT.page.listeners.userInfo(147364); return false;" >WarpZone</a></span> <span class="odate time_1385298571 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">24 Nov 2013 13:09</span>
