					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/monteparnas" onclick="WIKIDOT.page.listeners.userInfo(2926286); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2926286&amp;amp;size=small&amp;amp;timestamp=1606401834" alt="Monteparnas" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2926286)"/></a><a href="http://www.wikidot.com/user:info/monteparnas" onclick="WIKIDOT.page.listeners.userInfo(2926286); return false;" >Monteparnas</a></span> <span class="odate time_1525406201 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">04 May 2018 03:56</span>
														</div>
