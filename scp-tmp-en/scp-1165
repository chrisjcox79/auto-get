					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/khym-chanur" onclick="WIKIDOT.page.listeners.userInfo(163438); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=163438&amp;amp;size=small&amp;amp;timestamp=1608454208" alt="Khym Chanur" style="background-image:url(http://www.wikidot.com/userkarma.php?u=163438)"/></a><a href="http://www.wikidot.com/user:info/khym-chanur" onclick="WIKIDOT.page.listeners.userInfo(163438); return false;" >Khym Chanur</a></span> <span class="odate time_1334710281 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">18 Apr 2012 00:51</span>
														</div>
