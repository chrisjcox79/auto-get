				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/cwazzycwafter" onclick="WIKIDOT.page.listeners.userInfo(6179009); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6179009&amp;amp;size=small&amp;amp;timestamp=1610032925" alt="cwazzycwafter" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6179009)"/></a><a href="http://www.wikidot.com/user:info/cwazzycwafter" onclick="WIKIDOT.page.listeners.userInfo(6179009); return false;" >cwazzycwafter</a></span> <span class="odate time_1608367438 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">19 Dec 2020 08:43</span>
														</div>
