				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/mic4u" onclick="WIKIDOT.page.listeners.userInfo(7191085); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7191085&amp;amp;size=small&amp;amp;timestamp=1610117187" alt="Mic4u" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7191085)"/></a><a href="http://www.wikidot.com/user:info/mic4u" onclick="WIKIDOT.page.listeners.userInfo(7191085); return false;" >Mic4u</a></span> <span class="odate time_1610022536 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">07 Jan 2021 12:28</span>
