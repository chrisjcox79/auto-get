					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/psul" onclick="WIKIDOT.page.listeners.userInfo(2156983); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2156983&amp;amp;size=small&amp;amp;timestamp=1606163906" alt="psul" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2156983)"/></a><a href="http://www.wikidot.com/user:info/psul" onclick="WIKIDOT.page.listeners.userInfo(2156983); return false;" >psul</a></span> <span class="odate time_1447750947 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">17 Nov 2015 09:02</span>
														</div>
