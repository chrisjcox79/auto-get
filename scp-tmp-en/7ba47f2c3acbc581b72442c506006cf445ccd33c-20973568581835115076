<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html id="html-block-html" xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"><head><meta http-equiv="Content-type" content="text/html; charset=utf-8"/><link rel="stylesheet" href="/common--theme/base/css/html-block.css"/></head><body>
<!doctype html>

<html>
<head>
    <style>
        #body {
            background-color: black;
            background-image: radial-gradient(rgba(150, 150, 150, 0.75), black 120%);
            height: initial;
            margin: 0;
            padding: 2rem;
            color: white; 
            text-shadow: 0 0 5px #C8C8C8;
        }

        #body::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.15) 1px, transparent 1px, transparent 2px);
            pointer-events: none;
        }

        ::selection {
            background: #0080FF;
            text-shadow: none;
        }

        pre {
            font-family: 'm-1m', monospace;
            font-size: 0.75em;
            line-height: 1.25em;
            margin: 0;
            white-space: pre-wrap;
        }  

        pre .block {
            padding: 1rem;
            display: inline-block;
            border: 1px solid #fff;
            margin: 0;
        }
    </style>
    <script src="//use.edgefonts.net/m-1m.js"></script>
</head>

<body>
    <div id="body">
        <pre><output>>> Revenge selected.
</output></pre>
    </div>
<script type="text/javascript" src="/common--javascript/html-block-iframe.js"></script></body>

</html>
<script type="text/javascript" src="/common--javascript/html-block-iframe.js"></script></body></html>