					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/mszegedy" onclick="WIKIDOT.page.listeners.userInfo(5149774); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=5149774&amp;amp;size=small&amp;amp;timestamp=1608238090" alt="mszegedy" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5149774)"/></a><a href="http://www.wikidot.com/user:info/mszegedy" onclick="WIKIDOT.page.listeners.userInfo(5149774); return false;" >mszegedy</a></span> <span class="odate time_1605606281 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">17 Nov 2020 09:44</span>
