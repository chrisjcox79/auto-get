					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/drakimoto" onclick="WIKIDOT.page.listeners.userInfo(5255688); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=5255688&amp;amp;size=small&amp;amp;timestamp=1606834328" alt="DrAkimoto" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5255688)"/></a><a href="http://www.wikidot.com/user:info/drakimoto" onclick="WIKIDOT.page.listeners.userInfo(5255688); return false;" >DrAkimoto</a></span> <span class="odate time_1597668279 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">17 Aug 2020 12:44</span>
														</div>
