					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/the-squip" onclick="WIKIDOT.page.listeners.userInfo(5233038); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=5233038&amp;amp;size=small&amp;amp;timestamp=1607825383" alt="the SQUIP" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5233038)"/></a><a href="http://www.wikidot.com/user:info/the-squip" onclick="WIKIDOT.page.listeners.userInfo(5233038); return false;" >the SQUIP</a></span> <span class="odate time_1607589060 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">10 Dec 2020 08:31</span>
														</div>
