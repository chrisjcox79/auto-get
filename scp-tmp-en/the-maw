				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/a-a-slate" onclick="WIKIDOT.page.listeners.userInfo(7113175); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7113175&amp;amp;size=small&amp;amp;timestamp=1608195054" alt="A A Slate" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7113175)"/></a><a href="http://www.wikidot.com/user:info/a-a-slate" onclick="WIKIDOT.page.listeners.userInfo(7113175); return false;" >A A Slate</a></span> <span class="odate time_1607974573 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">14 Dec 2020 19:36</span>
														</div>
