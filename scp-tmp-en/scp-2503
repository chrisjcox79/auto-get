					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/kalinin" onclick="WIKIDOT.page.listeners.userInfo(2203795); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2203795&amp;amp;size=small&amp;amp;timestamp=1606274157" alt="Kalinin" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2203795)"/></a><a href="http://www.wikidot.com/user:info/kalinin" onclick="WIKIDOT.page.listeners.userInfo(2203795); return false;" >Kalinin</a></span> <span class="odate time_1442956708 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">22 Sep 2015 21:18</span>
