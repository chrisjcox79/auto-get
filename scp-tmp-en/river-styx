				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/wigglerwizard" onclick="WIKIDOT.page.listeners.userInfo(6223351); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6223351&amp;amp;size=small&amp;amp;timestamp=1606075006" alt="_WigglerWizard_" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6223351)"/></a><a href="http://www.wikidot.com/user:info/wigglerwizard" onclick="WIKIDOT.page.listeners.userInfo(6223351); return false;" >_WigglerWizard_</a></span> <span class="odate time_1606000228 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">21 Nov 2020 23:10</span>
