					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/the-great-hippo" onclick="WIKIDOT.page.listeners.userInfo(3938622); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=3938622&amp;amp;size=small&amp;amp;timestamp=1605795276" alt="The Great Hippo" style="background-image:url(http://www.wikidot.com/userkarma.php?u=3938622)"/></a><a href="http://www.wikidot.com/user:info/the-great-hippo" onclick="WIKIDOT.page.listeners.userInfo(3938622); return false;" >The Great Hippo</a></span> <span class="odate time_1560130951 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">10 Jun 2019 01:42</span>
														</div>
