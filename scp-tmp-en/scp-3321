				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/xyteran" onclick="WIKIDOT.page.listeners.userInfo(3491952); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=3491952&amp;amp;size=small&amp;amp;timestamp=1606447240" alt="Xyteran" style="background-image:url(http://www.wikidot.com/userkarma.php?u=3491952)"/></a><a href="http://www.wikidot.com/user:info/xyteran" onclick="WIKIDOT.page.listeners.userInfo(3491952); return false;" >Xyteran</a></span> <span class="odate time_1516617848 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">22 Jan 2018 10:44</span>
														</div>
