					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/ooblex" onclick="WIKIDOT.page.listeners.userInfo(2164005); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2164005&amp;amp;size=small&amp;amp;timestamp=1606142895" alt="ooblex" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2164005)"/></a><a href="http://www.wikidot.com/user:info/ooblex" onclick="WIKIDOT.page.listeners.userInfo(2164005); return false;" >ooblex</a></span> <span class="odate time_1435870849 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">02 Jul 2015 21:00</span>
