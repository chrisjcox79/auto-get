				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/dr-kostyankyn" onclick="WIKIDOT.page.listeners.userInfo(2212296); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2212296&amp;amp;size=small&amp;amp;timestamp=1609146300" alt="Dr Kostyankyn" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2212296)"/></a><a href="http://www.wikidot.com/user:info/dr-kostyankyn" onclick="WIKIDOT.page.listeners.userInfo(2212296); return false;" >Dr Kostyankyn</a></span> <span class="odate time_1455271104 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">12 Feb 2016 09:58</span>
