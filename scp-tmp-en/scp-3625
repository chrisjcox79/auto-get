					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/blackmagicfine" onclick="WIKIDOT.page.listeners.userInfo(3357293); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=3357293&amp;amp;size=small&amp;amp;timestamp=1606920957" alt="BlackMagicFine" style="background-image:url(http://www.wikidot.com/userkarma.php?u=3357293)"/></a><a href="http://www.wikidot.com/user:info/blackmagicfine" onclick="WIKIDOT.page.listeners.userInfo(3357293); return false;" >BlackMagicFine</a></span> <span class="odate time_1529735388 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">23 Jun 2018 06:29</span>
														</div>
