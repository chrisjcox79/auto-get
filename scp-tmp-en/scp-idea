				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/thesilentking" onclick="WIKIDOT.page.listeners.userInfo(2182264); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2182264&amp;amp;size=small&amp;amp;timestamp=1606749135" alt="thesilentking" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2182264)"/></a><a href="http://www.wikidot.com/user:info/thesilentking" onclick="WIKIDOT.page.listeners.userInfo(2182264); return false;" >thesilentking</a></span> <span class="odate time_1586820156 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">13 Apr 2020 23:22</span>
														</div>
