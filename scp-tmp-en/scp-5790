				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/gee0765" onclick="WIKIDOT.page.listeners.userInfo(5376871); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=5376871&amp;amp;size=small&amp;amp;timestamp=1606834419" alt="gee0765" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5376871)"/></a><a href="http://www.wikidot.com/user:info/gee0765" onclick="WIKIDOT.page.listeners.userInfo(5376871); return false;" >gee0765</a></span> <span class="odate time_1579032194 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">14 Jan 2020 20:03</span>
														</div>
