<script type="text/javascript">
window.onload = function() { 
  var today = new Date();
  var dd = today.getDate();
  var mm = today.getMonth()+1; //January is 0!
  var yyyy = today.getFullYear();

  if(dd<10) {
    dd = '0'+dd
  } 

  if (mm<10) {
    mm = '0'+mm
  } 

  today = mm + '/' + dd + '/' + yyyy;
  inayear = '04/07/' + (yyyy + 1);
  document.getElementById('currentdate').innerHTML = today;
  document.getElementById('inayear').innerHTML = inayear.
};
</script>
<p><i>Note: As of <span id="currentdate">03/20/2018</span>, SCP-3485 has not moved from its location. Based off of previous analysis of SCP-3485, it will starve itself to death on <span id="inayear">04/07/2019</span>. At this point, SCP-3485 will be reclassified as "Neutralized".</i></p>
