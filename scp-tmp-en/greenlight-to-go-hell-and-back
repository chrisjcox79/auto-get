				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/ebonbonb" onclick="WIKIDOT.page.listeners.userInfo(6742891); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6742891&amp;amp;size=small&amp;amp;timestamp=1605921704" alt="ebonbonb" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6742891)"/></a><a href="http://www.wikidot.com/user:info/ebonbonb" onclick="WIKIDOT.page.listeners.userInfo(6742891); return false;" >ebonbonb</a></span> <span class="odate time_1604650060 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">06 Nov 2020 08:07</span>
														</div>
