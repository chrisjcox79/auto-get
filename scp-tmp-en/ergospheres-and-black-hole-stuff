				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/callumf" onclick="WIKIDOT.page.listeners.userInfo(6861267); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6861267&amp;amp;size=small&amp;amp;timestamp=1605970392" alt="CallumF" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6861267)"/></a><a href="http://www.wikidot.com/user:info/callumf" onclick="WIKIDOT.page.listeners.userInfo(6861267); return false;" >CallumF</a></span> <span class="odate time_1600779235 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">22 Sep 2020 12:53</span>
														</div>
