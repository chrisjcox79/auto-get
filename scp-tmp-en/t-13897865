				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/ethanhanson" onclick="WIKIDOT.page.listeners.userInfo(4465845); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=4465845&amp;amp;size=small&amp;amp;timestamp=1607398652" alt="EthanHanson" style="background-image:url(http://www.wikidot.com/userkarma.php?u=4465845)"/></a><a href="http://www.wikidot.com/user:info/ethanhanson" onclick="WIKIDOT.page.listeners.userInfo(4465845); return false;" >EthanHanson</a></span> <span class="odate time_1607395492 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">08 Dec 2020 02:44</span>
														</div>
