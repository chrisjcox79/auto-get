				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/luther-crackenthorpe" onclick="WIKIDOT.page.listeners.userInfo(2774364); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2774364&amp;amp;size=small&amp;amp;timestamp=1607849600" alt="Luther Crackenthorpe" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2774364)"/></a><a href="http://www.wikidot.com/user:info/luther-crackenthorpe" onclick="WIKIDOT.page.listeners.userInfo(2774364); return false;" >Luther Crackenthorpe</a></span> <span class="odate time_1489100193 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">09 Mar 2017 22:56</span>
