				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/cloudncali" onclick="WIKIDOT.page.listeners.userInfo(552309); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=552309&amp;amp;size=small&amp;amp;timestamp=1607504850" alt="cloudncali" style="background-image:url(http://www.wikidot.com/userkarma.php?u=552309)"/></a><a href="http://www.wikidot.com/user:info/cloudncali" onclick="WIKIDOT.page.listeners.userInfo(552309); return false;" >cloudncali</a></span> <span class="odate time_1607057823 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">04 Dec 2020 04:57</span>
