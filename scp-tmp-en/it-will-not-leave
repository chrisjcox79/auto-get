					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/tordzak" onclick="WIKIDOT.page.listeners.userInfo(7073878); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=7073878&amp;amp;size=small&amp;amp;timestamp=1607221448" alt="tordzak" style="background-image:url(http://www.wikidot.com/userkarma.php?u=7073878)"/></a><a href="http://www.wikidot.com/user:info/tordzak" onclick="WIKIDOT.page.listeners.userInfo(7073878); return false;" >tordzak</a></span> <span class="odate time_1606854841 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">01 Dec 2020 20:34</span>
