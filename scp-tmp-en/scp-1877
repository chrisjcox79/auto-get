				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/silberescher" onclick="WIKIDOT.page.listeners.userInfo(304355); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=304355&amp;amp;size=small&amp;amp;timestamp=1607179822" alt="Silberescher" style="background-image:url(http://www.wikidot.com/userkarma.php?u=304355)"/></a><a href="http://www.wikidot.com/user:info/silberescher" onclick="WIKIDOT.page.listeners.userInfo(304355); return false;" >Silberescher</a></span> <span class="odate time_1358883776 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">22 Jan 2013 19:42</span>
