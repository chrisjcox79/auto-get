					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/vianegativa" onclick="WIKIDOT.page.listeners.userInfo(1355742); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1355742&amp;amp;size=small&amp;amp;timestamp=1607352964" alt="ViaNegativa" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1355742)"/></a><a href="http://www.wikidot.com/user:info/vianegativa" onclick="WIKIDOT.page.listeners.userInfo(1355742); return false;" >ViaNegativa</a></span> <span class="odate time_1494090593 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">06 May 2017 17:09</span>
														</div>
