				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/lraziel1" onclick="WIKIDOT.page.listeners.userInfo(2034342); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=2034342&amp;amp;size=small&amp;amp;timestamp=1609945978" alt="lRaziel1" style="background-image:url(http://www.wikidot.com/userkarma.php?u=2034342)"/></a><a href="http://www.wikidot.com/user:info/lraziel1" onclick="WIKIDOT.page.listeners.userInfo(2034342); return false;" >lRaziel1</a></span> <span class="odate time_1587808689 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">25 Apr 2020 09:58</span>
														</div>
