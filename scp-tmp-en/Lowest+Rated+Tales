&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/canofsoup&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=5931046&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607979344&quot; alt=&quot;CanOfSoup&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=5931046)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/canofsoup&quot;  &gt;CanOfSoup&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
