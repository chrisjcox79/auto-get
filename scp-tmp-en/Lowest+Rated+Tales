&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/drdromeus&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3785128&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607979343&quot; alt=&quot;DrDromeus&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3785128)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/drdromeus&quot;  &gt;DrDromeus&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
