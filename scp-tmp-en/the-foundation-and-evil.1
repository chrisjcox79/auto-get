					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/dr-voss" onclick="WIKIDOT.page.listeners.userInfo(289730); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=289730&amp;amp;size=small&amp;amp;timestamp=1605818411" alt="Dr Voss" style="background-image:url(http://www.wikidot.com/userkarma.php?u=289730)"/></a><a href="http://www.wikidot.com/user:info/dr-voss" onclick="WIKIDOT.page.listeners.userInfo(289730); return false;" >Dr Voss</a></span> <span class="odate time_1237907066 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">24 Mar 2009 15:04</span>
														</div>
			</div>
