atar.php?userid=5884163&amp;amp;size=small&amp;amp;timestamp=1606306818" alt="Jakob17" style="background-image:url(http://www.wikidot.com/userkarma.php?u=5884163)" /></a><a href="http://www.wikidot.com/user:info/jakob17" onclick="WIKIDOT.page.listeners.userInfo(5884163); return false;">Jakob17</a></span>, and <span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/researcher-brayan" onclick="WIKIDOT.page.listeners.userInfo(6817237); return false;"><img class="small" src="http://www.wikidot.com/avatar.php?userid=6817237&amp;amp;size=small&amp;amp;timestamp=1606306818" alt="Researcher Brayan" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6817237)" /></a><a href="http://www.wikidot.com/user:info/researcher-brayan" onclick="WIKIDOT.page.listeners.userInfo(6817237); return false;">Researcher Brayan</a></span></p>
