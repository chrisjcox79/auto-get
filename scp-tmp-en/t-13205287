					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/refractorynautilus" onclick="WIKIDOT.page.listeners.userInfo(6030544); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6030544&amp;amp;size=small&amp;amp;timestamp=1609060066" alt="RefractoryNautilus" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6030544)"/></a><a href="http://www.wikidot.com/user:info/refractorynautilus" onclick="WIKIDOT.page.listeners.userInfo(6030544); return false;" >RefractoryNautilus</a></span> <span class="odate time_1585891541 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">03 Apr 2020 05:25</span>
														</div>
