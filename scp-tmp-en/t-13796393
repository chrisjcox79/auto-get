					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/francis-scalia" onclick="WIKIDOT.page.listeners.userInfo(209952); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=209952&amp;amp;size=small&amp;amp;timestamp=1606746199" alt="Francis Scalia" style="background-image:url(http://www.wikidot.com/userkarma.php?u=209952)"/></a><a href="http://www.wikidot.com/user:info/francis-scalia" onclick="WIKIDOT.page.listeners.userInfo(209952); return false;" >Francis Scalia</a></span> <span class="odate time_1602682663 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">14 Oct 2020 13:37</span>
