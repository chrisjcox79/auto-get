&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/quadraginta&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6391595&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606879515&quot; alt=&quot;Quadraginta&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6391595)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/quadraginta&quot;  &gt;Quadraginta&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
