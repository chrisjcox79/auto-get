&lt;hr /&gt;
&lt;div class=&quot;image-container aligncenter&quot;&gt;&lt;img src=&quot;http://smlt.wdfiles.com/local--files/jacrld%3Aartpage/quick.png&quot; alt=&quot;quick.png&quot; class=&quot;image&quot; /&gt;&lt;/div&gt;
