&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/bluejones&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4646198&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609837195&quot; alt=&quot;BlueJones&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4646198)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/bluejones&quot;  &gt;BlueJones&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
