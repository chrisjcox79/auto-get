&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/veralta&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6030962&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609491548&quot; alt=&quot;Veralta&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6030962)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/veralta&quot;  &gt;Veralta&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
