&lt;p&gt;&amp;#171; &lt;a class=&quot;newpage&quot; href=&quot;http://www.scpwiki.com/scp-5479&quot;&gt;SCP-5479&lt;/a&gt; | SCP-5480 | &lt;a href=&quot;http://www.scpwiki.com/scp-5481&quot;&gt;SCP-5481&lt;/a&gt; &amp;#187;&lt;/p&gt;
&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tiamat-elsen&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4142067&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608348538&quot; alt=&quot;Tiamat Elsen&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4142067)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/tiamat-elsen&quot;  &gt;Tiamat Elsen&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
