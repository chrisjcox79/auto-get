&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/margssentif&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=3861605&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609837196&quot; alt=&quot;margssentif&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=3861605)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/margssentif&quot;  &gt;margssentif&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
