					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/wolfrover" onclick="WIKIDOT.page.listeners.userInfo(1390913); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1390913&amp;amp;size=small&amp;amp;timestamp=1607418057" alt="Wolfrover" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1390913)"/></a><a href="http://www.wikidot.com/user:info/wolfrover" onclick="WIKIDOT.page.listeners.userInfo(1390913); return false;" >Wolfrover</a></span> <span class="odate time_1479285658 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">16 Nov 2016 08:40</span>
