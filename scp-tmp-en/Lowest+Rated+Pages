&lt;div style=&quot;text-align: right;&quot;&gt;&lt;/div&gt;

&lt;div class=&quot;anom-bar-container item-5359 clear-3 esoteric thaumiel ekhi caution {$american}&quot;&gt;
&lt;div class=&quot;anom-bar&quot;&gt;
&lt;div class=&quot;top-box&quot;&gt;
&lt;div class=&quot;top-left-box&quot;&gt;&lt;span class=&quot;item&quot;&gt;Item#:&lt;/span&gt; &lt;span class=&quot;number&quot;&gt;5359&lt;/span&gt;&lt;/div&gt;
&lt;div class=&quot;top-center-box&quot;&gt;
&lt;div class=&quot;bar-one&quot;&gt;&lt;/div&gt;
