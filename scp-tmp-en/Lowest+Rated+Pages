&lt;span style=&quot;white-space: pre-wrap;&quot;&gt;&amp;#32;&lt;/span&gt;&lt;br /&gt;
&lt;strong&gt;Author:&lt;/strong&gt; &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cyvstvi13&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6004508&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605818659&quot; alt=&quot;Cyvstvi13&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6004508)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/cyvstvi13&quot;  &gt;Cyvstvi13&lt;/a&gt;&lt;/span&gt;.&lt;br /&gt;
