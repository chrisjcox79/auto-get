&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/djgamer5863&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6987246&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606942288&quot; alt=&quot;DJGamer5863&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6987246)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/djgamer5863&quot;  &gt;DJGamer5863&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
