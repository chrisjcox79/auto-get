&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ksforshort&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6367089&amp;amp;amp;size=small&amp;amp;amp;timestamp=1609772998&quot; alt=&quot;KSforShort&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6367089)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/ksforshort&quot;  &gt;KSforShort&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
