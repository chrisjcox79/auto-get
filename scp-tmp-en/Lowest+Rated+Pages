&lt;div class=&quot;collapsible-block-content&quot;&gt;
&lt;p&gt;&lt;br /&gt;
&lt;br /&gt;
&lt;br /&gt;
&lt;strong&gt;&lt;span style=&quot;color: #4b0082&quot;&gt;STANDARD VISUAL MEMETIC BOOSTER ACTIVATED&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;a href=&quot;http://scp-wiki.wdfiles.com/local--files/scp-5168/meme&quot;&gt;&lt;img src=&quot;http://scp-wiki.wdfiles.com/local--resized-images/scp-5168/meme/medium.jpg&quot; height=&quot;125px&quot; width=&quot;1024px&quot; alt=&quot;meme&quot; class=&quot;image&quot; /&gt;&lt;/a&gt;
