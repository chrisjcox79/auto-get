&lt;td style=&quot;border-right: 1px solid #AAA; text-align: center; width: 25%;&quot;&gt;&lt;span style=&quot;font-size:80%;&quot;&gt;Dr. Jonathan Godrich&lt;/span&gt;&lt;br /&gt;
&lt;span style=&quot;font-size:60%;&quot;&gt;&lt;em&gt;Department of Psychology&lt;/em&gt;&lt;/span&gt;&lt;/td&gt;
