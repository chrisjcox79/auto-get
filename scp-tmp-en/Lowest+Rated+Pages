&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/paris-rosaline&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7122050&amp;amp;amp;size=small&amp;amp;amp;timestamp=1607979346&quot; alt=&quot;Paris Rosaline&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7122050)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/paris-rosaline&quot;  &gt;Paris Rosaline&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
