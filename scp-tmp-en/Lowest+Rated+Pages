&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/friskaunderscore&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7006299&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606078065&quot; alt=&quot;FriskaUnderscore&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7006299)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/friskaunderscore&quot;  &gt;FriskaUnderscore&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
</description>
