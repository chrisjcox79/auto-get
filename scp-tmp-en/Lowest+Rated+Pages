&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/apoplexic&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2767424&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605818660&quot; alt=&quot;Apoplexic&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2767424)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/apoplexic&quot;  &gt;Apoplexic&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
