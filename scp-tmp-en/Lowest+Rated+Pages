&lt;/div&gt;
&lt;/div&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mafia0087&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=6972039&amp;amp;amp;size=small&amp;amp;amp;timestamp=1606078064&quot; alt=&quot;Mafia0087&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=6972039)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/mafia0087&quot;  &gt;Mafia0087&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
