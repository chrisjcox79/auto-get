&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lastlife0907&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=7138150&amp;amp;amp;size=small&amp;amp;amp;timestamp=1608562661&quot; alt=&quot;LastLife0907&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=7138150)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/lastlife0907&quot;  &gt;LastLife0907&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
