&lt;li&gt;&lt;a href=&quot;http://scp-int.wikidot.com/dclass-search&quot;&gt;D-Class Personnel Simple Search System&lt;/a&gt; — by&lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/amamiel&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=2125181&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605818662&quot; alt=&quot;amamiel&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=2125181)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/amamiel&quot;  &gt;amamiel&lt;/a&gt;&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;by &lt;span class=&quot;printuser avatarhover&quot;&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/int-translator&quot;  &gt;&lt;img class=&quot;small&quot; src=&quot;http://www.wikidot.com/avatar.php?userid=4721888&amp;amp;amp;size=small&amp;amp;amp;timestamp=1605818662&quot; alt=&quot;INT_Translator&quot; style=&quot;background-image:url(http://www.wikidot.com/userkarma.php?u=4721888)&quot; /&gt;&lt;/a&gt;&lt;a href=&quot;http://www.wikidot.com/user:info/int-translator&quot;  &gt;INT_Translator&lt;/a&gt;&lt;/span&gt;&lt;/p&gt;
