				<div class="info">
					<span class="printuser deleted" data-id="1361261"><img class="small" src="http://www.wikidot.com/common--images/avatars/default/a16.png" alt=""/>(account deleted)</span> <span class="odate time_1420492532 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">05 Jan 2015 21:15</span>
														</div>
