					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/petrograd" onclick="WIKIDOT.page.listeners.userInfo(455145); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=455145&amp;amp;size=small&amp;amp;timestamp=1606142682" alt="Petrograd" style="background-image:url(http://www.wikidot.com/userkarma.php?u=455145)"/></a><a href="http://www.wikidot.com/user:info/petrograd" onclick="WIKIDOT.page.listeners.userInfo(455145); return false;" >Petrograd</a></span> <span class="odate time_1452421527 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">10 Jan 2016 10:25</span>
