				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/wilhelm-klink" onclick="WIKIDOT.page.listeners.userInfo(1807439); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=1807439&amp;amp;size=small&amp;amp;timestamp=1605818406" alt="Wilhelm Klink" style="background-image:url(http://www.wikidot.com/userkarma.php?u=1807439)"/></a><a href="http://www.wikidot.com/user:info/wilhelm-klink" onclick="WIKIDOT.page.listeners.userInfo(1807439); return false;" >Wilhelm Klink</a></span> <span class="odate time_1423538105 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">10 Feb 2015 03:15</span>
