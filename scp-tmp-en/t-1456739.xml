					<item>
				<guid>http://www.scpwiki.com/forum/t-1456739#post-2413411</guid>
				<title>Orignal Post</title>
				<link>http://www.scpwiki.com/forum/t-1456739/grant-request-for-utilization-of-electro-thaumic-computers-t#post-2413411</link>
				<description></description>
