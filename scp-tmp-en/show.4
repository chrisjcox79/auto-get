<div class="addendum">
<div style="text-align: center;">
<h1 id="toc8"><span>SITUATIONAL UPDATE</span></h1>
</div>



<div class="scp-image-block block-left" style="width:280px;"><img src="http://www.scp-wiki.net/local--files/scp-4661/helicopter.png" style="width:280px;" class="enlarge" alt="helicopter.png" />
