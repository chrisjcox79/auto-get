				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/t-rutherford" onclick="WIKIDOT.page.listeners.userInfo(4620432); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=4620432&amp;amp;size=small&amp;amp;timestamp=1606834547" alt="T Rutherford" style="background-image:url(http://www.wikidot.com/userkarma.php?u=4620432)"/></a><a href="http://www.wikidot.com/user:info/t-rutherford" onclick="WIKIDOT.page.listeners.userInfo(4620432); return false;" >T Rutherford</a></span> <span class="odate time_1559668080 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">04 Jun 2019 17:08</span>
														</div>
