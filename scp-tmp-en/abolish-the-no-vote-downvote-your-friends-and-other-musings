				<div class="info">
					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/irmoloros" onclick="WIKIDOT.page.listeners.userInfo(6358320); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6358320&amp;amp;size=small&amp;amp;timestamp=1609276501" alt="Irmoloros" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6358320)"/></a><a href="http://www.wikidot.com/user:info/irmoloros" onclick="WIKIDOT.page.listeners.userInfo(6358320); return false;" >Irmoloros</a></span> <span class="odate time_1587782652 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">25 Apr 2020 02:44</span>
