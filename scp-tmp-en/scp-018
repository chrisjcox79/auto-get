					<span class="printuser avatarhover"><a href="http://www.wikidot.com/user:info/cathier" onclick="WIKIDOT.page.listeners.userInfo(6832726); return false;"  ><img class="small" src="http://www.wikidot.com/avatar.php?userid=6832726&amp;amp;size=small&amp;amp;timestamp=1605991006" alt="Cathier" style="background-image:url(http://www.wikidot.com/userkarma.php?u=6832726)"/></a><a href="http://www.wikidot.com/user:info/cathier" onclick="WIKIDOT.page.listeners.userInfo(6832726); return false;" >Cathier</a></span> <span class="odate time_1599936872 format_%25e%20%25b%20%25Y%2C%20%25H%3A%25M%7Cagohover">12 Sep 2020 18:54</span>
														</div>
